\ ***************************************************************************
\ Collisions with Harry (&936B/&937D, &940A; docs/research/monsters.md 5).
\
\ The original asks its 1-bit screen whether Harry's 8-pixel window holds
\ any pixel that is neither Harry's nor the room's, then decides who by
\ character-cell boxes in record order. Here the BBC's screen is asked the
\ same: the sprites are drawn and erased exactly as the original draws and
\ erases them, in the same order, so the screen holds the same sprite
\ pixels, including the holes one sprite's erase leaves in another and an
\ object drawn again after it was taken. A pixel counts if its colour isn't
\ its cell's paper, less the tile's own pixels and Harry's. The blind spot
\ (decision 9): a sprite pixel in the colour of the paper under it, which
\ is mostly the original's own invisible case, black on black.
\
\ Harry's window is two columns as a 16-bit strip, left column high: 8
\ pixels from 2*xf (a 1-byte frame is the left column alone).
\ ***************************************************************************

ZA_AUTO1 cw_lo              ; the window mask
ZA_AUTO1 cw_hi
ZA_AUTO1 cs_lo              ; window AND NOT Harry, one line
ZA_AUTO1 cs_hi
ZA_AUTO2 cimg               ; Harry's frame rows
ZA_AUTO1 cline              ; the screen line being tested, 0-191
ZA_AUTO1 crow               ; Harry's row 0-15

.collide
{
    ZA_AUTO1 hw
    \ Harry's frame: width, and the window it gives.
    LDY #1 : LDA (h_frame),Y : STA hw
    CLC : LDA h_frame : ADC #2 : STA cimg
    LDA h_frame+1 : ADC #0 : STA cimg+1
    LDA #&FF : STA cw_hi : LDA #0 : STA cw_lo
    LDA hw : CMP #1 : BEQ window
    LDX h_xf : BEQ window
.shift
    LSR cw_hi : ROR cw_lo : LSR cw_hi : ROR cw_lo
    DEX : BNE shift
.window
    LDA #&FF : STA sbc_hi : STA sbc_hi+1        ; nothing looked up yet
    \ Harry's top line.
    LDA h_cell : LSR A : LSR A : LSR A : LSR A : LSR A : STA cline
    LDA h_cell+1 : ASL A : ASL A : ASL A : ORA cline
    ASL A : ASL A : ASL A : ORA h_yf : STA cline
    LDA #0 : STA crow
.line
    \ The window less Harry's own pixels.
    LDA crow : LDX hw : CPX #1 : BEQ one_byte
    ASL A : TAY
    LDA (cimg),Y : EOR #&FF : AND cw_hi : STA cs_hi
    INY : LDA (cimg),Y : EOR #&FF : AND cw_lo : STA cs_lo
    JMP test_screen
.one_byte
    TAY : LDA (cimg),Y : EOR #&FF : AND cw_hi : STA cs_hi
    LDA #0 : STA cs_lo
.test_screen
    LDA h_cell : AND #31 : STA ccol
    LDX #0 : JSR screen_bits : AND cs_hi : BNE hit
    LDA cs_lo : BEQ next_line
    INC ccol
    LDX #1 : JSR screen_bits : AND cs_lo : BNE hit
.next_line
    INC cline
    INC crow : LDA crow : CMP #16 : BNE line
    RTS
.hit
    JMP who_was_hit
}

\ On screen line cline, column ccol: the pixels that aren't the cell's
\ paper, less the tile's own pixels; 1 bit a pixel, leftmost in bit 7.
\ X is Harry's column, 0 or 1: each keeps the last cell it looked up, as
\ one cell serves eight lines.
.screen_bits
{
    ZA_AUTO2 sp
    ZA_AUTO1 tb
    ZA_AUTO1 left
    STX sb_slot
    \ cell = (line / 8) * 32 + column
    LDA cline : LSR A : LSR A : LSR A : STA cell
    LDA #0 : STA cell+1
    ASL cell : ROL cell+1 : ASL cell : ROL cell+1 : ASL cell : ROL cell+1
    ASL cell : ROL cell+1 : ASL cell : ROL cell+1
    LDA ccol : ORA cell : STA cell
    LDA cell : CMP sbc_lo,X : BNE look
    LDA cell+1 : CMP sbc_hi,X : BNE look
    LDA sbc_glo,X : STA glyph
    LDA sbc_ghi,X : STA glyph+1
    LDA sbc_paper,X : STA paper
    JMP looked
.look
    JSR cell_looks                  ; glyph, paper
    LDX sb_slot
    LDA cell : STA sbc_lo,X
    LDA cell+1 : STA sbc_hi,X
    LDA glyph : STA sbc_glo,X
    LDA glyph+1 : STA sbc_ghi,X
    LDA paper : STA sbc_paper,X
.looked
    LDA cline : AND #7 : TAY
    LDA (glyph),Y : STA tb
    \ The screen bytes: screen + 16 * cell + line, and 8 on.
    LDA cell : ASL A : ASL A : ASL A : ASL A : STA sp
    LDA cell+1 : STA sp+1
    LDA cell
    LSR sp+1 : ROR A : LSR sp+1 : ROR A : LSR sp+1 : ROR A : LSR sp+1 : ROR A
    CLC : ADC #HI(screen) : STA sp+1
    \ A pixel isn't paper if either of its bits differs: fold the two
    \ nibbles of (byte EOR paper) together.
    LDA (sp),Y : EOR paper : TAX
    LSR A : LSR A : LSR A : LSR A : STA left
    TXA : ORA left : AND #15
    ASL A : ASL A : ASL A : ASL A : STA left
    TYA : ORA #8 : TAY
    LDA (sp),Y : EOR paper : TAX
    LSR A : LSR A : LSR A : LSR A : STA sp
    TXA : ORA sp : AND #15 : ORA left
    \ Less the tile's own pixels.
    STA left
    LDA tb : EOR #&FF : AND left
    RTS
}

\ Who was hit (&940A): character-cell boxes, the first monster in record
\ order that overlaps Harry decides. Then the train's rule.
.who_was_hit
{
    ZA_AUTO1 hl                     ; Harry's box
    ZA_AUTO1 hr
    ZA_AUTO1 ht
    ZA_AUTO1 hb
    LDA h_cell : AND #31 : STA hl
    LDY #1 : LDA (h_frame),Y : CLC : ADC hl : SEC : SBC #1 : STA hr
    LDA h_cell : LSR A : LSR A : LSR A : LSR A : LSR A : STA ht
    LDA h_cell+1 : ASL A : ASL A : ASL A : ORA ht : STA ht
    LDY #0 : LDA (h_frame),Y : CLC : ADC ht : SEC : SBC #1 : STA hb
    \ The current thing first.
    LDA o_sel : BEQ monsters
    LDA o_cell : AND #31 : STA box_l
    LDA o_frame : STA cimg
    LDA o_frame+1 : STA cimg+1
    LDY #1 : LDA (cimg),Y : CLC : ADC box_l : SEC : SBC #1 : STA box_r
    LDA o_cell : LSR A : LSR A : LSR A : LSR A : LSR A : STA box_t
    LDA o_cell+1 : ASL A : ASL A : ASL A : ORA box_t : STA box_t
    LDY #0 : LDA (cimg),Y : CLC : ADC box_t : SEC : SBC #1 : STA box_b
    JSR overlap : BCS monsters
    JMP touch_thing
.monsters
    LDX #0
.monster
    CPX m_count : BEQ no_monster
    STX c_m
    \ Its box against Harry's: overlap unless clear on some side.
    LDA m_cell_lo,X : AND #31 : STA box_l
    LDA m_frame_lo,X : STA cimg
    LDA m_frame_hi,X : STA cimg+1
    LDY #1 : LDA (cimg),Y : CLC : ADC box_l : SEC : SBC #1 : STA box_r
    LDA m_cell_lo,X : LSR A : LSR A : LSR A : LSR A : LSR A : STA box_t
    LDA m_cell_hi,X : ASL A : ASL A : ASL A : ORA box_t : STA box_t
    LDY #0 : LDA (cimg),Y : CLC : ADC box_t : SEC : SBC #1 : STA box_b
    JSR overlap : BCS next
    JMP contact
.next
    LDX c_m : INX : JMP monster
.no_monster
    \ Rooms 71-80: the train kills in rows 0-7.
    LDA room : CMP #71 : BCC dispatch
    CMP #81 : BCS dispatch
    LDA h_cell+1 : BNE dispatch     ; rows 0-7 are cells 0-255
    JMP harry_died
.dispatch
    \ Room 111: the egg carried into the truck (&9453).
    LDA room : CMP #111 : BNE done
    LDA h_cell : AND #31 : CMP #7 : BCS done
    LDA carried : CMP #&28 : BNE done
    JMP egg_delivered
.done
    RTS
\ Carry clear if box_* overlaps Harry's box (inclusive).
.overlap
    LDA box_r : CMP hl : BCC clear  ; its right < Harry's left
    LDA hr : CMP box_l : BCC clear  ; Harry's right < its left
    LDA box_b : CMP ht : BCC clear
    LDA hb : CMP box_t : BCC clear
    CLC
    RTS
.clear
    SEC
    RTS
}

\ Contact with monster c_m (&94E5).
.contact
{
    LDX c_m
    LDA m_flags,X : AND #MF_KILL : BEQ not_kill
    JMP harry_died
.not_kill
    LDA m_flags,X : AND #MF_BOUNCE : BEQ harmless
    \ Knocked back: a jump at count 2, momentum and facing at random.
    LDA #7 : STA h_state
    LDA #2 : STA h_cnt
.again
    JSR rng : AND #3 : CMP #3 : BEQ again
    SEC : SBC #1 : STA h_mom
    JSR rng : AND #4 : STA h_face
.harmless
    RTS
}
