\ ***************************************************************************
\ Collisions with Harry (&936B/&937D, &940A; docs/research/monsters.md 5).
\
\ The original asks its 1-bit screen whether Harry's 8-pixel window holds
\ any pixel that is neither Harry's nor the room's, then decides who by
\ character-cell boxes in record order. Here the BBC's screen is asked the
\ same: the sprites are drawn and erased exactly as the original draws and
\ erases them, in the same order, so the screen holds the same sprite
\ pixels, including the holes one sprite's erase leaves in another and an
\ object drawn again after it was taken. A pixel counts if its colour isn't
\ its cell's paper, less the tile's own pixels and Harry's. The blind spot
\ (decision 9): a sprite pixel in the colour of the paper under it, which
\ is mostly the original's own invisible case, black on black.
\
\ Harry's window is two columns as a 16-bit strip, left column high: 8
\ pixels from 2*xf (a 1-byte frame is the left column alone).
\ ***************************************************************************

ZA_AUTO1 c_col1             ; the right column's column: Harry's + 1
ZA_AUTO1 c_yl               ; the line in the cell, through the look-ups
ZA_AUTO1 c_paper1           ; the right column's paper
ZA_AUTO1 c_lines            ; Harry's lines left
ZA_AUTO1 cw_lo              ; the window mask
ZA_AUTO1 cw_hi
ZA_AUTO2 cimg               ; who_was_hit's frames
ZA_AUTO 4, hbox             ; Harry's box, as box_l-box_b (who_was_hit's)

\ Down Harry's 16 lines a cell row at a time, as the sprites are drawn
\ (sprite.6502): Y is the line in the cell, which indexes the tile's lines,
\ the screen bytes from the cell's top, and Harry's frame (a column at a
\ time, decision 20) through hp and hp1; so each column looks its cell up
\ once for the eight lines it serves. A pixel that isn't paper shows in
\ (screen byte EOR paper), either of its two bits. A hit anywhere goes to
\ who_was_hit, which doesn't ask where.
.collide
{
    ZA_AUTO2 hp                 ; Harry's left column, for Y = 0
    ZA_AUTO2 hp1                ; ... and right
    ZA_AUTO2 s0                 ; the left column's screen: the cell's top, left
    ZA_AUTO2 s08                ; ... and right four pixels
    ZA_AUTO2 s1                 ; the right column's
    ZA_AUTO2 s18
    ZA_AUTO2 g1                 ; ... and its glyph (the left's is `glyph`)
    \ Harry's frame: the window its width gives.
    LDX #&FF : STX cw_hi : INX : STX cw_lo
    LDY #1 : LDA (h_frame),Y : CMP #1 : BEQ window
    LDX h_xf : BEQ window
.shift
    LSR cw_hi : ROR cw_lo : LSR cw_hi : ROR cw_lo
    DEX : BNE shift
.window
    \ (The right column's pointers and paper are only read when they're
    \ set, but the allocator can't see that: they hold nothing between
    \ calls.)
    ZA_DISCARD g1, s1, s18, c_paper1
    LDA #16 : STA c_lines
    \ `cell` is the left column's cell in this cell row (cell_looks and
    \ cell_screen keep it). The right column's is row * 32 OR column + 1,
    \ as the line's cell has always been found.
    LDA h_cell : STA cell
    AND #31 : TAX : INX : STX c_col1
    LDA h_cell+1 : STA cell+1
    \ His columns, each 16 lines, less his first line's Y.
    LDX h_frame+1
    LDA h_frame : CLC : ADC #2
    BCC no_carry
    INX
.no_carry
    SEC : SBC h_yf
    BCS no_borrow
    DEX
.no_borrow
    LDY h_yf
.set_hp
    \ hp = X:A, and hp1 16 on.
    STA hp : STX hp+1
    CLC : ADC #16 : STA hp1
    BCC hp1_ok
    INX
.hp1_ok
    STX hp1+1
.each_row
    STY c_yl
    \ The right column only if the window reaches it (cw_lo is 0 for a
    \ 1-byte frame).
    LDA cw_lo : BEQ left
    LDA cell : PHA
    AND #&E0 : ORA c_col1 : STA cell        ; (cell+1 as it is)
    JSR looks
    STA s1 : STY s1+1 : STY s18+1
    ORA #8 : STA s18
    LDA glyph : STA g1
    LDA glyph+1 : STA g1+1
    LDA paper : STA c_paper1
    PLA : STA cell
.left
    JSR looks
    STA s0 : STY s0+1 : STY s08+1
    ORA #8 : STA s08
    LDY c_yl
.line
    \ The window less Harry's and the tile's own pixels, against the screen.
    \ (The mask waits on the stack for its right four pixels: hit_pla.)
    LDA (hp),Y : ORA (glyph),Y : EOR #&FF : AND cw_hi : BEQ right
    PHA
    LSR A : LSR A : LSR A : LSR A : TAX
    LDA (s0),Y : EOR paper : AND spread_lo,X : BNE hit_pla
    PLA : AND #15 : TAX
    LDA (s08),Y : EOR paper : AND spread_lo,X : BNE hit
.right
    LDA cw_lo : BEQ next
    LDA (hp1),Y : ORA (g1),Y : EOR #&FF : AND cw_lo : BEQ next
    PHA
    LSR A : LSR A : LSR A : LSR A : TAX
    LDA (s1),Y : EOR c_paper1 : AND spread_lo,X : BNE hit_pla
    PLA : AND #15 : TAX
    LDA (s18),Y : EOR c_paper1 : AND spread_lo,X : BNE hit
.next
    INY
    DEC c_lines : BEQ done
    CPY #8 : BNE line
    \ The cell row below, from its top: Y goes back 8, so hp and hp1 on 8.
    JSR cell_down
    LDY #0
    LDA hp : LDX hp+1 : ADC #8              ; (C clear: cell_down)
    BCC to_set_hp
    INX
.to_set_hp
    JMP set_hp
\ `cell`'s glyph and paper, and its screen address (A low, Y high).
.looks
    JSR cell_looks
    LDA cell : LDX cell+1 : JMP cell_screen
.done
    RTS
.hit_pla
    PLA
.hit
    \ Fall into who_was_hit.
}

\ Who was hit (&940A): character-cell boxes, the first monster in record
\ order that overlaps Harry decides. Then the train's rule.
.who_was_hit
{
    LDA h_frame : STA cimg
    LDA h_frame+1 : STA cimg+1
    \ (frame_box goes on to compare with hbox, not yet set: its answer is
    \ ignored, and the loop rebuilds hbox.)
    ZA_DISCARD hbox
    LDA h_cell : LDX h_cell+1 : JSR frame_box
    ZA_DISCARD hbox
    LDX #3
.harry
    LDA box_l,X : STA hbox,X
    ZA_INDEXEDBY 0..3
    DEX : BPL harry
    \ The current thing first.
    LDA o_sel : BEQ monsters
    LDA o_frame : STA cimg
    LDA o_frame+1 : STA cimg+1
    LDA o_cell : LDX o_cell+1 : JSR frame_box : BCS monsters
    JMP touch_thing
.monsters
    LDY #0
.monster
    CPY m_count : BEQ no_monster
    STY c_m
    LDA m_frame_lo,Y : STA cimg
    LDA m_frame_hi,Y : STA cimg+1
    LDA m_cell_lo,Y : LDX m_cell_hi,Y : JSR frame_box : BCC contact
    LDY c_m : INY : BNE monster             ; (always)
.no_monster
    \ Rooms 71-80: the train kills in rows 0-7.
    LDA room : CMP #71 : BCC dispatch
    CMP #81 : BCS dispatch
    LDA h_cell+1 : BEQ contact.died ; rows 0-7 are cells 0-255
    \ (Then A = 1 or 2: not room 111.)
.dispatch
    \ Room 111: the egg carried into the truck (&9453). (A = room.)
    CMP #111 : BNE overlap.done
    LDA h_cell : AND #31 : CMP #7 : BCS overlap.done
    LDA carried : CMP #&28 : BNE overlap.done
    JMP egg_delivered
}

\ The character-cell box of the frame at cimg in cell A + 256 * X: box_l
\ and box_t its first column and row, box_r and box_b one past its last.
.frame_box
    PHA : AND #31 : STA box_l
    PLA : JSR cell_row : STA box_t
    LDY #1 : LDA (cimg),Y : AND #15 : CLC : ADC box_l : STA box_r     ; (the header's other
    DEY : LDA (cimg),Y : AND #7 : ADC box_t : STA box_b               ; bits: sprite.6502; C clear)
    \ Fall into overlap.
\ Carry clear if box_* overlaps Harry's box: unless one ends at or before
\ where the other starts, across or down.
.overlap
{
    LDA hbox : CMP box_r : BCS done
    LDA box_l : CMP hbox+1 : BCS done
    LDA hbox+2 : CMP box_b : BCS done
    LDA box_t : CMP hbox+3
.done
    RTS
}

\ Contact with monster c_m (&94E5).
.contact
{
    LDX c_m
    LDA m_flags,X : LSR A : LSR A : BCC not_kill  ; MF_KILL
.died
    JMP harry_died
.not_kill
    LSR A : BCC harmless                          ; MF_BOUNCE
    ASSERT MF_KILL = 2 AND MF_BOUNCE = 4
    \ Knocked back: a jump at count 2, momentum and facing at random.
    LDA #7 : STA h_state
    LDA #2 : STA h_cnt
.again
    JSR rng : AND #3 : CMP #3 : BEQ again
    SBC #0 : STA h_mom              ; (C clear: 0-2, so - 1)
    JSR rng : AND #4 : STA h_face
.harmless
    RTS
}
