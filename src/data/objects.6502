\ The object graphics (&8A98, renumbered: tools/mkobjects.py): a type's
\ graphic indexes these. Each one's header's offset in objgfx, which go
\ up with the graphics' numbers; their low bytes; and how many start
\ below each of the next five pages (objects.6502's thing_load counts
\ the ones at or below a graphic for its high byte).
OBJ_OFFS = {
    &0000, &0004, &000C, &0016, &001F, &0026, &0030, &003A,
    &0044, &004E, &0055, &005E, &0066, &0070, &0078, &007F,
    &0086, &008A, &0094, &009E, &00A7, &00AE, &00B4, &00BC,
    &00C6, &00D0, &00D6, &00DF, &00E9, &00F3, &00FD, &0107,
    &0110, &0152, &0194, &01D6, &0218, &022A, &0239, &0246,
    &0254, &027E, &02A8, &030A, &0314, &031E, &0322, &033C,
    &039E, &03AA, &03B4, &03C6, &03D8, &03E2, &03F4, &0406,
    &0418, &042A, &0437, &0449, &0457, &045F, &0471, &047B
}
.object_lo
    EQUB LO(objgfx + OBJ_OFFS)
OBJ_PAGES = {SUM(objgfx + OBJ_OFFS < (HI(objgfx) + 1) * 256), SUM(objgfx + OBJ_OFFS < (HI(objgfx) + 2) * 256), SUM(objgfx + OBJ_OFFS < (HI(objgfx) + 3) * 256), SUM(objgfx + OBJ_OFFS < (HI(objgfx) + 4) * 256), SUM(objgfx + OBJ_OFFS < (HI(objgfx) + 5) * 256)}
    ASSERT HI(objgfx + OBJ_OFFS[LEN(OBJ_OFFS) - 1]) <= HI(objgfx) + 5

