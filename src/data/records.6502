\ Generated by tools/mkrecords.py: do not edit.

\ Harry's frames (&89FF), by facing + xf: 0-3 right, 4-7 left (shifted
\ 0/2/4/6 pixels, also the walk cycle), 8-11 climbing. Each points at
\ the frame's header (height in cells, width in bytes).
.harry_frames
    EQUW harry_gfx + &0000
    EQUW harry_gfx + &0012
    EQUW harry_gfx + &0034
    EQUW harry_gfx + &0056
    EQUW harry_gfx + &0078
    EQUW harry_gfx + &008A
    EQUW harry_gfx + &00AC
    EQUW harry_gfx + &00CE
    EQUW harry_gfx + &00F0
    EQUW harry_gfx + &0102
    EQUW harry_gfx + &00F0
    EQUW harry_gfx + &0114

