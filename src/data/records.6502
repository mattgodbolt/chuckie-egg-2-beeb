\ The most a room needs, its record (the streaming edition's cache).
ROOM_MAX = 1032
NPORT = &29       \ things 0 to NPORT - 1 are portable
FIXED_MAX = 9
GROUPS_MAX = 4
LEN4_BIAS = 3
FRAMES_MAX = 24
