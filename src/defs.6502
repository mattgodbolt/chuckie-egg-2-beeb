\ ***************************************************************************
\ CHUCKIE EGG 2 for the BBC Micro - shared constants
\ ***************************************************************************

\ --- OS entry points -----------------------------------------------------

osfile  = &FFDD
osrdch  = &FFE0
osasci  = &FFE3
oswrch  = &FFEE
osword  = &FFF1
osbyte  = &FFF4
oscli   = &FFF7

\ --- Hardware ------------------------------------------------------------

crtc_reg   = &FE00
crtc_data  = &FE01
ula_ctrl   = &FE20          ; the video ULA's control register
ula_pal    = &FE21          ; write (index << 4) | (physical EOR 7)
CRTC_BLANK = &30            ; R8: display enable skewed off, so nothing shows
sysvia_orb = &FE40          ; the addressable latch: bit 3 is keyboard enable
sysvia_ddra = &FE43
sysvia_ora_nh = &FE4F       ; port A without handshake: the keyboard
sysvia_ifr = &FE4D
sysvia_ier = &FE4E          ; write bit 7 clear to disable the bits set
usrvia_t1cl = &FE64         ; reading it acknowledges T1
usrvia_t1ch = &FE65         ; writing it starts the count
usrvia_t1ll = &FE66         ; T1's latch: the next period, free-running
usrvia_t1lh = &FE67
usrvia_t2cl = &FE68         ; timer 2: reading the low byte acknowledges
usrvia_t2ch = &FE69         ; writing the high byte starts it
usrvia_acr = &FE6B
usrvia_ifr = &FE6D
usrvia_ier = &FE6E
SL         = 64             ; a scanline: 64 us, 64 ticks of a VIA timer
brkv       = &0202
irq1v      = &0204
romsel     = &FE30          ; the sideways bank at &8000
romshad    = &F4            ; the OS's copy of romsel: always write both
romtypes   = &02A1          ; the OS's ROM type per bank; 0 = no ROM found
\ The text font (decision 4): OS 1.20's own, characters 32-127, in its ROM
\ at &C000, which is never paged out (decision 14: a Model B).
text_font  = &C000

\ --- The screen -----------------------------------------------------------
\ MODE 1's pixels (2 bits each, four to a byte), with the CRTC narrowed to
\ the Spectrum's 256x192: 64 CRTC columns (32 Spectrum cells of 8 pixels,
\ two bytes each) by 24 character rows. A character row is 64*8 = 512
\ bytes, so the whole screen is 12K at &5000-&7FFF and row r starts at
\ screen + r*&200: the high byte of a row's address is just 2r more.
SCREEN_COLS = 32                    ; Spectrum character cells across
SCREEN_ROWS = 24                    ; ... and down
ROW_BYTES   = SCREEN_COLS * 16      ; 512
screen      = &8000 - SCREEN_ROWS * ROW_BYTES

\ A byte with all four pixels in logical colour c: MODE 1 keeps a pixel's
\ high bit in the top nibble and its low bit in the bottom one.
FUNCTION cbyte(c) = (c AND 2) * &78 + (c AND 1) * &0F

\ Long branches, for when a routine outgrows the 6502's reach.
MACRO JNE target
    BEQ @+ : JMP target : .@
ENDMACRO
MACRO JEQ target
    BNE @+ : JMP target : .@
ENDMACRO
