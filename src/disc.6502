\ ***************************************************************************
\ The streaming edition's disc (docs/streaming.md): with no sideways RAM,
\ the rooms' records (main.6502) are read from CE2ROOM on the disc, by the game's
\ own reader for the Model B's 8271 and the Master's WD1770. It reads a
\ sector at a time through the NMI routine at NMI_AREA, which the machine
\ enters for every byte, while the rest of the game runs on (the prototype
\ and its measurements: tools/stockb/nmi).
\
\ MENU, with the OS alive, says which controller (OSBYTE 0: a B or a
\ Master) and the track CE2ROOM starts (its catalogue entry), in
\ the mailbox: mb_fdc and mb_disc. The game makes no OS call for any of it.
\ ***************************************************************************

FDC_8271 = 0
FDC_1770 = 1
STA_ABS  = &8D
BIT_ABS  = &2C

\ 8271 (Model B)
I_STATUS = &FE80 : I_COMMAND = &FE80 : I_RESULT = &FE81 : I_PARAM = &FE81
I_RESET  = &FE82 : I_DATA = &FE84
\ WD1770 (Master)
W_CONTROL = &FE24 : W_STATUS = &FE28 : W_COMMAND = &FE28
W_TRACK  = &FE29 : W_SECTOR = &FE2A : W_DATA = &FE2B
W_LATCH  = &25              ; drive 0, not reset, side 0, single density
W_RATE   = 0                ; 6ms steps (r1 r0)

\ The reader for the machine's controller, which stream_init (startup.6502)
\ copies here from its two: fdc_read starts reading fe_pos's sector (ARM
\ says where to) and returns at once; fdc_poll, only while fdc_state isn't
\ 0, says when it's done (carry set while it's reading; then carry clear,
\ and Z set, or A the controller's error bits). fdc_read is the slot's
\ first byte, and fdc_poll where the 8271's reader puts it (the 1770's
\ pads up to it), so neither needs a JMP.
FDC_SLOT = 137
.fdc_slot   SKIP FDC_SLOT
fdc_read = fdc_slot
fdc_poll = i_poll           ; (startup.6502's Fdc8271)
sector_start = fdc_read     ; (tools/cachetrace.mjs, roomwait.mjs: a sector)

\ (ARM, which each reader's read starts with: startup.6502.)

\ --- The loader: one item at a time, a sector at a time -------------------

\ disc_tick moves it on, from wait_vsync's wait (in the background) or
\ disc_wait (waiting): an item is being read while fdc_state isn't 0 (item_add
\ starts it), fe_pos (its sector and track on the disc), fe_len and fe_dst what's
\ left of it. A room's record starts a sector, so its sectors are read
\ straight into place, one after another, with nothing to do between.

\ Move the loader on as far as it can without waiting: Z clear (BNE)
\ while it's still reading an item, which is while fdc_state isn't 0.
.disc_step
{
    LDA fdc_state : BEQ done    ; (idle)
    JSR fdc_poll : BCS busy
    BNE next                    ; an error: read the sector again
    \ The sector is in: the next, unless that was the last.
    DEC fe_len+1 : BMI busy     ; (the item's all here: fdc_state 0)
    INC fe_dst+1
    INC fe_pos                  ; (a record never crosses a track)
    LDA fe_len : ORA fe_len+1 : BEQ done
.next
    JSR fdc_read
.busy
    LDA fdc_state               ; (the poll's or the read's: 0 once done)
.done
    RTS
}

\ --- The cache ------------------------------------------------------------

\ The arena (main.6502) holds rooms' records (tools/mkrecords.py's
\ roomrecs.bin, CE2ROOM on the disc: a room's body and its graphics groups
\ together, so a room is one read), in address order from its start, each
\ an item, its id the room - 1. item_top is where the next goes.

\ X = the item with id A, N clear (BPL); N set (BMI) if there isn't one.
.item_find
{
    LDX it_n
.loop
    DEX : BMI done              ; (N set: X = &FF)
    CMP it_id,X : BNE loop      ; (N clear: equal)
.done
    RTS
}

\ Wait for the loader to finish its item.
.disc_wait
    JSR disc_step : BNE disc_wait
.disc_rts
    RTS

\ From wait_vsync's wait: the loader on, or if it's idle, reading ahead.
\ (The viewer, which only draws rooms, doesn't read ahead.)
IF DEFINED(VIEWER)
disc_tick = disc_step
ELSE
\ --- Reading ahead ----------------------------------------------------------

.disc_tick
    JSR disc_step : BNE disc_rts
    \ Fall into prefetch.

\ With nothing being read: the room Harry is likeliest to go to next, then
\ the room's other neighbours, the first not here read if there's room.
\ What it finds or reads becomes this visit's, so reading ahead for another
\ room won't drop it, and Harry turning about doesn't read two rooms over
\ and over.
\ The likeliest is the room through the exit Harry is nearest, or heading
\ for. The body's first byte says which of the room's edges can be crossed.
\ The distance to each, in cells, is shortened by 8 for the side he faces,
\ and halved for up when he's climbing and down when he's falling.
.prefetch
{
    ZA_AUTO1 best               ; its item id (the room - 1), &FF if none
    ZA_AUTO1 dist
    ZA_AUTO1 exits
    ZA_AUTO1 row
    ZA_AUTO1 col
    LDA pf_cur : BMI disc_rts   ; (&FF: before the first room)
    LDA h_cell : AND #31 : STA col
    LDA h_cell+1 : STA row
    LDA h_cell
    ASL A : ROL row : ASL A : ROL row : ASL A : ROL row
    LDY #0 : LDA (rb),Y : STA exits
    STY nr_n
    LDA #&FF : STA dist : STA best
    LSR exits : BCC no_left
    LDA col : LDX h_face : CPX #4 : JSR facing
    LDX pf_cur : DEX
    CPX #71 - 1 - 1 : BNE left  ; (room 71's left is room 80)
    LDX #80 - 1
.left
    JSR consider
.no_left
    LSR exits : BCC no_right
    LDA #30 : SEC : SBC col : LDX h_face : JSR facing
    LDX pf_cur : INX
    CPX #80 + 1 - 1 : BNE right ; (room 80's right is room 71)
    LDX #71 - 1
.right
    JSR consider
.no_right
    LSR exits : BCC no_up
    LDA pf_cur : SBC #10 : TAX  ; (carry set; and clear only for no room)
    LDA row : SBC #2
    LDY h_face : CPY #8 : BNE up
    LSR A
.up
    JSR consider
.no_up
    LSR exits : BCC no_down
    LDA pf_cur : ADC #10 - 1 : TAX  ; (carry set)
    LDA #21 : SEC : SBC row
    LDY h_state : BNE down
    LSR A
.down
    JSR consider
.no_down
    LDA best
    LDY nr_n
.try
    CMP #120 : BCS next         ; (none)
    JSR item_find : BMI item_add ; (which keeps A)
    LDA epoch : STA it_use,X
.next
    DEY : BMI done
    LDA nr_rooms,Y
    BPL try                     ; (always)
    ZA_UNREACHABLE
.done
    RTS
\ A less 8 (not below 0) if Z is set: he faces that way.
.facing
    BNE faced
    SEC : SBC #8 : BCS faced
    LDA #0
.faced
    RTS
\ Room id X, A away: the best if it's a room and nearer. (Each room in
\ nr_rooms too.)
.consider
    CPX #120 : BCS not          ; (rooms 1-120: ids 0-119)
    PHA : TXA
    LDY nr_n : INC nr_n
    STA nr_rooms,Y
    PLA
    CMP dist : BCS not
    STA dist : STX best
.not
    RTS
}
ENDIF

\ Start reading item A at item_top if it fits, or fits once the items at
\ the top go (the oldest, after arrange), but never one this visit to the
\ room uses (it_use = epoch); if not, nothing gone. (Neither caller asks
\ which.)
.item_add
{
    ZA_AUTO1 id
    STA id
    \ Room id + 1's record's place on the disc (fe_pos: sector, then track,
    \ from CE2ROOM's, mb_disc) and length (fe_len). Each record takes
    \ (room_len4 + LEN4_BIAS - 1) / 64 + 1 sectors from the one after the last room's, or from
    \ the next track's first if it wouldn't fit in this one
    \ (tools/mkrecords.py).
    LDY #0 : STY fe_pos
    LDA mb_disc : STA fe_pos+1
.each
    LDA room_len4,Y : CLC : ADC #LEN4_BIAS - 1  ; (a ninth bit in the carry)
    ROL A : ROL A : ROL A : AND #7
    TAX                         ; its sectors, less 1
    SEC : ADC fe_pos            ; where the next would start
    CMP #11 : BCC fits
    INC fe_pos+1                ; from the next track's first
    LDA #0 : STA fe_pos
    TXA : ADC #0                ; (carry set)
.fits
    CPY id : BEQ found
    STA fe_pos
    INY : BNE each              ; (always)
    ZA_UNREACHABLE
.found
    JSR item_len                ; (Y = id)
    \ Nothing changes until it fits: X is where in the table it would go,
    \ fe_dst where it would start, each moving down past the item below
    \ (dropping it) while it doesn't. If it never fits, nothing is dropped.
    LDX it_n
    LDA item_top : STA fe_dst
    LDA item_top+1 : STA fe_dst+1
.try
    CPX #NI : BCS full
    \ It fits if it ends by the arena's end (Y and A: where it ends).
    CLC : LDA fe_dst : ADC fe_len : TAY
    LDA fe_dst+1 : ADC fe_len+1
    CMP #HI(arena_end + 1) : BCC in_arena
    BNE full
    CPY #LO(arena_end + 1) : BCS full
.in_arena
    STY item_top : STA item_top+1
    LDA id : STA it_id,X
    LDA epoch : STA it_use,X
    LDA fe_dst : STA it_lo,X
    LDA fe_dst+1 : STA it_hi,X
    INX : STX it_n              ; (and those above it gone)
    JMP fdc_read
.full
    DEX : BMI item_len.done     ; (an RTS)
    LDA it_use,X : CMP epoch : BEQ item_len.done
    LDA it_lo,X : STA fe_dst
    LDA it_hi,X : STA fe_dst+1
    BNE try                     ; (always)
    ZA_UNREACHABLE
}

\ fe_len = item Y's length: room Y + 1's record, room_len4 + LEN4_BIAS
\ fours. Keeps Y; returns carry clear (fe_len+1's top bit, rolled out).
.item_len
{
    LDA #0 : STA fe_len+1
    LDA room_len4,Y
    CLC : ADC #LEN4_BIAS : ROL fe_len+1
    ASL A : ROL fe_len+1
    ASL A : ROL fe_len+1
    STA fe_len
.done
    RTS
}

\ Put the items in the order they were last used, the latest first (this
\ visit's, then the last's ...), so the oldest are at the top, where
\ item_add drops them, and the room being entered is at the bottom, where
\ nothing reading ahead moves it. The bytes go through the screen, the
\ display blanked (the room's drawing clears it), and come back packed.
\ (ARR_BUF's low byte is arena's, so one store sets both.)
ARR_BUF = screen + LO(arena)
.arrange
{
    ZA_AUTO1 j
    ZA_AUTO1 best
    ZA_AUTO1 latest
    LDA #8 : STA crtc_reg : LDA #CRTC_BLANK : STA crtc_data
    LDA #LO(arena) : STA item_top
    LDA #HI(arena) : STA item_top+1
    \ For each place, the item after it used latest (it_use - epoch - 1 the
    \ largest, 255 this visit's) swapped in, and its bytes into the buffer,
    \ at item_top's place in it.
    LDX #0
.sort
    CPX it_n : BCS sorted
    STX j : STX best
    LDA it_use,X : SBC epoch : STA latest       ; (carry clear: the CPX)
.scan
    INX : CPX it_n : BCS scanned
    LDA it_use,X : SBC epoch                    ; (carry clear: the CPX)
    CMP latest : BEQ scan : BCC scan
    STA latest : STX best
    BCS scan                    ; (always)
    ZA_UNREACHABLE
.scanned
    \ Items j and best swap places in the table (it_id to it_use, NI apart).
    LDX j : LDY best
    CLC                         ; (and after: no add carries)
.field
    LDA it_id,X : PHA
    LDA it_id,Y : STA it_id,X
    PLA : STA it_id,Y
    TXA : ADC #NI : TAX
    TYA : ADC #NI : TAY
    CPX #4 * NI : BCC field
    LDX j
    LDA it_lo,X : STA fe_pos
    LDA it_hi,X : STA fe_pos+1
    ASSERT LO(ARR_BUF - arena) = 0
    LDA item_top : STA it_lo,X : STA fe_dst
    LDA item_top+1 : STA it_hi,X
    ADC #HI(ARR_BUF - arena) - 1 : STA fe_dst+1 ; (carry set: the CPX)
    LDY it_id,X : JSR item_len
    LDA fe_len : ADC item_top : STA item_top    ; (carry clear: item_len)
    LDA fe_len+1 : ADC item_top+1 : STA item_top+1
    JSR mem_copy
    INX : BNE sort              ; (always: X < NI)
    ZA_UNREACHABLE
.sorted
    LDA #LO(arena) : STA fe_pos : STA fe_dst
    LDA #HI(ARR_BUF) : STA fe_pos+1
    LDA #HI(arena) : STA fe_dst+1
    LDA item_top : SBC #LO(arena) : STA fe_len  ; (carry set: the CPX)
    LDA item_top+1 : SBC #HI(arena) : STA fe_len+1
    \ Fall into mem_copy.
}

\ Copy fe_len bytes from fe_pos to fe_dst (with nothing being read: the
\ loader's pointers, which it moves on, and fe_len, which it uses up). X
\ is kept.
.mem_copy
{
    LDY #0
    LDA fe_len+1 : BEQ part
.page
    LDA (fe_pos),Y : STA (fe_dst),Y
    INY : BNE page
    INC fe_pos+1 : INC fe_dst+1
    DEC fe_len+1 : BNE page
.part
    CPY fe_len : BEQ done
    LDA (fe_pos),Y : STA (fe_dst),Y
    INY : BNE part              ; (always)
    ZA_UNREACHABLE
.done
    RTS
}

\ --- Entering a room --------------------------------------------------------

\ rb = room A's record (its body first), read now if it isn't here, the
\ game waiting, in place of the rooms used longest ago.
.find_body
{
    TAX : DEX : STX pf_cur      ; its id (nothing reads it before this returns)
    JSR disc_wait               ; an item under way: finish it
    INC epoch
    \ An item untouched for 256 visits would look like this one's, never to
    \ be dropped: it becomes the oldest instead.
    LDX it_n
.age
    DEX : BMI aged
    LDA it_use,X : CMP epoch : BNE age
    INC it_use,X
    BCS age                     ; (always: the CMP was equal)
    ZA_UNREACHABLE
.aged
    LDA pf_cur : JSR item_find : BMI miss
    \ This visit's, at the bottom, where reading ahead won't move it.
    LDA epoch : STA it_use,X
.arranged
    JSR arrange
    LDA pf_cur : JSR item_find
    LDA it_lo,X : STA rb
    LDA it_hi,X : STA rb+1
    RTS
\ Read it now, the game waiting (the display blanked by arrange). The
\ rest go up first, the oldest at the top, where item_add drops from.
\ (It fits, as nothing is this visit's yet, and item_add makes it so.)
.miss
    JSR arrange
    LDA pf_cur : JSR item_add
    JSR disc_wait
    JMP arranged
}
read_now = find_body.miss       ; (tools/cachetrace.mjs, roomwait.mjs: a miss)

\ gp = group X of the room's: X fours into its record.
.find_group
{
    LDA #0 : STA gp+1
    TXA
    ASL A : ROL gp+1
    ASL A : ROL gp+1            ; (carry clear: gp+1 was under 2)
    ADC rb : STA gp
    LDA gp+1 : ADC rb+1 : STA gp+1
    RTS
}

