\ ***************************************************************************
\ The game: the main loop and what happens between rooms (the original's
\ &7743-&78BE and &8A29). So far: Harry, the rooms, the status bar.
\ ***************************************************************************

\ Once, when the game is loaded.
.init_game
{
    LDA #0 : STA dbg_room : STA o_index : STA noise_flag
    LDX #3
.seed
    LDA rng_seed,X : STA rng_state,X
    DEX : BPL seed
    \ Fall into new_game.
}

\ Start a game (&7743).
.new_game
{
    LDA #0 : STA egg
    LDA #5 : STA lives
    LDX #9
    LDA #0
.zero
    STA score,X
    DEX : BPL zero
    STA carrying_name
    \ Fall into next_egg.
}

\ The next egg (&7763): room 1, Harry jumping out of the truck, the
\ factory reset.
.next_egg
{
    LDX #&FF : TXS
    LDA #1 : STA room
    INC egg
    LDA room : JSR draw_room
    LDA #0 : STA drawn
    \ Harry's template (&89E5): row 18, column 6, jumping right, count 0.
    LDA #LO(18 * 32 + 6) : STA h_cell
    LDA #HI(18 * 32 + 6) : STA h_cell+1
    LDA #0 : STA h_yf : STA h_xf : STA h_face : STA h_cnt : STA h_fall
    STA ctrl : STA room_delta : STA h_dx : STA h_dy : STA o_sel : STA dl_count
    LDA #1 : STA h_mom
    LDA #7 : STA h_state
    LDA harry_frames : STA h_frame
    LDA harry_frames+1 : STA h_frame+1
    JSR save_checkpoint
    JSR egg_init
    \ The truck backs in, then room 1 is set up as on entering it.
    JSR wait_vsync
    JSR truck_arrives
    JSR room_setup
    JMP game_loop
}

\ The main loop (&77B9): three frames a pass, always.
.game_loop
{
    \ Part 0: keys, Harry, a room change. (The noise calls are where the
    \ original's are: while the train is noisy each takes a random number.)
    JSR read_keys
    JSR harry_update
    JSR noise
    LDA room_delta : BEQ same_room
    JSR change_room
.same_room
    LDA #0 : STA o_sel          ; no object redrawn this frame (&7864)
    JSR noise
    JSR wait_vsync
    JSR draw_harry
    \ Part 1: the train or the truck, the lift, the next thing, monster
    \ tick A.
    JSR noise
    JSR machines
    JSR run_lift
    JSR next_object
    JSR noise
    JSR monsters_tick
    JSR noise
    JSR wait_vsync
    JSR draw_monsters
    JSR draw_object
    \ Part 2: contact, drop, falling; monster tick B; the next thing.
    JSR noise
    JSR collide
    JSR drop
    JSR falling
    JSR monsters_tick
    JSR noise
    JSR next_object
    JSR wait_vsync
    JSR draw_monsters
    JSR draw_object
    \ Part 3: contact, drop, falling.
    JSR noise
    JSR collide
    JSR drop
    JSR falling
    LDA dbg_room : BEQ next_pass
    JSR teleport
.next_pass
    JMP game_loop
}

\ For the tests (tools/passlog.mjs --start): they set dbg_start (Harry's
\ cell, yf, xf, state, facing) and dbg_room; at the end of the pass he is
\ put there, as the original's room set-up would (tools/passlog.py calls
\ the original's &7913 at the same point).
.teleport
{
    LDA dbg_start : STA h_cell
    LDA dbg_start+1 : STA h_cell+1
    LDA dbg_start+2 : STA h_yf
    LDA dbg_start+3 : STA h_xf
    LDA dbg_start+4 : STA h_state
    LDA dbg_start+5 : STA h_face
    LDA #0 : STA h_dx : STA h_dy
    LDA dbg_room : STA room
    LDA #0 : STA dbg_room : STA h_cnt : STA h_fall : STA room_delta
    LDA h_face : CLC : ADC h_xf : ASL A : TAX
    LDA harry_frames,X : STA h_frame
    LDA harry_frames+1,X : STA h_frame+1
    JSR enter_room
    JMP save_checkpoint
}

\ Draw the room and set it up (&7913). Nothing of Harry is on screen.
.enter_room
    LDA room : JSR draw_room
    LDA #0 : STA drawn
\ The rest of the room set-up (&8B2A, &99F6, &9088).
.room_setup
{
    JSR setup_monsters
    LDA room : CMP #1 : BEQ truck
    CMP #111 : BNE no_truck
.truck
    JSR truck_draw
.no_truck
    JSR room_things
    JMP setup_lift
}

\ Leaving a room (&77CF-&7856).
.change_room
{
    \ Rooms 80 and 71 are joined left to right.
    LDA room : CMP #80 : BNE not80
    LDA room_delta : CMP #1 : BNE not80
    LDA #71 : JMP set
.not80
    CMP #71 : BNE add
    LDA room_delta : CMP #&FF : BNE add
    LDA #80 : JMP set
.add
    LDA room : CLC : ADC room_delta
.set
    STA room
    JSR enter_room
    \ Riding a lift out of a room becomes a jump.
    LDA h_state : CMP #8 : BNE not_lift
    LDA #7 : STA h_state
    LDA #0 : STA h_cnt
    LDA #1 : STA h_mom
.not_lift
    \ Unless he went up, a floor under the feet sets walking or pipe.
    LDA room_delta : CMP #&F6 : BEQ take_checkpoint
    JSR harry_ptrs
    LDA h_xf : LSR A : CLC : ADC #&40 : TAY
    LDA (hptr),Y : AND #&12 : BNE take_checkpoint
    LDA (hptr),Y : JSR set_standing
.take_checkpoint
    LDA #0 : STA room_delta
    \ The take_checkpoint only if he came in walking or on a ladder.
    LDA h_state : CMP #1 : BEQ save
    CMP #3 : BNE done
.save
    JMP save_checkpoint
.done
    RTS
}

\ The checkpoint (&7838, &A46B): Harry, the room and the state.
CHECKPOINT_VARS = h_frame + 2 - h_cell    ; h_cell .. h_frame
.save_checkpoint
{
    LDX #CHECKPOINT_VARS - 1
.copy
    LDA h_cell,X : STA checkpoint,X
    DEX : BPL copy
    LDA room : STA checkpoint + CHECKPOINT_VARS
    RTS
}

\ Harry dies (&8A29): back to the checkpoint, a life gone. Reached by a
\ jump from wherever the test was, as in the original; the stack is reset.
.harry_died
{
    LDX #&FF : TXS
    LDX #CHECKPOINT_VARS - 1
.copy
    LDA checkpoint,X : STA h_cell,X
    DEX : BPL copy
    LDA checkpoint + CHECKPOINT_VARS : STA room
    LDA #0 : STA h_cnt : STA h_fall : STA ctrl : STA room_delta
    \ What he carried goes back where it came from (the toy and the egg
    \ he keeps).
    LDX carried : CPX #&27 : BCS kept
    LDA t_room,X : AND #&7F : STA t_room,X
    LDA #0 : JSR set_carrying
    LDA #&FF : STA carried
.kept
    \ The girder back to its start.
    LDA #13 : STA t_row+&25
    LDA #10 : STA t_col+&25
    LDA factory : AND #&FB : STA factory
    DEC lives : BNE alive
    JMP new_game                    ; (game over: the menu, later)
.alive
    JSR enter_room
    JMP game_loop
}

\ The egg delivered (&946E): 30,000 x egg, a life, the EGGS DELIVERED
\ screen until a key, then the next egg. (The truck driving off: later.)
.egg_delivered
{
    LDA d_cell : STA sp_cell
    LDA d_cell+1 : STA sp_cell+1
    LDA d_yf : STA sp_yf
    LDA d_frame : STA sp_frame
    LDA d_frame+1 : STA sp_frame+1
    JSR erase_image
    LDA egg : STA ed_n
.score_loop
    LDA #3 : LDX #5 : JSR add_score
    DEC ed_n : BNE score_loop
    JSR extra_life
    JSR truck_leaves
    \ Black, and the message in yellow (attribute 6) at row 11.
    JSR cls
    LDX #0 : LDA #0 : JSR set_logical       ; black
    LDX #3 : LDA #3 : JSR set_logical       ; yellow
    LDA #LO(11 * 32 + 7) : STA cell : LDA #HI(11 * 32 + 7) : STA cell+1
    LDX #0
.text
    LDA delivered_text,X : BEQ number
    STX ed_n
    JSR yellow_char
    LDX ed_n : INX : JMP text
.number
    \ The egg number, at column 24 (two digits if it needs them).
    LDA #LO(11 * 32 + 24) : STA cell
    LDA egg : LDX #0
.tens
    CMP #10 : BCC units
    SBC #10 : INX : JMP tens
.units
    PHA
    TXA : BEQ one_digit
    CLC : ADC #48 : JSR yellow_char
.one_digit
    PLA : CLC : ADC #48 : JSR yellow_char
    JSR wait_key
    JMP next_egg
}

\ The original's wait (&94D7) clears the Spectrum's LAST K and waits for the
\ ROM to set it: a new key press, or a held key once it repeats (35 frames).
.wait_key
{
    LDA #35 : STA ed_n
.held
    JSR wait_vsync
    JSR any_key : BEQ press
    DEC ed_n : BNE held
    RTS
.press
    JSR wait_vsync
    JSR any_key : BEQ press
    RTS
}
.ed_n EQUB 0
.delivered_text EQUS "EGGS DELIVERED:-", 0
\ Character A, yellow on black, at `cell`; step right.
.yellow_char
{
    SEC : SBC #32 : STA glyph : LDA #0 : STA glyph+1
    ASL glyph : ROL glyph+1 : ASL glyph : ROL glyph+1 : ASL glyph : ROL glyph+1
    CLC : LDA glyph : ADC #LO(text_font) : STA glyph
    LDA glyph+1 : ADC #HI(text_font) : STA glyph+1
    LDA #cbyte(0) : STA paper
    LDA #cbyte(3) : STA diff
    JSR draw_glyph_pd
    INC cell
    RTS
}

\ Erase Harry where he was drawn, draw him where he is, in yellow
\ (decision 6: Spectrum colour 6).
.draw_harry
{
    BIT drawn : BPL fresh
    LDA d_cell : STA sp_cell
    LDA d_cell+1 : STA sp_cell+1
    LDA d_yf : STA sp_yf
    LDA d_frame : STA sp_frame
    LDA d_frame+1 : STA sp_frame+1
    JSR erase_image
.fresh
    LDA h_cell : STA sp_cell : STA d_cell
    LDA h_cell+1 : STA sp_cell+1 : STA d_cell+1
    LDA h_yf : STA sp_yf : STA d_yf
    LDA h_frame : STA sp_frame : STA d_frame
    LDA h_frame+1 : STA sp_frame+1 : STA d_frame+1
    LDX cmap+6 : LDA colour_bytes,X : STA sp_colour
    JSR draw_sprite
    LDA #&80 : STA drawn
    RTS
}

\ The keys (&78C1), the Spectrum's for now (decision 7), into ctrl: bit 7
\ abort, 6 take/drop, 5 save, 4 up, 3 down, 2 left, 1 right, 0 jump.
.read_keys
{
    LDA #0 : STA ctrl
    LDY #7
.key
    STY keys_i
    LDX key_codes,Y : JSR key_down
    CMP #0 : CLC : BEQ up
    SEC
.up
    ROL ctrl
    LDY keys_i : DEY : BPL key
    RTS
}
.keys_i EQUB 0
\ Negative INKEY codes (internal key number EOR &FF; measured in jsbeeb),
\ bit 0 first: SPACE, P, O, A, Q, S, 1, 0.
.key_codes
    EQUB 98, 55, 54, 65, 16, 81, 48, 39

\ The RNG's state on the tape (&91B1).
.rng_seed EQUS "9090"
