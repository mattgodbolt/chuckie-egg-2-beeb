\ ***************************************************************************
\ The game: the main loop and what happens between rooms (the original's
\ &7743-&78BE and &8A29).
\ ***************************************************************************

\ (A new game, or a saved one carried on, starts in startup.6502: init_game,
\ new_game and resume.)

\ The next egg (&7763): room 1, Harry jumping out of the truck, the
\ factory reset.
.next_egg
{
    LDX #&FF : TXS
    LDA #1 : STA room
    INC egg
    JSR show_room
    LDX #CHECKPOINT_VARS - 1
.harry
    LDA egg_harry,X : STA h_cell,X
    DEX : BPL harry
    \ (ctrl, o_sel and dl_count need no clearing here: read_keys,
    \ room_things and monsters_tick set them before anything reads them.)
    INX : STX room_delta            ; (X = 0)
    JSR save_checkpoint
    JSR egg_init
    \ The truck backs in, then room 1 is set up as on entering it.
    JSR wait_vsync
    JSR truck_arrives
    JSR room_setup
    JMP game_loop
}
\ Harry's template (&89E5): row 18, column 6, jumping right, count 0; in
\ save_checkpoint's layout, h_cell .. h_frame.
.egg_harry
    EQUW 18 * 32 + 6
    EQUB 0, 0, 0, 0, 0, 1, 7, 0, 0  ; yf xf dx dy face mom state cnt fall
    EQUW harry_gfx                  ; frame 0 (harry_frames' first)

\ The main loop (&77B9): three frames a pass, always.
.game_loop
{
    \ Part 0: keys, Harry, a room change. (The noise calls are where the
    \ original's are: while the train is noisy each takes a random number.)
    JSR read_keys
    JSR harry_update
    JSR noise
    LDA room_delta : BEQ same_room
    JSR change_room
.same_room
    JSR move_sound
    LDA #0 : STA o_sel          ; no object redrawn this frame (&7864)
    JSR noise
    JSR wait_vsync
    JSR draw_harry
    \ Part 1: the train or the truck, the lift, the next thing, monster
    \ tick A.
    JSR move_sound
    JSR noise
    JSR machines
    JSR noise_sound
    JSR run_lift
    JSR next_object
    JSR noise
    JSR monsters_tick
    JSR noise
    JSR draw_frame
    \ Part 2: contact, drop, falling; monster tick B; the next thing.
    JSR contact_pass
    JSR monsters_tick
    JSR noise
    JSR next_object
    JSR draw_frame
    \ Part 3: contact, drop, falling.
    JSR contact_pass
IF DEFINED(DIRECT)
    LDA dbg_room : BEQ game_loop
    \ Fall into teleport.
ELSE
    JMP game_loop
ENDIF
}
IF DEFINED(DIRECT)
\ For the tests (tools/beeb.mjs's teleport, for passlog.mjs --start), on
\ the tests' disc only: they set dbg_room, and when the pass ends here they
\ put Harry, his frame and the room in place; the room is then entered as
\ the original's set-up would (tools/passlog.py calls the original's &7913
\ at the same point).
.teleport
    LDA #0 : STA dbg_room
    JSR enter_room
    JSR save_checkpoint
    JMP game_loop
ENDIF

\ At the next frame, the monsters that moved and the current thing (the
\ original's interrupt).
.draw_frame
    JSR wait_vsync
    JSR draw_monsters
    JMP draw_object
\ Contact, drop, falling.
.contact_pass
    JSR noise
    JSR collide
    JSR drop
    JMP falling

\ Draw the room (&7913). Nothing of Harry is on screen.
.show_room
    LDA #0 : STA drawn
    LDA room : JMP draw_room

\ Draw the room and set it up (&7913).
.enter_room
    JSR show_room
\ The rest of the room set-up (&8B2A, &99F6, &9088).
.room_setup
{
    JSR setup_monsters
    LDA room : CMP #1 : BEQ truck
    CMP #111 : BNE no_truck
.truck
    JSR truck_draw
.no_truck
    JSR room_things
    JMP setup_lift
}

\ Leaving a room (&77CF-&7856).
.change_room
{
    \ Rooms 80 and 71 are joined left to right: 81 from 80 going right
    \ is 71, 70 from 71 going left 80. (room_delta is 1, -1, 10 or -10.)
    LDA room : CLC : ADC room_delta
    LDX room_delta
    CMP #81 : BNE not81
    DEX : BNE set                   ; (X = 1: right)
    LDA #71 : BNE set               ; (always)
.not81
    CMP #70 : BNE set
    INX : BNE set                   ; (X = -1: left)
    LDA #80
.set
    STA room
    JSR enter_room
    \ Riding a lift out of a room becomes a jump.
    LDA h_state : CMP #8 : BNE not_lift
    DEC h_state                     ; 7
    LDX #0 : STX h_cnt
    INX : STX h_mom
.not_lift
    \ Unless he went up, a floor under the feet sets walking or pipe.
    LDA room_delta : CMP #&F6 : BEQ take_checkpoint
    JSR harry_ptrs
    \ (An ADD, as the original's: a slope's edge leaves xf unnormalised,
    \ 255 sliding left off a room's bottom, which reads T(&BF).)
    LDA h_xf : LSR A : CLC : ADC #&40 : TAY
    LDA (hptr),Y : AND #&12 : BNE take_checkpoint
    LDA (hptr),Y : JSR set_standing
.take_checkpoint
    LDA #0 : STA room_delta
    \ The take_checkpoint only if he came in walking or on a ladder.
    LDA h_state : AND #&FD : CMP #1 : BNE save_checkpoint.done  ; states 1 and 3
    \ Fall into save_checkpoint.
}

\ The checkpoint (&7838, &A46B): Harry, the room and the state.
CHECKPOINT_VARS = h_frame + 2 - h_cell    ; h_cell .. h_frame
.save_checkpoint
{
    LDX #CHECKPOINT_VARS - 1
.copy
    LDA h_cell,X : STA checkpoint,X
    DEX : BPL copy
    LDA room : STA checkpoint + CHECKPOINT_VARS
.done
    RTS
}

\ Harry dies (&8A29): back to the checkpoint, a life gone. Reached by a
\ jump from wherever the test was, as in the original; the stack is reset.
.harry_died
{
    JSR death_tune
    LDX #&FF : TXS
    LDX #CHECKPOINT_VARS - 1
.copy
    LDA checkpoint,X : STA h_cell,X
    DEX : BPL copy
    LDA checkpoint + CHECKPOINT_VARS : STA room
    \ (room_delta is already 0: set only by harry_update's last step, the
    \ edges, and cleared by change_room straight after.)
    INX : STX h_cnt : STX h_fall : STX ctrl     ; (X = 0)
    \ What he carried goes back where it came from (the toy and the egg
    \ he keeps).
    LDX carried : CPX #&27 : BCS kept
    JSR thing_on
    LDA #0 : JSR set_carrying
    LDA #&FF : STA carried
.kept
    JSR girder_home
    \ The developers' infinite lives (&8A7D NOPped by the cheat byte's bit
    \ 4, which also leaves the game-over test's flags never zero).
    LDA cheat : AND #&10 : BNE alive
    DEC lives : BNE alive
    LDA #MB_OVER : JMP handoff      ; game over: the front end checks the score
.alive
    JSR enter_room
    JMP game_loop
}

\ The egg delivered (&946E): 30,000 x egg, a life, the EGGS DELIVERED
\ screen until a key, then the next egg. (The truck driving off: later.)
.egg_delivered
{
    LDX #d_cell : JSR sp_erase_at
    LDA #3 : JSR reward
    JSR truck_leaves
    \ Black, and the message in yellow (attribute 6) at row 11.
    JSR cls
    LDA #0 : TAX : JSR set_logical          ; black
    LDA #3 : TAX : JSR set_logical          ; yellow
    LDA #LO(11 * 32 + 7) : STA cell : LDA #HI(11 * 32 + 7) : STA cell+1
    LDX #0
.text
    LDA delivered_text,X : BEQ number
    STX ed_n
    JSR yellow_char
    LDX ed_n : INX : BNE text       ; (always)
.number
    \ The egg number, at column 24 (two digits if it needs them).
    LDA #LO(11 * 32 + 24) : STA cell
    LDA egg : JSR tens_units
    PHA
    CPX #'0' : BEQ one_digit
    TXA : JSR yellow_char
.one_digit
    PLA : JSR yellow_char
    JSR wait_key
    JMP next_egg
}

\ The original's wait (&94D7) clears the Spectrum's LAST K and waits for the
\ ROM to set it: a new key press, or a held key once it repeats (35 frames).
.wait_key
{
    LDA #35 : STA ed_n
.frame
    JSR wait_vsync
    JSR any_key : BNE down
    LDA #1 : STA ed_n               ; up: the next frame with a key down ends it
    BNE frame                       ; (always)
.down
    DEC ed_n : BNE frame
    RTS
}
\ (delivered_text is in page 1: pages.6502; yellow_char in status.6502.)

\ Erase Harry where he was drawn, draw him where he is, in yellow
\ (decision 6: Spectrum colour 6).
.draw_harry
{
    BIT drawn : BPL fresh
    LDX #d_cell : JSR sp_erase_at
.fresh
    LDX #2
.copy
    LDA h_cell,X : STA d_cell,X     ; d_cell, d_yf
    DEX : BPL copy
    LDA h_frame : STA d_frame
    LDA h_frame+1 : STA d_frame+1
    LDA #&80 : STA drawn
    LDA #6 : LDX #d_cell : JMP sp_draw_ink    ; yellow
}

\ The keys (&78C1), the Spectrum's for now (decision 7), into ctrl: bit 7
\ abort, 6 take/drop, 5 save, 4 up, 3 down, 2 left, 1 right, 0 jump.
.read_keys
{
    LDY #7
.key
    LDX mb_keys,Y : JSR key_down    ; (which keeps Y)
    ASL A : ROL ctrl                ; its bit 7 in; eight shift out the last
    DEY : BPL key
    \ The developers' room skip (&78D5, decision 27): with the cheat
    \ byte's bit 3, SHIFT (the Spectrum's CAPS SHIFT) and left or right
    \ change room by -1 or +1 (-3 with both), wrapping 1-120, entered
    \ as if walked into, Harry where he was; the pass goes on from there.
    LDA cheat : AND #8 : BEQ actions
    LDX #0 : JSR key_down : BEQ actions        ; SHIFT
    LDA ctrl : AND #6 : BEQ actions            ; left (4), right (2)
    EOR #&FF : SEC : ADC #3                    ; -1, +1 or -3
    CLC : ADC room : BNE not0
    LDA #120
.not0
    CMP #121 : BNE not121
    LDA #1
.not121
    \ (-3 from rooms 1 and 2 makes 254 and 255, past the last room, which
    \ the Spectrum would try to draw: they wrap to 118 and 119.)
    CMP #254 : BCC skip
    ADC #120 - 1                               ; (carry set)
.skip
    LDX #&FF : TXS
    JSR change_room.set
    JMP game_loop.same_room
.actions
    \ Abort and save go to the front end at once (&7902). A save needs a
    \ fresh press: the key may still be down when the game carries on.
    LDA #MB_ABORT : BIT ctrl : BMI handoff_a
    LDA ctrl : AND #&20 : BEQ save_up
    LDA save_armed : BEQ done
    LDA #MB_SAVE
.handoff_a
    JMP handoff
.save_up
    LDA #1 : STA save_armed
.done
    RTS
}

\ The rest of resume (startup.6502), which can't stay in the loader: the
\ room drawn again (its cls clears the loader), its things, then the main
\ loop, with no truck.
.resume_room
    JSR show_room
IF DEFINED(STREAM)
    \ The monsters' and the lift's frames were saved as addresses, and the
    \ streaming edition's cache (disc.6502) may have the room's graphics
    \ somewhere else now: point them at its frames again. (Not the frames
    \ last drawn, m_oframe: only m_erase reads them, for a monster on this
    \ tick's draw list or respawning, and m_move and respawn save them
    \ first, as they do on entering a room.)
{
    LDX m_count
.monster
    DEX : BMI monsters_done
    JSR choose_frame
    BPL monster                     ; (always: choose_frame leaves N clear)
.monsters_done
    \ (The lift's l_oframe isn't read before run_lift sets it.)
    LDA l_type : BEQ no_lift
    JSR setup_lift.frame            ; (l_width again, as it was)
.no_lift
}
ENDIF
    JSR room_things
    JMP game_loop
