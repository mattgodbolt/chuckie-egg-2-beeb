\ ***************************************************************************
\ The game's way back to the front end (decision 13; the mailbox and the
\ why are in state.6502).
\ ***************************************************************************


\ Back to MENU with reason A: the state saved, the OS put back, a reset.
.handoff
{
    ZA_AUTO2 sr_mem
    ZA_AUTO2 sr_blk
    SEI
    STA mb_reason
    LDA lives : STA mb_game     ; (MENU only asks if it's 0)
    LDX #9
.keep
    LDA score,X : STA mb_score,X
    CPX #4 : BCS keep_next
    LDA rng_state,X : STA mb_rng,X
.keep_next
    DEX : BPL keep
    \ The regions (pages.6502's state_regions) copied to STATE.
    INX : STX sr_blk            ; (X = &FF: 0)
    ASSERT LO(STATE) = 0
    LDA #HI(STATE) : STA sr_blk+1
.region
    LDA state_regions,X : STA sr_mem
    LDA state_regions+1,X : STA sr_mem+1
    LDY #0
.byte
    LDA (sr_mem),Y : STA (sr_blk),Y
    INY
    TYA : CMP state_regions+2,X : BNE byte
    \ sr_blk + the length: (Y - 1) + 1 with the carry, which the CMP left
    \ set, so a length of 0 (a whole page) adds 256.
    DEY : TYA : ADC sr_blk : STA sr_blk
    BCC done_add
    INC sr_blk+1
.done_add
    INX : INX : INX
    CPX #state_regions_end - state_regions : BNE region
    \ Silence: the tone channels already are (move_sound and death_tune end
    \ each note), so only the train's noise may be on.
    LDA #&FF : JSR sound_write
    \ Every key up first: the abort or save key will still be down, and a
    \ key held through a BREAK stops the DFS booting (it picks a filing
    \ system); SHIFT would stop the boot, CTRL make it a hard reset.
.keys
    JSR any_key : BNE keys
    LDX #1                      ; CTRL, then SHIFT
.ctrl_shift
    JSR key_down : BNE keys
    DEX : BPL ctrl_shift
    \ The keyboard as the OS left it (sound_write leaves port A all
    \ outputs, and the reset's boot reads keys through bit 7): bit 7 an
    \ input again (key_down's), and auto-scan back on.
    LDA #&0B : STA sysvia_orb
    LDX #OS_KEPT_LEN - 1
.os
    LDA mb_os,X : STA OS_KEPT,X
    DEX : BPL os
    INX : STX &0258             ; (X = 0) *FX 200: no memory clear on BREAK
    LDA &028F : EOR #8 : STA &028F  ; BREAK boots without SHIFT, this once
    INX : STX mb_flipped        ; 1
.reset_jump
    JMP (&FFFC)                 ; a Master's loader makes it JMP master_reset
}

\ (keep_os notes what a soft BREAK keeps at start-up: startup.6502.)
