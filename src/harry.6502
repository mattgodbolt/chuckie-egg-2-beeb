\ ***************************************************************************
\ Harry: a transcription of the original's update (&80B6-&8A97), from
\ docs/research/harry.md section 6, which follows the code in order. The
\ original's labels are given with their addresses.
\
\ The original keeps Harry as screen and attribute addresses; here he is a
\ cell (row * 32 + col), a pixel line yf and a 2-pixel step xf, which is
\ all the logic uses. T(off) is the cell type at his top-left cell + off
\ (off = 32 a row down + 1 a column right): (hptr),Y, or (hptr_up),Y with
\ off + 32 for the negative ones.
\
\ VCollide's E (yf before the move) is h_yf itself: nothing before the move
\ changes it on a path that reads E.
\ ***************************************************************************

ZA_AUTO1 vD                 ; VCollide's D: xf + dx + 1
ZA_AUTO1 vB                 ; ColumnBlocked's count of rows
ZA_AUTO1 vH                 ; the lift tests' scratch
ZA_AUTO2 pp                 ; SideWalls' column pointer

\ hptr = type_map + h_cell; hptr_up = hptr - 32.
.harry_ptrs
    CLC : LDA h_cell+1 : ADC #HI(type_map) : STA hptr+1
    LDA h_cell : STA hptr
    SBC #31 : STA hptr_up           ; (C clear: the ADC can't carry) - 32
    LDA hptr+1 : SBC #0 : STA hptr_up+1
    RTS

\ HarryUpdate (&80B6): once a pass of the main loop.
.harry_update
{
    JSR harry_ptrs
    LDA ctrl : AND #6 : TAX     ; dx = right - left
    LDA key_dx,X : STA h_dx
    LDA ctrl : AND #&18 : LSR A : LSR A : TAX   ; dy = 2 * up - 2 * down
    LDA key_dy,X : STA h_dy
    LDX h_state : BEQ dispatch  ; falling: the fall goes on, no jump
    LDA #0 : STA h_fall
    CPX #7 : BEQ dispatch
    LDA ctrl : LSR A : BCS start_jump
.dispatch
    LDA states_hi,X : PHA
    LDA states_lo,X : PHA
    RTS                         ; to the state's routine, with X = h_state
    ZA_CANJUMP st_fall, st_walk, st_pipe, st_ladder, st_rope, st_slope_up, st_slide, st_jump, st_lift
}
\ dx from the right and left keys (ctrl bits 1, 2), dy from down and up
\ (bits 3, 4), interleaved: each indexed by its two bits times 2.
.key_dx
key_dy = key_dx + 1
    EQUB 0, 0                   ; dx, dy: neither
    EQUB 1, -2 AND &FF          ; right, down
    EQUB -1 AND &FF, 2          ; left, up
    EQUB 0, 0                   ; both
\ The states (&8A17), less one for the RTS.
.states_lo
    EQUB LO(st_fall - 1), LO(st_walk - 1), LO(st_pipe - 1), LO(st_ladder - 1)
    EQUB LO(st_rope - 1), LO(st_slope_up - 1), LO(st_slide - 1), LO(st_jump - 1)
    EQUB LO(st_lift - 1)
.states_hi
    EQUB HI(st_fall - 1), HI(st_walk - 1), HI(st_pipe - 1), HI(st_ladder - 1)
    EQUB HI(st_rope - 1), HI(st_slope_up - 1), HI(st_slide - 1), HI(st_jump - 1)
    EQUB HI(st_lift - 1)

\ StartJump (&82CB)
.start_jump
{
    \ (X = h_state, from harry_update)
    CPX #4 : BNE not_rope
    LDA h_dx : BEQ harry_update.dispatch    ; no jumping straight off a rope
                                    ; (X = 4: on with st_rope)
.not_rope
    CPX #6 : BNE not_slide
    LDA h_mom : STA h_dx            ; jump the way the slide goes
.not_slide
    LDA #0
    DEX : DEX : DEX : CPX #2 : BCS xf_ok   ; states 3 and 4: xf 0
    STA h_xf
.xf_ok
    STA h_cnt                       ; (h_fall is 0: harry_update)
    LDA #7 : STA h_state
    LDA h_dx : STA h_mom : BEQ no_face
    AND #4 : STA h_face             ; (dx is 1 or -1: face 0 or 4)
.no_face
    LDA carried : AND #&FC : CMP #&20 : BNE st_jump
    LDA #3 : STA h_cnt              ; a basket (&20-&23): a lower jump
    \ Fall into st_jump.
}
\ StJump (&832A): state 7.
.st_jump
    LDA h_mom : STA h_dx
    LDX h_cnt : INX : STX h_cnt
    CPX #22 : BCC jump_arc_dy
    LDA #5 : STA h_fall             ; the jump's end: falling
    \ Fall into st_fall.
\ StFall (&82B2): state 0, and so h_state 0 for the jump's end and
\ slope_aligned.
.st_fall
    LDA #0 : STA h_state : STA h_dx
    JMP fall_dy
.jump_arc_dy
    LDA jump_arc-1,X : STA h_dy
    \ Fall into vcollide.

\ VCollide (&8355): ceilings, landings, grabbing, walls.
.vcollide
{
    LDA h_xf : SEC : ADC h_dx : STA vD   ; xf + dx + 1
    LDX h_dy : DEX : BMI descend    ; dy 0 or less (it is -4 to 4)
    \ Rising.
    LDA h_yf : SEC : SBC h_dy : BPL lg  ; the head stays in this cell row
    LDA vD : SBC #0 : AND #3 : BEQ ceil_col     ; (C clear: it borrowed)
    LDY #1 : LDA (hptr_up),Y        ; straddling: the right-hand column too
    BMI die
    AND #&2D : BNE hit_ceiling
.ceil_col
    LDY #0 : LDA (hptr_up),Y
    BMI die
    TAX : AND #&2D : BEQ lg
    TXA : AND #&12 : BNE lg
\ HitCeiling (&8397)
.hit_ceiling
    LDX h_cnt : DEX : BNE top_of_cell
    STX h_dy                        ; a ceiling right on the head: no jump
    BEQ descend                     ; (always)
.top_of_cell
    LDA h_yf : STA h_dy             ; rise to the top of this cell only
    INX : CPX #11 : BCS lg          ; (X: h_cnt)
    LDA #11 : STA h_cnt             ; and start the way down
.lg
    JMP ladder_grab
.die
    JMP harry_died

\ Descend (&83FA): feet over a lift and within 2 above to 3 below its top
\ put him on it (state 8), moving with it from this pass.
.descend
    LDA l_type : BEQ slope_snap
\ LiftLand (the rest of &83FA): over the lift, the feet near its top?
    \ Across: from the column left of it (if he reaches in) to its last,
    \ so his column - (its column - 1) is 0 to its width. One unsigned
    \ compare does the original's two, against its column - 1 and that +
    \ width: the lifts are never in column 0 (machines.6502's lift_col) and
    \ are at least 1 wide, and left of it wraps to 226 or more.
    LDA l_cell : AND #31 : TAX : DEX : STX vH
    LDA h_cell : AND #31 : SEC : SBC vH : BEQ left_end
    CMP l_width : BCC across
    BNE slope_snap
    LDX vD : CPX #4 : BCS slope_snap    ; the last column: if he reaches in
    BCC across                      ; (always)
.left_end
    LDX vD : CPX #3 : BCC slope_snap    ; the column left of it: the same
.across
    \ Down: (its top line - 13) - his top line must be 0-5. (Rows are
    \ under 32, so each ASL clears the carry.)
    LDA h_cell : LDX h_cell+1 : JSR cell_row
    ASL A : ASL A : ASL A : ORA h_yf
    ADC #12 : STA vH                ; his top line + 13, less SBC's borrow
    LDA l_cell : LDX l_cell+1 : JSR cell_row
    ASL A : ASL A : ASL A : ORA l_yf
    SBC vH : CMP #6 : BCS slope_snap
    \ dy = 3 - that, and 2 more for the rising bar.
    EOR #&FF : ADC #4               ; (C clear: the CMP)
    LDX l_type : CPX #1 : BNE dy_set
    ADC #1                          ; (C set: the CPX)
.dy_set
    STA h_dy
    LDA #8 : STA h_state
    LDA h_fall : CMP #20 : BCS die
    LDY #0 : LDA (hptr_up),Y : LSR A : BCS die
    BCC to_move                     ; (always)

\ SlopeSnap (&8489): a slope tile under the feet snaps Harry onto it.
.slope_snap
    LDA h_xf : LSR A : AND #1 : TAX ; X: the column under the feet, 0 or 1
    ORA #&20                        ; T(&20 + X), or T(&40 + X) off the
    LDY h_yf : BEQ tile_test        ; cell's top line
    EOR #&60
.tile_test
    TAY
    \ The tile map is three pages below the type map.
    LDA hptr : STA pp
    LDA hptr+1 : SEC : SBC #HI(type_map) - HI(tile_map) : STA pp+1
    LDA (pp),Y : TAY                ; Y: the tile, to set_slope_state
    LSR A : EOR #&38 / 2 : BEQ snap38_39    ; (C: the tile's bit 0)
    EOR #(&38 EOR &54) / 2 : BNE land_test  ; not &54 or &55

\ The slope snaps (&84C0, &84F8, &8535). X is the column Harry's feet are
\ over (0 or 1), Y the slope tile there (add_cell keeps Y).
.snap_surface
    LDA #0 : STA h_xf
    TXA : JSR add_cell
    LDA #4 : STA h_yf
    BNE snap_done                   ; (always)
.snap38_39
    LDA #&38 : BCC snap_row         ; &38 (sic: xf &38, which apply_delta
                                    ;  turns into xf 0 and a column right)
    DEX                             ; &39: one column left of the feet
    LDA #2
.snap_row
    STA h_xf
    TXA : JSR add_cell
    \ Up a row, to its top line. The original subtracts 32 from (attribute
    \ low byte, screen high byte with yf cleared), so leaving the top row
    \ of a screen third (rows 8, 16) borrows into the third's bits and
    \ gives yf 7: kept, because it moves Harry.
    LDX #0
    LDA h_cell : AND #&E0 : BNE same_third  ; row AND 7 = 0 (cell bits 5-7)
    LDX #7
.same_third
    STX h_yf
    LDA #-32 AND &FF : JSR add_cell
.snap_done
    LDA #0 : STA h_dx : STA h_dy
    LDA h_face : AND #&F7 : STA h_face
\ SetSlopeState (&87E8): slope tile Y (&38, &54 '\', or &39, &55 '/',
\ all that the snaps pass); climb it or slide down it.
    TYA : LSR A
    LDA h_mom : BCS fwd
    \ '\'
    BMI climb
    LDA #1 : BNE slide              ; slide right
.fwd                                ; '/'
    BMI slide_left
    BNE climb
.slide_left
    LDA #&FF
.slide
    STA h_mom
    LDA #6 : BNE set_state          ; (always)
.climb
    LDA #5
.set_state
    STA h_state
.to_move
    JMP move_nosave
.die_land
    JMP harry_died

\ LandTest (&83D4)
.land_test
    LDY #&40
    LDA h_yf : SEC : SBC h_dy : BEQ test    ; aligned: test under the feet
    CMP #8 : BCC ladder_grab                ; the feet stay in the cell
    LDY #&60                                ; the feet enter the next row
.test
    LDX vD : CPX #4 : BCS land_right
    LDA (hptr),Y
    BMI die_land
    AND #&21 : BNE land
    CPX #3 : BCC ladder_grab
\ LandRight (&859D)
.land_right
    INY : LDA (hptr),Y
    BMI die_land
    AND #&2D : BEQ ladder_grab
\ Land (&8570)
.land
    JSR set_standing                ; (it ANDs with &21: the type's bits)
    LDA h_yf : BEQ on_surface
    ORA #&F8                        ; yf - 8
.on_surface
    STA h_dy                        ; finish exactly on the surface
    LDA h_fall : CMP #15 : BCS die_land     ; fell too far
    LDX #0 : STX h_fall
    LDA h_face : CMP #8 : BNE ladder_grab
    STX h_xf : STX h_face
    \ Fall into ladder_grab.
}

\ LadderGrab (&85B4), HeadSlope (&8614), SideWalls (&862D)
.ladder_grab
{
    LDY #0                          ; (for T(0), to head_slope)
    LDA h_xf : BEQ can_grab
    LDA h_face : CMP #8 : BNE head_slope
.can_grab
    LDA carried : AND #&FC : CMP #&20 : BEQ head_slope  ; not with a basket
    LDA ctrl : AND #&18 : BEQ head_slope    ; up or down held
    LDX h_cnt : DEX : BEQ head_slope
    LDA (hptr),Y : AND #&12 : BEQ head_slope
    LDX #3 : CMP #2 : BEQ grab
    INX
    LDY #&40 : LDA (hptr),Y : AND #&10 : BNE grab
    LDX #0
.grab
    STX h_state
    LDY #0 : STY h_dx
    LDA h_yf : AND #1 : STA h_dy
    LDA #8 : STA h_face
.head_slope
    LDA (hptr),Y : AND #&0C : BEQ side_walls
    LDA #16 : STA h_cnt
    LDA #0 : STA h_dx : STA h_mom
    BEQ move                        ; (always)
.side_walls
    LDX #2                          ; rows the sprite will cover
    LDA h_yf : SEC : SBC h_dy : TAY ; his top line after the move
    AND #7 : BEQ rows
    INX
.rows
    STX vB
    \ The column pointer: a row up, this row or a row down.
    TYA : BMI up
    CMP #8
    LDA hptr : LDX hptr+1
    BCC got_p
    ADC #31 : BCC got_p             ; (C set: + 32)
    INX : BCS got_p                 ; (always)
.up
    LDA hptr_up : LDX hptr_up+1
.got_p                              ; (X:A)
    LDY h_dx : BMI left
    BNE right
    LDY h_xf : CPY #1 : BEQ right
    CPY #3 : BNE move
.lift_walk                          ; (st_lift: C clear to go right; here
    BCC right                       ;  C is set, by the CPY)
.left
    LDY h_xf : BNE left_p
    SEC : SBC #1 : BCS left_p       ; a column left
    DEX
.left_p
    JSR column_blocked : BEQ move
    LDA #1 : BNE bounce             ; (always)
.right
    CLC : ADC #1 : BCC right_p      ; a column right
    INX
.right_p
    JSR column_blocked : BEQ move
    LDA #&FF
.bounce
    STA h_dx
    LDA #1 : SBC h_mom : STA h_mom  ; (C clear: column_blocked) - mom
    \ Fall into move.
}

\ Move (&887E), MoveNoSave (&8881): the original saves the old position
\ for its erase here; the sprite engine records what it drew instead.
\ ApplyDelta (&8E94), then the frame and the room edges.
.move
.move_nosave
{
    LDA h_xf : CLC : ADC h_dx : TAX
    AND #3 : STA h_xf
    \ A cell right or left: the low byte only, as the original's INC and
    \ DEC (IY+2) step its screen address's (&8EA9, &8EAF). Past column 0
    \ or 31 at the top or bottom of a third of the screen it wraps within
    \ the third (row 16's column 0 to row 23's column 31).
    TXA : BMI left
    CMP #4 : BCC vertical
    INC h_cell
    BCS vertical                ; (always: C from the CMP)
.left
    DEC h_cell
.vertical
    LDA h_yf : SEC : SBC h_dy : TAX
    AND #7 : STA h_yf
    TXA : BMI up
    CMP #8 : BCC frame
    LDA #32 : BNE add           ; down a row
.up
    LDA #-32 AND &FF            ; up a row
.add
    JSR add_cell
.frame
    \ The frame: picked before the edges change xf (an original glitch,
    \ harry.md section 10: kept). Face is 0, 4 or 8 and xf 0-3.
    LDA h_face : ORA h_xf : ASL A : TAX
    LDA harry_frames,X : STA h_frame
    LDA harry_frames+1,X : STA h_frame+1
    \ Fall into edges.
}

\ The room edges (&8890-&89BC), after the move. (The original zeroes
\ room_delta when Harry crosses no edge: here it is 0 already, as nothing
\ else sets it and game_loop's change_room zeroes it after a change.)
.edges
{
    LDA h_cell : AND #31 : BEQ left_col
    CMP #31 : BNE top
    LDX h_dx : DEX : BMI top        ; dx < 1 (it is -2 to 2)
    \ Right: to column 0, xf 2.
    LDA #-31 AND &FF : JSR add_cell
    LDA #1 : STA room_delta
    ASL A : STA h_xf
    LDA h_state : CMP #5 : BNE done
    LDA #-31 AND &FF : JSR add_cell             ; on a slope: up a row,
    LDA #0 : STA h_yf                           ; column 1
.done
    RTS
.left_col
    LDA h_dx : BPL top
    LDA h_xf : BNE top
    \ Left: to column 30, xf 3.
    LDA #30 : JSR add_cell
    LDA #3 : STA h_xf
    LDA #&FF : STA room_delta
    RTS
.top
    LDA h_cell+1 : BNE bottom
    LDA h_cell : CMP #64 : BCS done ; (rows 2-7: not the bottom either)
    \ Top: to row 21, yf 4.
    AND #31 : ORA #LO(21 * 32) : STA h_cell
    LDA #HI(21 * 32) : STA h_cell+1
    ASL A : STA h_yf                ; 4
    LDA #&F6 : STA room_delta
    LDA h_state : CMP #5 : BNE done
    LDA h_dx : ASL A
.slope
    JSR add_cell
    LDA h_xf : CLC : ADC h_dx : STA h_xf        ; (left unnormalised)
    RTS
.bottom                             ; (A = h_cell+1)
    LDX h_cell : CPX #LO(21 * 32)               ; row 21 or below?
    SBC #HI(21 * 32) : BCC done
    LDA h_yf : CMP #4 : BCC done
    LDA h_dy : BPL done
    \ Bottom: to row 2, yf 0.
    TXA : AND #31 : ORA #64 : STA h_cell        ; (X = h_cell)
    LDA #0 : STA h_cell+1 : STA h_yf
    LDA #10 : STA room_delta
    LDA h_state : CMP #6 : BNE done
    LDA h_dx : ASL A : CLC : ADC h_dx : JMP slope
}

\ ColumnBlocked (&8699): any of vB cells down from X:A solid? Z clear if so.
.column_blocked
{
    STA pp : STX pp+1
    LDY #0 : CLC
.loop
    LDA (pp),Y
    BMI die
    AND #&21 : BNE done
    TYA : ADC #32 : TAY             ; (C stays clear: Y < 96)
    DEC vB : BNE loop
.done
    RTS                             ; Z set: clear all the way down
.die
    JMP harry_died
}

\ WallCheck (&86AC): walking, cell-aligned: a wall ahead stops him.
.wall_check
{
    ZA_AUTO2 ahead
    \ The cell ahead, as the original finds it: dx added to the low byte
    \ alone (LD A,(IY+B) : ADD A,(IY+2) : LD L,A), so at a page's edge it
    \ wraps within the page. Left of row 16's column 0 is row 23's column
    \ 31, not row 15's (fuzz: room 80, where that cell is solid).
    LDA hptr : CLC : ADC h_dx : STA ahead
    LDA hptr+1 : STA ahead+1
    LDY #0 : LDA (ahead),Y
    BMI die
    AND #&2D : BEQ legs
    CPX #5 : BNE stop               ; on a slope? (X: h_state, 5 or 6, from
                                    ;  slope_aligned; 1-4 from st_walk)
    \ Climbing a slope into a wall: turn back, and abandon the caller.
    \ (The original sets dx = -mom and goes to StSlopeUp, which, dx not
    \ being mom, turns him back.)
    PLA : PLA
    LDA h_mom : JMP st_slope_up.reverse
.legs
    LDY #&20 : LDA (ahead),Y        ; a row down, with the carry (&89BD)
    BMI die
    AND #&21 : BEQ ok
.stop
    LDA #0 : STA h_dx
.ok
    RTS
die = column_blocked.die
}

\ StLift (&876D): state 8, riding the lift: its dy; crushed by a solid cell
\ at the head; walking off either end at xf 2.
.st_lift
{
    LDA l_dy : STA h_dy
    LDY #0 : LDA (hptr),Y : LSR A : BCS column_blocked.die
    LDA h_xf : CMP #2 : BNE walk
    LDA l_cell : AND #31
    LDX h_dx : BEQ walk
    BMI going_left
    ADC l_width                     ; going right: its last column (C set:
                                    ;  the CMP; no carry, so SBC takes 2)
.going_left
    SBC #1                          ; going left: the column left of it
                                    ;  (C set: the CMP)
    EOR h_cell : AND #31 : BNE walk ; his column? (Those columns are 6-24:
                                    ;  lift_col, and widths 2 and 7.)
    \ Off the end: falling, through the vertical collisions.
    LDA #0 : STA h_state : STA h_cnt
    INC h_fall                      ; 1 (riding, h_fall is 0: harry_update)
    JMP vcollide
.walk
    LDA h_dx : BEQ facing
    AND #4 : STA h_face             ; (dx is 1 or -1: face 0 or 4)
.facing
    LDA #2 : STA vB
    LDA hptr : LDX hptr+1
    LDY h_face : CPY #1             ; C clear: face 0, right
    JMP ladder_grab.lift_walk
}

\ StRope (&8249): state 4. Ropes only slide: 1, 2 or 3 pixels a pass.
.st_rope
{
    LDA h_dy : CMP #&80 : ROR A     ; dy / 2, signed (C clear: dy is even)
    SBC #1 : STA h_dy               ; - 2
    CMP #&FF : BNE st_ladder
    LDA h_yf : AND #3 : STA h_xf    ; the hand-over-hand frames, holding up
    \ Fall into st_ladder.
}
\ StLadder (&81BA): state 3 (and 4 from above).
.st_ladder
{
    LDA h_yf : BNE on
    LDA h_dx : BEQ on
    LDY #&40 : LDA (hptr),Y : AND #&21 : BEQ on
    \ A floor under the feet: step off, and walk this same pass (st_walk
    \ sets the facing, dx not being 0).
    LDY #0 : STY h_dy : STY h_xf
    INY
    LSR A : BCS walk                ; a floor: walking (1); a pipe: 2
    INY
.walk
    STY h_state
    BPL st_walk                     ; (always: LSR and INY leave N clear)
.on
    LDA #0 : STA h_dx               ; (for rope_tail too)
    CPX #4 : BEQ rope_tail          ; (X = h_state, from the dispatch)
    LDA h_yf : LSR A : STA h_xf     ; the climbing frame
    LDA h_dy : BEQ go
    BPL up
    LDY #&40 : LDA (hptr),Y : AND #2 : BNE go       ; ladder below
    BEQ stop                                        ; (always)
.up
    LDY h_yf : BNE go
    LDA (hptr),Y : AND #2 : BEQ stop                ; head cell not ladder
    LDA (hptr_up),Y                                 ; the cell above it
    TAX : AND #&2D : BEQ go
    TXA : AND #2 : BNE go
.stop
    STA h_dy                        ; (A = 0)
    BEQ go                          ; (always)
go = st_walk.go
}

\ RopeTail (&8262)
.rope_tail
{
    LDX h_yf : CPX #5 : BCC st_walk.go
    LDY #&60 : LDA (hptr),Y : AND #&10 : BNE st_walk.go    ; rope below the feet
    TXA : SBC #8 : STA h_dy         ; yf - 8 (C set: the CPX)
    INC h_fall                      ; 1 (it was 0: harry_update), then
    LDA #0 : STA h_state : STA h_xf ;  FallCount's INC; dx is 0 (st_ladder),
    BEQ fall_count                  ;  so on to vcollide (always)
}

\ StPipe (&81B0): state 2, a slippery pipe holds Harry only while he walks.
.st_pipe
    LDA h_dx : BEQ walk_off
    \ Fall into st_walk.

\ StWalk (&8113): state 1, on a platform.
.st_walk
{
    LDA h_dx : BEQ facing
    AND #4 : STA h_face             ; (dx is 1 or -1: face 0 or 4)
.facing
    LDA h_xf : BNE walk_mid
    LDY #0                          ; up: the head cell
    LDA h_dy : BEQ walls
    BPL up
    LDY #&40                        ; down: under the feet
.up
    LDA (hptr),Y : AND #&12 : BNE start_climb
    STA h_dy                        ; (A = 0)
.walls
    LDA h_dx : BEQ go
    JSR wall_check
.go
    JMP move
\ StartClimb (&8143)
.start_climb
    LDX #3 : CMP #2 : BEQ ladder
    INX
.ladder
    STX h_state
    LDA #8 : STA h_face
    LDA #0 : STA h_dx
    BEQ go                          ; (always)
}

\ WalkMid (&8172): walking, between cells.
.walk_mid
{
    LDA #0 : STA h_dy
    LDA h_xf : CMP #2 : BNE go
    LDA h_dx : BEQ go
    ADC #0 : LSR A                  ; (C set: the CMP) 1 going right, 0 left
    ADC #&20 : TAY                  ; (C clear: the LSR)
    LDA (hptr),Y : AND #&0C : BEQ no_slope  ; a slope at leg height ahead
    LDA #5 : STA h_state
    LDA h_dx : STA h_mom
    LDA #2 : STA h_dy
    BNE go                          ; (always)
.no_slope
    TYA : ADC #&20 : TAY            ; (C clear) a row down
    LDA (hptr),Y : AND #&21 : BNE go        ; a floor ahead
go = st_walk.go
    \ Fall into walk_off.
}

\ WalkOff (&829A): one 4 x 4 step off the edge, then a fall. (Walking or
\ on a pipe: h_fall is 0, from harry_update.)
.walk_off
    STA h_cnt : STA h_state         ; (A = 0: st_pipe's dx, walk_mid's floor)
    ASL h_dx
.fall_dy
    LDA #&FC : STA h_dy
\ FallCount (&82BA)
.fall_count
    INC h_fall
    LDA h_dx : BNE st_walk.go
    JMP vcollide

\ StSlopeUp (&86EF): state 5, climbing only while the uphill key is held.
.st_slope_up
{
    LDA h_mom : CMP h_dx : BEQ uphill
.reverse
    EOR #&FE : STA h_mom : STA h_dx ; -mom (mom is 1 or -1 on a slope)
    LDA #&FE : STA h_dy
    INX : STX h_state               ; 6 (X = 5: the dispatch, or wall_check)
.go
    JMP move
.uphill
    LDA #2 : STA h_dy
    LDA h_xf : BNE go
    \ Fall into slope_aligned.
}
\ SlopeAligned (&871B)
.slope_aligned
{
    LDY #&40 : LDA (hptr),Y : AND #&2D : BNE supported
    JMP st_fall
.supported
    JSR wall_check                  ; (it keeps X = h_state)
    CPX #5 : BEQ st_slope_up.go
    BNE slope_end                   ; (always)
}
\ StSlide (&873A): state 6.
.st_slide
    LDA h_mom : STA h_dx
    LDA #&FE : STA h_dy
    LDA h_xf : BEQ slope_aligned
\ SlopeEnd (&874B)
.slope_end
{
    LDA h_yf : BNE go
    LDY #&40 : LDX h_mom : BMI left ; T(&40), or T(&41) going right
    INY                             ; (mom is 1 or -1 on a slope)
.left
    LDA (hptr),Y : AND #&21 : BEQ go        ; (SetStanding ANDs again)
    JSR set_standing
    LDA #0 : STA h_dy
    BEQ go                          ; (always)
go = st_slope_up.go
}

\ SetStanding (&87FD): type A under the feet decides walking or pipe.
.set_standing
{
    AND #&21
    CMP #1 : BEQ set                ; a floor: walking (1)
    CMP #&20 : BNE done             ; a pipe: 2
    LDA #2
.set
    STA h_state
.done
    RTS
}

\ h_cell += A, signed.
.add_cell
{
    LDX #0
    CMP #&80 : BCC positive
    DEX
.positive
    CLC : ADC h_cell : STA h_cell
    TXA : ADC h_cell+1 : STA h_cell+1
    RTS
}

\ (The jump arc, jump_arc, is in page 1: pages.6502.)
