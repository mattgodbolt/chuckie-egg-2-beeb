\ ***************************************************************************
\ The interrupt handler. It owns IRQ1V outright (after the port kit's
\ lib/irq.6502): nothing goes to the OS, so the OS's 100Hz tick, sound and
\ keyboard interrupt stop, and its sound workspace at &0800 stays still.
\
\ Two sources: VSync (System VIA CA1) and the User VIA's T1, which splits
\ the palette between the status bar (rows 0-1) and the room (rows 2-23).
\
\ In MODE 1 a palette entry is picked by more than the pixel's own colour.
\ The ULA forms the entry number from bits 7, 5, 3 and 1 of a shift
\ register that moves one bit a pixel, so (byte bits 7-0 = p0h p1h p2h p3h
\ p0l p1l p2l p3l) entry bits 2 and 0 come from the pixel two to the right
\ for p0 and p1, and from one low bit of the pixel two to the left plus a
\ 1 shifted in for p2 and p3. Write the entry as l1 n1 l0 n0 with n the
\ "neighbour": the status bar, colours 0 and 1 only, shows logical 0 and 1
\ beside neighbours 0, 1 and 3, never 2. Six entries. At VSync those six
\ get the status bar's colours and the other ten the room's; when T1 fires,
\ just before row 2, the six get the room's: 24us of writes in the 32us
\ horizontal blank (timing measured in docs/journal.md).
\ ***************************************************************************

ZA_AUTO1 vsyncs             ; frames since start-up

\ The status bar's colours: logical 0 and 1 (black, white).
STATUS_COLOURS = {STATUS_PAPER, 7}

\ The &FE21 value for logical colour l beside logical colour n, showing
\ physical colour phys.
FUNCTION ula_entry(l, n, phys) = ((l AND 2) * 4 + (n AND 2) * 2 + (l AND 1) * 2 + (n AND 1)) * 16 + (phys EOR 7)

\ The room's sixteen values (set_room_palette fills them): the ten the
\ status bar never shows first, then the six it does, which T1 writes.
.room_ula   SKIP 16
\ The status bar's six: logical 1, then 0, each beside 0, 1 and 3.
.status_ula
    FOR l = {1, 0}
        FOR n = {0, 1, 3}
            EQUB ula_entry(l, n, STATUS_COLOURS[l])
        NEXT
    NEXT

.irq_handler
{
    ZA_INTERRUPT
    TXA : PHA
    LDA usrvia_ifr : AND #&40 : BEQ not_t1
    LDA usrvia_t1cl             ; acknowledge
    FOR i = 10..15
        LDA room_ula + i : STA ula_pal
    NEXT
    JMP done
.not_t1
    LDA sysvia_ifr : AND #2 : BEQ done
    STA sysvia_ifr              ; acknowledge
    INC vsyncs
    LDA #LO(SPLIT_T1) : STA usrvia_t1cl
    LDA #HI(SPLIT_T1) : STA usrvia_t1ch     ; starts the count
    LDX #9
.room_entries
    LDA room_ula,X : STA ula_pal
    DEX : BPL room_entries
    LDX #5
.status
    LDA status_ula,X : STA ula_pal
    DEX : BPL status
.done
    PLA : TAX
    LDA &FC                     ; the interrupted A, saved by the OS
    RTI
}

\ Put irq_handler on IRQ1V: VSync and User VIA T1 (one-shot) only.
.install_irq
{
    SEI
    LDA #&7F : STA sysvia_ier : STA usrvia_ier  ; anything we don't service
                                                ; would hold IRQ asserted
    LDA #LO(irq_handler) : STA irq1v
    LDA #HI(irq_handler) : STA irq1v+1
    LDA usrvia_acr : AND #&3F : STA usrvia_acr  ; T1 one-shot
    LDA #&82 : STA sysvia_ier                   ; CA1: VSync
    LDA #&C0 : STA usrvia_ier                   ; T1
    CLI
    RTS
}

\ Wait for the next vsync.
.wait_vsync
{
    LDA vsyncs
.wait
    CMP vsyncs : BEQ wait
    RTS
}
