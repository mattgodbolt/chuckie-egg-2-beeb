\ ***************************************************************************
\ Machines: the truck, the train and the lifts (&8EE8-&9189;
\ docs/research/monsters.md section 6). The truck and the train are strips,
\ one cell wide, painted over the cells (not ORed on) and repaired by
\ repainting; the lifts are sprites, moved and redrawn once a pass.
\ ***************************************************************************

\ (noise is in monsters.6502, falling into rng.)

\ `cell` a row down; C clear. (Also collide's.)
.cell_down
{
    CLC : LDA cell : ADC #32 : STA cell
    BCC done
    INC cell+1 : CLC
.done
    RTS
}

\ Repaint X cells down from row A, column Y from the maps (&8FA5).
.restore_cells
{
    STX rc_b
    JSR row_col_cell
    STA cell : STY cell+1
.loop
    JSR cell_looks
    JSR draw_glyph_pd
    JSR cell_down
    DEC rc_b : BNE loop
    RTS
}

\ The truck backing in at the start of every egg (&9028): 14 steps, ten
\ frames each, the last few strips of either set from the left edge.
.truck_arrives
{
    LDA #14 : STA ta_b
.step
    LDA #16 : SEC : SBC ta_b : LSR A : STA ds_b   ; strips showing
    LDA #&83 : BCS shifted
    LDA #&8A + 1                                  ; the aligned set (C clear: - 1)
.shifted
    SBC ds_b : STA ds_c
    LDX #0 : JSR truck_strips                     ; (room 1)
    JSR wait10 : BNE step
    RTS
}

\ Ten frames (&904E), and a step of the truck's done: Z set after the last.
.wait10
{
    LDA #10 : STA w10_n
.loop
    JSR wait_vsync
    DEC w10_n : BNE loop
    DEC ta_b
    RTS
}

\ The truck driving off with the egg (&9059), the cells behind it repainted.
.truck_leaves
{
    LDA #14 : STA ta_b
.step
    LDA ta_b : LSR A : STA ds_b : PHP
    LDA #&8A + 1 : BCC aligned      ; (C clear: - 1)
    LDA #&83
.aligned
    SBC ds_b : STA ds_c
    LDX #0 : STX ds_d               ; (none drawn: column 0 to repaint)
    LDA ds_b : BEQ none
    JSR truck_strips                ; (room 111; ds_d steps on to ds_b)
.none
    PLP : BCC no_restore
    \ An odd step: the column just left behind, rows 17-23.
    LDY ds_d : LDA #&11 : LDX #7 : JSR restore_cells
.no_restore
    JSR wait10 : BNE step
    RTS
}

\ The truck, drawn on entering room 1 or 111 (&9011): strips &7C-&82 at
\ columns 0-6, row 16 (room 1) or 17 (room 111).
.truck_draw
    LDX #0
    LDA #7 : STA ds_b
    LDA #&7C : STA ds_c
    BNE truck_strips                ; (always)

\ The machines, once a pass (&8EE8): the train moves with the power on, and
\ is drawn in its room, the front poking into the next; or the truck
\ repaired.
.machines
{
    LDA #0 : STA noise_flag
    LDA factory : LSR A : BCC still ; no power
    LDA train_pos : ADC #0 : AND #63 : STA train_pos   ; (carry set) + 1
    BNE still
    LDX train_room : INX : CPX #81 : BNE set_room
    LDX #71
.set_room
    STX train_room
.still
    LDA room : CMP #1 : BEQ truck_refresh
    CMP #111 : BNE train
    \ Fall into truck_refresh.
}

\ Every pass in those rooms (&8FED): one strip repainted, in turn.
.truck_refresh
{
    LDX truck_strip : INX : CPX #7 : BCC ok
    LDX #0
.ok
    STX truck_strip
    TXA : CLC : ADC #&7C : STA ds_c
    LDA #1 : STA ds_b
    \ Fall into truck_strips.
}

\ Truck strips C.. (B of them) from column X, in yellow, at the truck's
\ row in this room: 16 in room 1, 17 in room 111.
.truck_strips
    STX ds_d
    LDA room : CMP #2 : LDA #16 : ADC #0 : STA ds_e    ; (C: room 111)
    LDA #6
    \ Fall into draw_strips.

\ Paint strip frames C, C+1, ... (B of them) from column D, row E, a column
\ each, in Spectrum colour A (&8FC1, &7F4F): each strip copied over the
\ cells, its set pixels in the colour and the rest in the cell's paper.
.draw_strips
{
    STA ds_ink
.strip
    \ glyph 8 before the strip's first cell (its header + 2), and on 8
    \ before each: the header is at glyph + 6.
    LDA ds_c : JSR sprite_frame
    SEC : SBC #6 : STA glyph
    BCS no_borrow
    DEX
.no_borrow
    STX glyph+1
    LDY #6 : LDA (glyph),Y : STA ds_rows
    LDY ds_d : LDA ds_e : JSR row_col_cell
    STA cell : STY cell+1
.cell_loop
    CLC : LDA glyph : ADC #8 : STA glyph
    BCC paper_ink
    INC glyph+1
.paper_ink
    \ The paper from the attribute map, the ink the strip's: an attribute.
    \ (attr_map + cell: its page patched in, as cell_colours does)
    LDA cell+1 : ORA #HI(attr_map) : STA map+2    ; (cell+1 is 0-2)
    LDY cell
.map
    LDA attr_map,Y
    AND #&38 : ORA ds_ink
    JSR draw_glyph
    JSR cell_down
    DEC ds_rows : BNE cell_loop
    INC ds_d : INC ds_c
    DEC ds_b : BNE strip
.done
    RTS
}
ASSERT LO(attr_map) = 0 AND (HI(attr_map) AND 3) = 0  ; (the ORA adds)

\ The train (machines, A = room): in this room, or just gone, or poking in.
.train
{
    CMP train_room : BEQ here
    \ Just left this room: repaint column 31, rows 5-7.
    LDA train_pos : BEQ before
    LDX room : INX : CPX #81 : BNE next_ok
    LDX #71
.next_ok
    CPX train_room : BNE before
    LDY #31 : LDA #5 : LDX #3 : JMP restore_cells
.before
    \ The front poking in from the room before.
    LDX room : DEX : CPX #80 : BEQ done
    CPX #70 : BNE prev_ok
    LDX #80
.prev_ok
    CPX train_room : BNE done
    LDA train_pos : CMP #&37 : BCC done
    SBC #&35 : LSR A : STA ds_b                     ; (carry set)
    LDA #&4C + 1 : BCC parity       ; (C clear: - 1)
    LDA #&51
.parity
    SBC ds_b : STA ds_c
    LDA #0 : STA ds_d
    BEQ draw_train                  ; (always)
.here
    LDA train_pos : LSR A : STA ds_d
    LDA #&47 : BCC aligned
    LDA #&4C
.aligned
    STA ds_c
    LDA #32 : SEC : SBC ds_d : CMP #5 : BCC few
    LDA #5
.few
    STA ds_b
    \ Fall into draw_train.
done = draw_strips.done             ; (its RTS)
}
\ (&8F7F) The column before the train repainted, then its strips at row 5
\ in cyan; with the power on, the noise.
.draw_train
{
    LDA #5 : STA ds_e
    LDY ds_d : BEQ paint
    DEY : LDX #3 : JSR restore_cells    ; (A = 5: row 5)
.paint
    LDA #5 : JSR draw_strips
    LDA factory : AND #1 : STA noise_flag   ; with the power on
    JMP noise
}

\ The lifts (&9090, table &90E0): room, row, column (the type: setup_lift).
.lift_room EQUB 26, 55, 34, 104
.lift_row  EQUB 23, 23, 4, 4
.lift_col  EQUB 7, 23, 15, 17

\ SetupLift (&9088), on entering a room.
.setup_lift
{
    LDX #3
.find
    LDA lift_room,X : CMP room : BEQ found
    DEX : BPL find
    INX : STX l_type                ; (X = 0) none
    RTS
.found
    LDA lift_col,X : STA l_scol
    LDY lift_row,X : STY l_srow
    \ The type (&90E0's fourth column): 1 for the first two, 2 for the rest.
    LDA #1 : CPX #2 : BCC placed
    LDA factory : LSR A : BCS type2
    INY                             ; type 2: a row lower without power
.type2
    LDA #2
.placed
    STA l_type
    TYA : JSR lift_at
    STA l_dy                        ; (lift_at leaves A = 0)
.frame                              ; (and resume_room: game.6502)
    LDA l_type : CLC : ADC #&95 : JSR sprite_frame
    STA l_frame : STX l_frame+1
    LDY #1 : LDA (l_frame),Y : AND #15 : STA l_width   ; (the header's other bits: sprite.6502)
    RTS
}

\ The lift to row A, its start column, its top line; A = 0.
.lift_at
    LDY l_scol : JSR row_col_cell
    STA l_cell : STY l_cell+1
    LDA #0 : STA l_yf
.lift_none
    RTS

\ RunLift (&90F0), once a pass: move, erase, draw.
.run_lift
{
    LDA l_type : BEQ lift_none
    \ l_ocell .. l_oframe := l_cell .. l_frame, for the erase.
    LDX #4
.save_old
    LDA l_cell,X : STA l_ocell,X
    DEX : BPL save_old
    LDA factory : LSR A : BCC stop  ; no power
    LDA #2 : STA l_dy               ; up 2, unless ridden
    LDA l_type : LSR A : BCC type2
    \ Type 1: up 2 a pass; at row 3, aligned, back to the start.
    LDA l_yf : BNE go
    LDA l_cell+1 : BNE go           ; rows 8 and up
    LDA l_cell : BMI go             ; rows 4-7 go on; rows 0-3 is the top
    LDA l_srow : JSR lift_at
    BEQ step                        ; (always)
.type2
    LDA h_state : CMP #8 : BNE not_ridden
    \ Ridden: down 2, until row 23 or anything but bit 5 below it.
    LDA #&FE : STA l_dy
    LDA l_yf : BNE go
    LDA l_cell+1 : CMP #2 : BNE below
    LDA l_cell : CMP #LO(23 * 32) : BCS stop
.below
    \ (C clear: the CMP #2 met a high byte of 0 or 1, or the BCS fell through.)
    LDA l_cell : ADC #32 : STA lp
    LDA l_cell+1 : ADC #HI(type_map) : STA lp+1
    LDY #6
.cells
    LDA (lp),Y : AND #&DF : BNE stop
    DEY : BPL cells
    BMI go                          ; (always)
.not_ridden
    \ Not ridden: up 2 until its top is in row 4.
    LDA l_cell+1 : BNE go
    LDA l_cell : CMP #5 * 32 : BCS go
.stop
    LDA #0 : STA l_dy
.go
.step
    \ Down or up dy lines (the original's &8E94, across 0).
    LDA l_yf : SEC : SBC l_dy : TAX
    AND #7 : STA l_yf
    TXA : BMI up
    CMP #8 : BCC moved
    LDA l_cell : ADC #31 : STA l_cell              ; (carry set) + 32
    BCC moved
    INC l_cell+1
    BCS moved                       ; (always)
.up
    LDA l_cell : SBC #31 : STA l_cell              ; (carry clear: a borrow) - 32
    BCS moved
    DEC l_cell+1
.moved
    \ Erase where it was (&7FC9), draw where it is (&8063), yellow.
    LDX #l_ocell : JSR sp_erase_at
    LDA #6 : LDX #l_cell : JMP sp_draw_ink
}
ZA_AUTO2 lp
