\ ***************************************************************************
\ CHUCKIE EGG 2 for the BBC Micro - build file
\
\ !BOOT selects MODE 1 and *RUNs CE2, which loads at &1900, selects *TAPE so
\ the DFS lets go of its workspace, copies the program down to &0E00 and
\ runs it. For now the program is the room viewer (viewer.6502).
\ ***************************************************************************

INCLUDE "defs.6502"
INCLUDE "memory.6502"

\ The palette split (irq.6502): T1 is started in the VSync interrupt and
\ fires in the last scanline of row 1, so that its last four writes (logical
\ colour 0) land in the horizontal blank before row 2. Measured on jsbeeb,
\ see docs/journal.md.
SPLIT_T1 = 83 * SL - 2 + 46
STATUS_PAPER = 0            ; black (1, red, shows where the split lands)

\ MODE 1 is selected by BASIC before the program loads: the program reaches
\ past &3000 once copied down, so a MODE change after that would wipe it.
\ The palette is blacked out so nobody sees the file pass through screen
\ memory on its way in.
SECTION Boot, filename = "!BOOT", exec = &FFFFFFFF
    EQUS "*| CHUCKIE EGG 2", 13
    EQUS "MODE 1", 13
    EQUS "FOR I%=0 TO 3:VDU 19,I%,0;0;:NEXT", 13
    EQUS "*RUN CE2", 13
ENDSECTION

SECTION Loader, org = &1900, load = &FFFF1900, exec = &FFFF0000 + loader, filename = "CE2"
.payload
    SECTION Code, org = &0E00, guard = screen
    ZA_POOL &00..&8F

.start
{
    ZA_ENTRY
    LDX #&FF : TXS
    JSR init_system
    JMP viewer
}

    INCLUDE "system.6502"
    INCLUDE "irq.6502"
    INCLUDE "screen.6502"
    INCLUDE "rooms.6502"
    INCLUDE "unpack.6502"
    INCLUDE "viewer.6502"

    \ Data from the original: extracted by tools/mkrooms.py, the rooms
    \ packed by tools/packrooms.py (decision 5).
    INCLUDE "data/rooms.6502"
    INCLUDE "data/packed.6502"
.packed_rooms
    INCBIN "data/packed.bin"
.tiles
    INCBIN "data/tiles.bin"
.room_buffer
    SKIP ROOM_BUFFER_SIZE

    .code_end
    PRINT "code &", ~start, "-&", ~code_end, " (", screen - code_end, " bytes free)"
    ENDSECTION

\ Runs from where the file loaded, after the payload; nothing in here is
\ needed afterwards.
.loader
    LDX #LO(tape) : LDY #HI(tape) : JSR oscli
    LDX #HI(code_end - start + &FF)
    LDY #0
.copy
    LDA payload,Y : STA start,Y
    INY : BNE copy
    INC copy+2 : INC copy+5
    DEX : BNE copy
    JMP start
.tape
    EQUS "TAPE", 13
ENDSECTION
