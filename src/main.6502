\ ***************************************************************************
\ CHUCKIE EGG 2 for the BBC Micro - build file
\
\ !BOOT runs MENU, the front end (menu.6502), which puts CE2DATA in a
\ sideways RAM bank and runs CE2: it loads at &1900, copies the program
\ down to &0E00 and runs it. The game comes back to MENU by resetting the machine (state.6502).
\ ***************************************************************************

INCLUDE "defs.6502"
INCLUDE "memory.6502"

DATA_MAGIC = "CE2DATA"

\ The palette split (irq.6502): T1 is started in the VSync interrupt and
\ fires in the last scanline of row 1, so that its last four writes (logical
\ colour 0) land in the horizontal blank before row 2. Measured on jsbeeb,
\ see docs/journal.md.
\ (-D SPLIT_SWEEP=n overrides it, to measure the window.)
IF DEFINED(SPLIT_SWEEP)
    SPLIT_ADJ = SPLIT_SWEEP
ELSE
    SPLIT_ADJ = 96              ; the middle of 84-108, the window that works
ENDIF
SPLIT_T1 = 83 * SL - 2 + SPLIT_ADJ
STATUS_PAPER = 0            ; black (1, red, shows where the split lands)

\ The build stamp comes from the Makefile (-D BUILD="date time sha"), so a
\ disc says what it is: *TYPE !BOOT and MENU's bottom line show it. A + after
\ the sha means the tree had uncommitted changes.
IF DEFINED(BUILD)
    build_stamp = BUILD
ELSE
    build_stamp = "DEV"
ENDIF

SECTION Boot, filename = "!BOOT", exec = &FFFFFFFF
    EQUS "*| CHUCKIE EGG 2 ", build_stamp, 13
    EQUS "*RUN MENU", 13
ENDSECTION

\ The front end, in MODE 7 (decision 13). It must end below &3000, where it
\ loads CE2DATA to copy into the bank.
SECTION Menu, org = &1900, load = &FFFF1900, exec = &FFFF0000 + menu, filename = "MENU"
    INCLUDE "menu.6502"
    INCLUDE "data/front.6502"
    ASSERT P% <= &3000
ENDSECTION

SECTION Data, org = &8000, load = &FFFF3000, filename = "CE2DATA", guard = &C000
.data_magic
    EQUS DATA_MAGIC, build_stamp    ; MENU loads it again if the build differs
    INCLUDE "state.6502"
    \ The rooms, packed by tools/packrooms.py (decision 5).
.packed_rooms
    INCBIN "data/packed.bin"
    INCLUDE "data/packed.6502"
    \ The original's sprites: Harry, monsters, truck, train, lifts.
.sprites
    INCBIN "data/sprites.bin"
    \ The OS's font, characters 32-95 (nothing prints beyond Z), copied in
    \ at start-up (decision 4): read through OSWORD 10, so it is the
    \ machine's own on a B or a Master.
.text_font
    SKIP 64 * 8
.data_end
    PRINT "sideways data &8000-&", ~data_end, " (", &C000 - data_end, " bytes free)"
ENDSECTION

SECTION Loader, org = &1900, load = &FFFF1900, exec = &FFFF0000 + loader, filename = "CE2"
.payload
    SECTION Code, org = &0E00, guard = screen
    ZA_POOL &00..ZP_FIXED-1    ; ZP_FIXED-&8F: the game's permanent state (memory.6502)

.start
{
    ZA_ENTRY
    LDX #&FF : TXS
    JSR find_data_bank
    JSR keep_os                 ; before the tables overwrite page 2
    JSR copy_font
    JSR init_system
    JSR copy_os_pages
    JSR sound_init
IF DEFINED(VIEWER)
    JMP viewer                  ; the room viewer, for tools/roomcheck.mjs
ELSE
    JMP init_game
ENDIF
}

    INCLUDE "system.6502"
    INCLUDE "swram.6502"
    INCLUDE "irq.6502"
    INCLUDE "screen.6502"
    INCLUDE "rooms.6502"
    INCLUDE "status.6502"
    INCLUDE "unpack.6502"
    INCLUDE "sprite.6502"
    INCLUDE "harry.6502"
    INCLUDE "monsters.6502"
    INCLUDE "collide.6502"
    INCLUDE "objects.6502"
    INCLUDE "machines.6502"
    INCLUDE "sound.6502"
    INCLUDE "handoff.6502"
    INCLUDE "game.6502"
IF DEFINED(VIEWER)
    INCLUDE "viewer.6502"
ENDIF

    \ Data from the original: extracted by tools/mkrooms.py, the rooms
    \ packed by tools/packrooms.py (decision 5).
    INCLUDE "data/rooms.6502"
    INCLUDE "data/gfx.6502"
.monster_table
    INCBIN "data/monsters.bin"
    INCLUDE "data/objects.6502"
.things
    INCBIN "data/things.bin"
.visits
    INCBIN "data/visits.bin"
.objgfx
    INCBIN "data/objgfx.bin"
.tiles
    INCBIN "data/tiles.bin"

    .code_end
    PRINT "code &", ~start, "-&", ~code_end, " (", screen - code_end, " bytes free)"
    ENDSECTION

    \ Constant tables for the OS's pages, which the game doesn't use once
    \ it has the interrupts and reads the keyboard itself: loaded after the
    \ code, copied into place by copy_os_pages, then overwritten by the
    \ screen. (&0200-&0235 are the vectors, IRQ1V among them; the stack
    \ keeps &0180-&01FF.)
.page1_load
    SECTION Page1, org = &0100, guard = &0180
.page1
.thing_init
    INCBIN "data/thinginit.bin"
.page1_end
    ENDSECTION
.page2_load
    SECTION Page2, org = &0236, guard = &0300
.page2
.thing_types
    INCBIN "data/thingtypes.bin"
.page2_end
    ENDSECTION
.page3_load
    SECTION Page3, org = &0300, guard = &0400
.page3
.mon_types
    INCBIN "data/montypes.bin"
.page3_end
    ENDSECTION
.payload_end

\ Runs from where the file loaded, after the payload; nothing in here is
\ needed afterwards. The DFS stays the filing system, though its workspace
\ is about to be overwritten: the game never calls it, and after the game's
\ reset (state.6502) the DFS must still be there to boot MENU. (With *TAPE
\ selected here, that reset came up in the cassette filing system.)
.loader
    LDX #HI(code_end - start + &FF)
    LDY #0
.copy_down
    LDA payload,Y : STA start,Y
    INY : BNE copy_down
    INC copy_down+2 : INC copy_down+5
    DEX : BNE copy_down
    JMP start
.loader_end
    ASSERT loader_end <= SAVE_HDR   ; the game's state above it survives the load
ENDSECTION
