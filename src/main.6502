\ ***************************************************************************
\ CHUCKIE EGG 2 for the BBC Micro - build file
\
\ !BOOT selects MODE 1 and *RUNs CE2, which loads at &1900, selects *TAPE so
\ the DFS lets go of its workspace, copies the program down to &0E00 and
\ runs it. For now the program is the room viewer (viewer.6502).
\ ***************************************************************************

INCLUDE "defs.6502"
INCLUDE "memory.6502"

DATA_MAGIC = "CE2DATA"

\ The palette split (irq.6502): T1 is started in the VSync interrupt and
\ fires in the last scanline of row 1, so that its last four writes (logical
\ colour 0) land in the horizontal blank before row 2. Measured on jsbeeb,
\ see docs/journal.md.
\ (-D SPLIT_SWEEP=n overrides it, to measure the window.)
IF DEFINED(SPLIT_SWEEP)
    SPLIT_ADJ = SPLIT_SWEEP
ELSE
    SPLIT_ADJ = 96              ; the middle of 84-108, the window that works
ENDIF
SPLIT_T1 = 83 * SL - 2 + SPLIT_ADJ
STATUS_PAPER = 0            ; black (1, red, shows where the split lands)

\ MODE 1 is selected by BASIC before the program loads: the program reaches
\ past &3000 once copied down, so a MODE change after that would wipe it.
\ The palette is blacked out so nobody sees the file pass through screen
\ memory on its way in.
\ The build stamp comes from the Makefile (-D BUILD="date time sha"), so a
\ disc says what it is: *TYPE !BOOT shows it. A + after the sha means the
\ tree had uncommitted changes.
IF DEFINED(BUILD)
    build_stamp = BUILD
ELSE
    build_stamp = "DEV"
ENDIF

SECTION Boot, filename = "!BOOT", exec = &FFFFFFFF
    EQUS "*| CHUCKIE EGG 2 ", build_stamp, 13
    EQUS "MODE 1", 13
    EQUS "FOR I%=0 TO 3:VDU 19,I%,0;0;:NEXT", 13
    EQUS "*RUN SWLOAD", 13
ENDSECTION

\ The data's sideways RAM bank (decision 8): SWLOAD puts CE2DATA in a free
\ one, then runs CE2, which finds it again by its magic (swram.6502).
SECTION SwLoad, org = &1900, load = &FFFF1900, exec = &FFFF0000 + swload, filename = "SWLOAD"
    INCLUDE "swload.6502"
ENDSECTION

SECTION Data, org = &8000, load = &FFFF3000, filename = "CE2DATA", guard = &C000
.data_magic
    EQUS DATA_MAGIC
    \ The rooms, packed by tools/packrooms.py (decision 5).
.packed_rooms
    INCBIN "data/packed.bin"
    \ The original's sprites: Harry, monsters, truck, train, lifts.
.sprites
    INCBIN "data/sprites.bin"
    \ The OS's font, characters 32-127, copied in at start-up (decision 4):
    \ read through OSWORD 10, so it is the machine's own on a B or a Master.
.text_font
    SKIP 96 * 8
.data_end
    PRINT "sideways data &8000-&", ~data_end, " (", &C000 - data_end, " bytes free)"
ENDSECTION

SECTION Loader, org = &1900, load = &FFFF1900, exec = &FFFF0000 + loader, filename = "CE2"
.payload
    SECTION Code, org = &0E00, guard = screen
    ZA_POOL &00..ZP_FIXED-1    ; ZP_FIXED-&8F: the game's permanent state (memory.6502)

.start
{
    ZA_ENTRY
    LDX #&FF : TXS
    JSR find_data_bank
    JSR copy_font
    JSR init_system
IF DEFINED(VIEWER)
    JMP viewer                  ; the room viewer, for tools/roomcheck.mjs
ELSE
    JMP init_game
ENDIF
}

    INCLUDE "system.6502"
    INCLUDE "swram.6502"
    INCLUDE "irq.6502"
    INCLUDE "screen.6502"
    INCLUDE "rooms.6502"
    INCLUDE "status.6502"
    INCLUDE "unpack.6502"
    INCLUDE "sprite.6502"
    INCLUDE "harry.6502"
    INCLUDE "monsters.6502"
    INCLUDE "collide.6502"
    INCLUDE "game.6502"
IF DEFINED(VIEWER)
    INCLUDE "viewer.6502"
ENDIF

    \ Data from the original: extracted by tools/mkrooms.py, the rooms
    \ packed by tools/packrooms.py (decision 5).
    INCLUDE "data/rooms.6502"
    INCLUDE "data/packed.6502"
    INCLUDE "data/gfx.6502"
.monster_table
    INCBIN "data/monsters.bin"
.tiles
    INCBIN "data/tiles.bin"
.room_buffer
    SKIP ROOM_BUFFER_SIZE

    .code_end
    PRINT "code &", ~start, "-&", ~code_end, " (", screen - code_end, " bytes free)"
    ENDSECTION

\ Runs from where the file loaded, after the payload; nothing in here is
\ needed afterwards.
.loader
    LDX #LO(tape) : LDY #HI(tape) : JSR oscli
    LDX #HI(code_end - start + &FF)
    LDY #0
.copy
    LDA payload,Y : STA start,Y
    INY : BNE copy
    INC copy+2 : INC copy+5
    DEX : BNE copy
    JMP start
.tape
    EQUS "TAPE", 13
ENDSECTION
