\ ***************************************************************************
\ CHUCKIE EGG 2 for the BBC Micro - build file
\
\ !BOOT runs MENU, the front end (menu.6502), which puts CE2DATA in a
\ sideways RAM bank and runs CE2: it loads at &1900, copies the program
\ down to &0E00 and runs it. The game comes back to MENU by resetting the machine (state.6502).
\ ***************************************************************************

INCLUDE "defs.6502"
INCLUDE "memory.6502"

DATA_MAGIC = "CE2DATA"

\ The palette split (irq.6502): T1 is started in the VSync interrupt and
\ fires in the last scanline of row 1, so that its last four writes (logical
\ colour 0) land in the horizontal blank before row 2. Measured on jsbeeb,
\ see docs/journal.md.
\ (-D SPLIT_SWEEP=n overrides it, to measure the window.)
IF DEFINED(SPLIT_SWEEP)
    SPLIT_ADJ = SPLIT_SWEEP
ELSE
    SPLIT_ADJ = 98              ; the middle of 86-110, the window that works
ENDIF
SPLIT_T1 = 83 * SL - 2 + SPLIT_ADJ
\ A band's split (bands.6502) fires this much later in its row than the
\ status bar's (microseconds; -D BAND_SWEEP=n to measure). Measured on
\ jsbeeb in room 48: clean from -20 to 4, a line early at -24 and late at 8
\ (docs/journal.md); -8 sits in the middle.
IF DEFINED(BAND_SWEEP)
    BAND_ADJ = BAND_SWEEP
ELSE
    BAND_ADJ = -4
ENDIF
STATUS_PAPER = 0            ; black (1, red, shows where the split lands)

\ The build stamp comes from the Makefile (-D BUILD="date time sha"), so a
\ disc says what it is: *TYPE !BOOT and MENU's bottom line show it. A + after
\ the sha means the tree had uncommitted changes.
IF DEFINED(BUILD)
    build_stamp = BUILD
ELSE
    build_stamp = "DEV"
ENDIF

\ The streaming edition's mailbox (memory.6502): CE2DATA's magic and
\ state.6502's mailbox up to mb_ram_end (not the high-score table,
\ decision 50), at the very top of main RAM.
MB_RAM_SIZE = 80
MB_STREAM = screen - LEN(DATA_MAGIC) - LEN(build_stamp) - MB_RAM_SIZE

\ Two editions from this file (docs/streaming.md): the sideways RAM
\ edition, as below; and with -D STREAM=1 the streaming edition's game,
\ CE2S, which reads the records from CE2DATA on the disc as it goes, for a
\ Model B with no sideways RAM. The disc has both: MENU runs the one that
\ suits the machine. (Both built with the same stamp, so CE2DATA's layout
\ is the same to both.)
IF NOT(DEFINED(STREAM))
SECTION Boot, filename = "!BOOT", exec = &FFFFFFFF
    EQUS "*| CHUCKIE EGG 2 ", build_stamp, 13
    EQUS "*RUN MENU", 13
ENDSECTION

\ The front end, in MODE 7 (decision 13). It must end below &3000, where it
\ loads CE2DATA to copy into the bank.
SECTION Menu, org = &1900, load = &FFFF1900, exec = &FFFF0000 + menu, filename = "MENU"
    INCLUDE "menu.6502"
    INCLUDE "data/front.6502"
    ASSERT P% <= &3000
ENDSECTION

\ The high-score table's file (decisions 38 and 50), on every disc, with
\ A&F's table to start with; MENU loads it into the mailbox's (state.6502).
\ Ten names of 10 characters, each followed by its score's 10 digits, most
\ significant first, two to a byte (the original's, &A56B, has a byte a
\ digit; only MENU reads it).
SECTION HiScores, org = M_TABLE, load = &FFFF0000 OR M_TABLE, exec = &FFFF0000 OR M_TABLE, filename = "CE2HI"
.hs_file
FOR n = 1..10
    EQUS "A&F......."
    EQUB 0, 0, 0, 0, 0
NEXT
HS_LEN = P% - hs_file
HS_ENTRY = HS_LEN / 10
ENDSECTION

SECTION Data, org = &8000, load = &FFFF3000, filename = "CE2DATA", guard = &C000
.data_magic
    EQUS DATA_MAGIC, build_stamp    ; MENU loads it again if the build differs
    INCLUDE "state.6502"
    \ The rooms and the sprites as records (tools/mkrecords.py): each
    \ room's body (its packed room, monsters and bands), then the graphics
    \ groups the bodies share. rooms.6502's room_load finds them.
.records
    ASSERT records = mailbox_end
    INCBIN "data/records.bin"
.data_end
    PRINT "sideways data &8000-&", ~data_end, " (", &C000 - data_end, " bytes free)"
ENDSECTION
ELSE
\ The streaming edition keeps CE2DATA's mailbox in main RAM (memory.6502).
SECTION MailboxRAM, org = MB_STREAM, guard = screen, virtual = TRUE
.data_magic
    EQUS DATA_MAGIC, build_stamp
    INCLUDE "state.6502"
ENDSECTION
\ Its rooms, each one record, are read from the disc as they're wanted
\ (disc.6502: MENU finds where CE2ROOM starts), never loaded whole. The
\ file is data/roomrecs.bin as it is, which tools/ssdmerge.py puts on the
\ disc (the Makefile).
ENDIF
\ What CE2S keeps of CE2DATA's start at MB_STREAM.
MB_RAM_LEN = mb_ram_end - data_magic
ASSERT mb_ram_end - mailbox = MB_RAM_SIZE

IF DEFINED(STREAM)
    LOADER_NAME = "CE2S"
    CODE_TOP = MB_STREAM
ELSE
    LOADER_NAME = "CE2"
    CODE_TOP = screen
ENDIF
SECTION Loader, org = &1900, load = &FFFF1900, exec = &FFFF0000 + loader, filename = LOADER_NAME
.payload
    SECTION Code, org = &0E00, guard = CODE_TOP
    ZA_POOL &00..ZP_FIXED-1    ; ZP_FIXED-&8E: the game's permanent state (memory.6502)

    \ The game starts in the loader (startup.6502), which is discarded.
.code_start
\ Logical colour 2's four &FE21 values for each of the room's palette
\ bands 1 and 2 (bands.6502). The interrupt reads band_ula - 1 + 2i,X for
\ X = 1 or 2: within one page, so no read takes the extra cycle that would
\ move the splits. First, where no saving in the code before it can make it
\ cross a page (and need a pad).
.band_ula   SKIP 8
    ASSERT HI(band_ula) = HI(band_ula + 7)
    INCLUDE "system.6502"
    INCLUDE "irq.6502"
    INCLUDE "screen.6502"
    INCLUDE "rooms.6502"
    INCLUDE "status.6502"
    INCLUDE "unpack.6502"
    INCLUDE "sprite.6502"
    INCLUDE "harry.6502"
    INCLUDE "monsters.6502"
    INCLUDE "collide.6502"
    INCLUDE "objects.6502"
    INCLUDE "machines.6502"
    INCLUDE "sound.6502"
    INCLUDE "handoff.6502"
    INCLUDE "game.6502"
IF DEFINED(STREAM)
    INCLUDE "disc.6502"
ENDIF
IF DEFINED(VIEWER)
    INCLUDE "viewer.6502"
ENDIF

    \ Data from the original (tools/mkrecords.py, tools/mkobjects.py,
    \ tools/mkrooms.py, tools/packrooms.py): what every room needs.
    INCLUDE "bands.6502"
    INCLUDE "data/records.6502"
IF NOT(DEFINED(STREAM))             ; (the streaming edition's are in its bodies)
    INCLUDE "data/bands.6502"
    INCLUDE "data/rooms.6502"       ; the palettes
ENDIF
    INCLUDE "data/packed.6502"      ; the unpacker's tables
\ The room's sprite frames' headers (the original's &91B7 has all 152:
\ monsters, truck, train, lifts): room_load notes each of its graphics
\ groups' first frame number, end and place in fr_lo and fr_hi, for
\ sprite.6502's sprite_frame. (rg_count is in zero page and rg_first in
\ LowState's spare bytes: memory.6502, and below.)
.rg_end     SKIP GROUPS_MAX
.rg_base    SKIP GROUPS_MAX
.fr_lo      SKIP FRAMES_MAX
.fr_hi      SKIP FRAMES_MAX
    \ Harry's frames, and the tile font.
.harry_gfx
    INCBIN "data/harry.bin"
.tiles
    \ (Codes &20-&5B. No room draws tiles &31 and &3B-&3D, whose bytes cell_glyph
    \ never reads, so they hold tables: tools/mkrooms.py writes the font in
    \ three parts around them. tools/roomcmp.py would show a room that drew
    \ one.)
    INCBIN "data/tiles1.bin"
    ASSERT P% = tiles + 8 * (&31 - &20)
\ (screen.6502's cell_glyph) The glyph addresses, by a code's top three
\ bits: 256 * those bits (their share of 8 * the code) plus the font less
\ 8 * its first code. Tiles start at &20; text, bit 7 set, at &A0 in the
\ OS's font (decision 4). (font_hi is in screen.6502.)
.font_lo
FOR x = 0..3
    EQUB LO(x * 256 - (x AND 1) + tiles - 8 * &20)
NEXT
FOR x = 4..7
    EQUB LO(x * 256 - (x AND 1) + text_font - 8 * &A0)
NEXT
    INCBIN "data/tiles2.bin"
    ASSERT P% = tiles + 8 * (&3B - &20)
\ (rooms.6502's draw_cmds) Commands 1-10's handlers, less one for the RTS,
\ from cmd_block's (the handlers in rooms.6502's order keep them under 256).
MACRO CMD_OFF h
    ASSERT h - cmd_block < 256
    EQUB h - cmd_block
ENDMACRO
.cmd_offs
    CMD_OFF cmd_block : CMD_OFF cmd_text
    CMD_OFF cmd_bend : CMD_OFF cmd_bend : CMD_OFF cmd_bend : CMD_OFF cmd_bend
    CMD_OFF cmd_hopper : CMD_OFF cmd_diag : CMD_OFF cmd_diag : CMD_OFF cmd_single
\ (objects.6502's drop) The hoppers' rooms: the toy parts' (basket &20),
\ the milk's, the cocoa's, the sugar's.
.hopper_rooms
    EQUB 95, 33, 51, 110
\ (status.6502's bit_at) Bit n's mask.
.bit_masks
    EQUB 1, 2, 4, 8, 16, 32, 64, 128
    \ (Room to spare in the holes, for another table.)
    ASSERT P% <= tiles + 8 * (&3E - &20)
    SKIP tiles + 8 * (&3E - &20) - P%
    INCBIN "data/tiles3.bin"
    ASSERT P% = tiles + 8 * (&5C - &20)
    INCLUDE "data/objects.6502"
\ The portable things' rooms, rows and columns (objects.6502: egg_init
\ sets them from thing_init), and a bit for each fixed thing, set while
\ it's out of the world.
.things     SKIP 3 * NPORT
T_OUT_LEN = (256 - NPORT + 7) DIV 8
.t_out      SKIP T_OUT_LEN
.visited    SKIP 16             ; a bit a room, its visit bonus taken (status.6502)
THINGS_LEN = P% - things        ; (a saved game's: pages.6502's state_regions)
\ The thing types' inks, kinds and graphics (objects.6502; tools/mkobjects.py),
\ TY_KEPT of them.
.thing_types
    EQUB TY_INK[0..TY_KEPT - 1], TY_KIND[0..TY_KEPT - 1], TY_GFX[0..TY_KEPT - TOY_TYPES - 1]
IF NOT(DEFINED(STREAM))             ; (the streaming edition's are in its bodies)
.mon_types
    INCBIN "data/montypes.bin"
ENDIF
\ The life-lost tune (sound.6502). Each note: the SN76489's N (125000 / f,
\ at its 4MHz clock), and its length in 4ms steps (measured from the
\ original: frontend.md 7.3).
MACRO NOTE n, ms
    EQUB &80 OR (n AND 15), n DIV 16, (ms + 2) DIV 4
ENDMACRO
.death_notes
    NOTE 638, 202 : NOTE 569, 102 : NOTE 638, 202 : NOTE 715, 100
    NOTE 757, 203 : NOTE 951, 103 : NOTE 848, 200 : NOTE 1007, 101
    NOTE 951, 598
    NOTE 641, 33 : NOTE 848, 51 : NOTE 757, 52 : NOTE 715, 54
    NOTE 638, 54 : NOTE 508, 51 : NOTE 480, 52
.death_notes_end
\ This room's palette bands (bands.6502), set when the room is drawn. Out
\ of LowState so that &0D9F-&0DEF, a Master's extended vectors, survive a
\ BREAK (decision 22). (band_ula is at code_start, band_t1 in zero page.)
.band_cmaps SKIP 24             ; band k's colour map at 8k (band 0 = the room's)
.band_off   SKIP 32             ; for each screen row (and a little beyond), 8 * its band
.objgfx
    INCBIN "data/objgfx.bin"
IF NOT(DEFINED(STREAM))             ; (the streaming edition's are in its records)
    INCBIN "data/fixgfx.bin"        ; what only fixed things show
ENDIF

    .code_end
    PRINT "code &", ~code_start, "-&", ~code_end, " (", CODE_TOP - code_end, " bytes free)"
    ENDSECTION
IF DEFINED(STREAM)
    \ The streaming edition's cache (disc.6502), up to the mailbox: not in
    \ the file (stream_init sets it up).
    SECTION Cache, org = code_end, guard = CODE_TOP, virtual = TRUE
    NI = 6                      ; rooms at most
    \ (it_id to it_use in this order: disc.6502's arrange swaps them.)
.it_id      SKIP NI             ; the room - 1
.it_lo      SKIP NI             ; where
.it_hi      SKIP NI
.it_use     SKIP NI             ; the visit (epoch) that last used it
.arena
    SKIP CODE_TOP - P%
.arena_end
    PRINT "the cache's arena: ", arena_end - arena, " bytes"
    ASSERT arena_end - arena >= ROOM_MAX
    ENDSECTION
ENDIF

    \ What the game needn't save, in LowState's spare bytes (memory.6502),
    \ out of main RAM.
    SECTION LowSpare, org = low_state_end, guard = &0D9F, virtual = TRUE
.rg_first   SKIP GROUPS_MAX     ; (rooms.6502's room_load; rg_end and the rest: above)
IF DEFINED(STREAM)
.fx_gfx     SKIP 2              ; (room_load: the graphics only the room's fixed things show)
.nr_rooms   SKIP 4              ; (disc.6502's prefetch: the room's neighbours' ids)
ENDIF
    ENDSECTION

    \ Constant tables for the OS's pages 1-3.
IF DEFINED(STREAM)
    \ (Above where stream_init puts the mailbox back over the loaded file:
    \ the file padded up to there if the code ends before it.)
    IF P% < MB_STREAM + MB_RAM_LEN
        SKIP MB_STREAM + MB_RAM_LEN - P%
    ENDIF
ENDIF
    INCLUDE "pages.6502"
.payload_end

\ Runs from where the file loaded, after the payload; nothing in here is
\ needed afterwards. The DFS stays the filing system, though its workspace
\ is about to be overwritten: the game never calls it, and after the game's
\ reset (state.6502) the DFS must still be there to boot MENU. (With *TAPE
\ selected here, that reset came up in the cassette filing system.)
.loader
    LDA #229 : LDX #1 : LDY #0 : JSR osbyte    ; ESCAPE is an ordinary key
    LDA #0 : LDX #1 : JSR osbyte                ; X = the MOS's version
    STX loader_os
    LDX #HI(code_end - code_start + &FF)
    LDY #0
.copy_down
    LDA payload,Y : STA code_start,Y
    INY : BNE copy_down
    INC copy_down+2 : INC copy_down+5
    DEX : BNE copy_down
    LDA loader_os : CMP #3 : BCC model_b
    JSR master_setup
.model_b
    SEI                         ; the interrupts stay off until install_irq
    \ Fall into start.
    INCLUDE "startup.6502"
.loader_os EQUB 0

\ A Master (MOS 3.20 or later): its font isn't at &C000, so put one there,
\ in HAZEL (the 8K of RAM that pages over the MOS's &C000-&DFFF with
\ ACCCON bit 3), and leave HAZEL paged in for the game. Its reset needs
\ more of OS pages 2 and 3 than OS 1.20's (the ROM table, the EXEC and
\ SPOOL handles, the screen mode), so keep them in HAZEL too, and point
\ the game's reset at master_reset, which puts them back first.
MS_C    = &70
MS_P    = &71
\ Screen memory, unseen in MODE 7: above this loader and the page tables
\ (copy_os_pages wants them after) and the game's state block (SAVE_HDR up),
\ below MODE 7's screen.
FONT_BUF = &7800
ASSERT FONT_BUF >= loader_end AND FONT_BUF + &300 <= &7C00
M_PAGE2 = &D000
M_PAGE3 = &D100
M_D0    = &D200
M_RESET = &D210
M_HAZEL = &D300                 ; what the font displaces (the DFS's catalogue)
M_PAGED = &D600                 ; page &0D: the extended vectors, under LowState
.master_setup
{
    \ Characters 127 down to 32 through OSWORD 10: each call's block starts
    \ a byte early, on the last row of the character below, read later.
    LDA #127 : STA MS_C
.char
    LDA MS_C : SEC : SBC #32 : STA MS_P : LDA #0 : STA MS_P+1
    ASL MS_P : ROL MS_P+1 : ASL MS_P : ROL MS_P+1 : ASL MS_P : ROL MS_P+1
    CLC : LDA MS_P : ADC #LO(FONT_BUF - 1) : STA MS_P
    LDA MS_P+1 : ADC #HI(FONT_BUF - 1) : STA MS_P+1
    LDY #0 : LDA MS_C : STA (MS_P),Y
    LDA #10 : LDX MS_P : LDY MS_P+1 : JSR osword
    DEC MS_C : LDA MS_C : CMP #31 : BNE char
    SEI
    \ HAZEL in; the display and the CPU's &3000-&7FFF on main RAM, not
    \ shadow, in case MENU ran in a shadow mode.
    LDA &FE34 : AND #&F0 : ORA #8 : STA &FE34
    LDX #0
.copy
    LDA text_font,X : STA M_HAZEL,X
    LDA text_font + &100,X : STA M_HAZEL + &100,X
    LDA text_font + &200,X : STA M_HAZEL + &200,X
    LDA FONT_BUF,X : STA text_font,X
    LDA FONT_BUF + &100,X : STA text_font + &100,X
    LDA FONT_BUF + &200,X : STA text_font + &200,X
    LDA &0200,X : STA M_PAGE2,X
    LDA &0300,X : STA M_PAGE3,X
    LDA &0D00,X : STA M_PAGED,X
    INX : BNE copy
    LDA &D0 : STA M_D0
    LDX #master_reset_end - master_reset - 1
.code
    LDA master_reset_load,X : STA master_reset,X
    DEX : BPL code
    LDA #&4C : STA handoff.reset_jump
    LDA #LO(master_reset) : STA handoff.reset_jump + 1
    LDA #HI(master_reset) : STA handoff.reset_jump + 2
    RTS
}
.master_reset_load
    SECTION MasterReset, org = M_RESET, guard = &D300
\ The game's reset on a Master, from HAZEL: OS pages 2 and 3 and the VDU
\ status as they were when the game was loaded, then handoff's start-up
\ option flip again, and the reset.
.master_reset
{
    LDX #0
.pages
    LDA M_PAGE2,X : STA &0200,X
    LDA M_PAGE3,X : STA &0300,X
    LDA M_PAGED,X : STA &0D00,X
    LDA M_HAZEL,X : STA text_font,X
    LDA M_HAZEL + &100,X : STA text_font + &100,X
    LDA M_HAZEL + &200,X : STA text_font + &200,X
    INX : BNE pages
    LDA M_D0 : STA &D0
    LDA #0 : STA &0258
    LDA &028F : EOR #8 : STA &028F
    JMP (&FFFC)
}
.master_reset_end
    ENDSECTION
.loader_end
    ASSERT loader_end <= SAVE_HDR   ; the game's state above it survives the load
ENDSECTION
