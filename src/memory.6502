\ ***************************************************************************
\ Memory outside the code: every table is laid out here, in guarded
\ sections, so baron places them and refuses an overlap. Never hand-place
\ an address. The sections are virtual: they hand out addresses and keep
\ no bytes.
\ ***************************************************************************

\ Zero page &00-&27 is baron's allocator pool (ZA_POOL in main.6502): the
\ game uses &00-&1F of it, MENU none (measured from the symbols; if a
\ change needs more than the 40, raise ZP_FIXED and move a variable back to LowState).
\ The game's permanent state is here, outside it: death resets the stack
\ and jumps back into the main loop, as the original does, which the
\ allocator would read as recursion. The most used of LowState's variables
\ are here too, whole blocks in their LowState order (some code walks a
\ block with an index), as zero page saves a byte on every access.
ZP_FIXED = &28
NM = 5                      ; monsters in a room, at most
SECTION ZeroPage, org = ZP_FIXED, guard = DATA_BANK_ZP, virtual = TRUE
\ Harry (docs/research/harry.md). The original keeps addresses; the logic
\ needs only the cell (row * 32 + col), yf and xf.
.h_cell     SKIP 2          ; top-left cell
.h_yf       SKIP 1          ; pixel line in the cell, 0-7
.h_xf       SKIP 1          ; 2-pixel step in the cell, 0-3; climbing phase on ladders
.h_dx       SKIP 1          ; this update's move: -1/0/+1 (2 walking off an edge)
.h_dy       SKIP 1          ; ... pixels, up positive
.h_face     SKIP 1          ; 0 right, 4 left, 8 climbing
.h_mom      SKIP 1          ; momentum: the direction of a jump or slope
.h_state    SKIP 1          ; 0 fall 1 walk 2 pipe 3 ladder 4 rope 5 slope up 6 slide 7 jump 8 lift
.h_cnt      SKIP 1          ; jump count (&A485)
.h_fall     SKIP 1          ; fall counter (&A486)
.h_frame    SKIP 2          ; the frame to draw
.hptr       SKIP 2          ; type_map + h_cell, for T(off)
.hptr_up    SKIP 2          ; ... a row up, for the negative offsets
.ctrl       SKIP 1          ; the keys: 4 up 3 down 2 left 1 right 0 jump (&A48A)
.room       SKIP 1          ; 1-120 (&A3FE)
.room_delta SKIP 1          ; set by leaving a room (&A48B)
.carried    SKIP 1          ; the object Harry carries, &FF none (&A560)
.drawn      SKIP 1          ; bit 7: Harry is on screen at d_cell, d_yf, d_frame
.d_cell     SKIP 2
.d_yf       SKIP 1
.d_frame    SKIP 2
\ The RNG (&91B1), big-endian: "9090" when the game is loaded.
.rng_state  SKIP 4
.dbg_room   SKIP 1          ; tests: non-zero, the pass ends in teleport (game.6502)
\ The monsters' most used (the rest are in LowState).
.m_count    SKIP 1          ; monsters in this room (&A48F)
.m_cell_lo  SKIP NM         ; top-left cell
.m_flags    SKIP NM         ; type flags (+12)
\ The draw list (&A41C): monsters that moved this tick, in order.
.dl_count   SKIP 1
.draw_list  SKIP NM
\ The objects (docs/research/objects.md).
.egg        SKIP 1          ; the egg being made, 1 up (&A3F9)
.carried_h  SKIP 1          ; the carried thing's height (&A561)
\ (factory to in_basket: cleared together by egg_init)
.factory    SKIP 1          ; power, toy made, girder, toy placed, egg made, 3 vats (&A48C)
.take_latch SKIP 1          ; one take or drop per press (&A562)
.delivered  SKIP 4          ; toy parts, milk, cocoa, sugar delivered (&A563)
.in_basket  SKIP 4          ; ... in their baskets (&A567)
.cell_hit   SKIP 1          ; the last non-zero cell a footprint met (&9B24)
\ The current thing (&A402): the round robin's pick, drawn every frame.
.o_index    SKIP 1          ; the round robin's pointer ((&A400) low byte)
.o_sel      SKIP 1          ; non-zero: one is selected (&A405)
\ A sprite record (sp_record in objects.6502), as are f_cell, l_cell,
\ l_ocell and d_cell: cell (2), yf, frame (2), and to draw, the ink.
.o_cell     SKIP 2
.o_yf       SKIP 1          ; always 0 (startup.6502's init_game)
.o_frame    SKIP 2          ; its graphic's header
.o_ink      SKIP 1
.o_kind     SKIP 1          ; (&A414)
\ A dropped thing falling into a hopper (&A546).
.f_thing    SKIP 1          ; which; bit 7 set: none (&A54E)
.f_cell     SKIP 2
.f_yf       SKIP 1
.f_frame    SKIP 2
.f_ink      SKIP 1
.train_room SKIP 1          ; the train: its room (&A48D)
.train_pos  SKIP 1          ; ... and position (&A48E)
.noise_flag SKIP 1          ; the train's noise on (&91B5)
.truck_strip SKIP 1         ; the truck strip repainted last (&91B6)
\ The lift (&A52C): type (0 none, 1 rising bar, 2 platform), start, place.
.l_type     SKIP 1
.l_srow     SKIP 1
.l_scol     SKIP 1
.l_width    SKIP 1
.l_dy       SKIP 1
.l_cell     SKIP 2
.l_yf       SKIP 1
.l_frame    SKIP 2
.l_ocell    SKIP 2
.l_oyf      SKIP 1
.l_oframe   SKIP 2
\ Frames since start-up: counted by the interrupt (irq.6502), read by every
\ wait for VSync.
.vsyncs     SKIP 1
.rb         SKIP 2          ; the room's body in the records (rooms.6502's room_load)
ENDSECTION

\ The game's other state, in the DFS's NMI page (free once the disc is done).
\ (Up to &0D9F only: a Master's extended vectors, which its soft BREAK
\ trusts, follow; decision 22.) The first 32 bytes are kept for the
\ streaming edition's NMI routine (docs/streaming.md), which the machine
\ enters at &0D00, so that both editions keep the same memory map.
NMI_AREA = &0D00
SECTION LowState, org = NMI_AREA + &20, guard = &0D9F, virtual = TRUE
.low_state
\ The checkpoint (&A46B): Harry as he entered the room, for a death.
.checkpoint SKIP 16
\ The monsters (&A490, docs/research/monsters.md 2.2): parallel arrays,
\ one entry a monster, at most NM in a room (m_count, m_cell_lo and
\ m_flags are in zero page).
.m_cell_hi  SKIP NM
.m_yf       SKIP NM         ; pixel line in the cell
.m_sub      SKIP NM         ; 2-pixel step across, or the animation phase (+A)
.m_dx       SKIP NM         ; quarter cells a step (+B)
.m_dy       SKIP NM         ; lines a step, up positive (+C)
.m_frame_lo SKIP NM         ; the frame's header
.m_frame_hi SKIP NM
.m_tick     SKIP NM         ; ticks to the next move (+8)
.m_ink      SKIP NM         ; Spectrum colour (+9)
.m_base     SKIP NM         ; base frame (+D)
.m_speed    SKIP NM         ; delay, special bit and state (+13)
.m_srow     SKIP NM         ; start row (+14)
.m_scol     SKIP NM         ; start column (+15)
.m_ocell_lo SKIP NM         ; where it was last drawn
.m_ocell_hi SKIP NM
.m_oyf      SKIP NM
.m_oframe_lo SKIP NM
.m_oframe_hi SKIP NM
.score      SKIP 10         ; the score's digits, most significant first (&A445)
.lives      SKIP 1          ; (&A3FA)
.carrying_name SKIP 1       ; the carried thing's name in the status bar
.cheat      SKIP 1          ; the developers' cheat byte (&A3FC, decision 27)
\ Which of the original's monster table entries are on (monsters.6502):
\ 1 to mon_limit, and the sitting dog (entry 0) in place of the running
\ one (entry 1) once dog_sat.
.mon_limit  SKIP 1          ; (egg_init: min(130 + 25 * egg, 255))
.dog_sat    SKIP 1
.low_state_end
ENDSECTION
\ The three 32 x 24 maps the room drawer fills, one byte a cell, indexed by
\ cell = row * 32 + column, as the original's at &5D00, &6000 and &6300.
\ They sit in OS workspace the game doesn't use once it is running: the
\ language's pages (&0400-&07FF), the sound and printer buffers (&0800), the
\ cassette and serial buffers (&0900-&0AFF), soft keys (&0B00) and
\ user-defined characters (&0C00). Page-aligned: a map's address is its
\ page plus the cell number.
SECTION Maps, org = &0400, guard = &0D00, virtual = TRUE
.attr_map   SKIP 768        ; the attribute of each cell (Spectrum format)
.tile_map   SKIP 768        ; the tile drawn there; bit 7 set for text
.type_map   SKIP 768        ; the cell type: what Harry can stand on, climb...
ENDSECTION

\ Scratch variables in zero page &90-&FB: the OS's, but the game makes no
\ OS calls once it owns the interrupts (decision 11), and the OS's IRQ entry
\ only uses &FC. Nothing here is used before install_irq.
SECTION Scratch, org = &90, guard = &FC, virtual = TRUE
\ (screen.6502)
.dg_band       SKIP 1          ; draw_glyph's band offset
.sp_row        SKIP 1          ; the row draw_sprite or erase_image is at
.sb_p          SKIP 2          ; setup_bands' pointer (bands.6502: no allocator there)
.irq_split     SKIP 1          ; the next T1 split: 0 the status bar's, then bands 1, 2
\ (status.6502)
.status_i      SKIP 1
.status_x      SKIP 1
\ (unpack.6502)
.rec_len       SKIP 1
.rec_pos       SKIP 1
.rec_buf       SKIP 18          ; the longest record is 17 bytes, a text
.unpack_vert   SKIP 1
\ (monsters.6502)
.m_entry       SKIP 1
.cf_x          SKIP 1
.m_cur         SKIP 1
.m_w           SKIP 1
.m_h           SKIP 1
.dl_i          SKIP 1
\ (collide.6502)
.c_m           SKIP 1          ; who_was_hit's monster
.box_l         SKIP 1
.box_r         SKIP 1
.box_t         SKIP 1
.box_b         SKIP 1
\ (objects.6502)
.tl_t          SKIP 1
.drop_x        SKIP 1
\ (sound.6502)
.dt_i          SKIP 1
.dt_n          SKIP 1
.ms_n          SKIP 1
.noise_on      SKIP 1
\ (machines.6502)
.ds_ink        SKIP 1
.ds_rows       SKIP 1
.ds_b          SKIP 1          ; strips
.ds_c          SKIP 1          ; the first strip's frame
.ds_d          SKIP 1          ; column
.ds_e          SKIP 1          ; row
.rc_b          SKIP 1
.ta_b          SKIP 1
.w10_n         SKIP 1
\ (bands.6502: set when a room is drawn)
.band_count    SKIP 1          ; how many splits, 0-2
.band_rows     SKIP 2          ; bands 1 and 2: the first row of each
\ &D0 is the Master's VDU status, which its soft BREAK reads (decision 22).
    ASSERT P% <= &D0
    SKIP &D0 - P%
.vdu_status    SKIP 1          ; (not the game's)
\ (irq.6502: install_irq fills status_ula; VSync writes it and the first
\ ten of room_ula, after it, in one go)
.status_ula    SKIP 6
.room_ula      SKIP 16
\ (game.6502)
.ed_n          SKIP 1
.save_armed    SKIP 1
\ (rooms.6502: room_load's graphics group)
.gp            SKIP 2
IF DEFINED(STREAM)
\ (disc.6502: the reader, and what fetch reads)
.fdc_state     SKIP 1          ; 0 idle, 1 seeking (1770), 2 reading, (8271:) 3 waiting, 4 to track 0
.fdc_cur       SKIP 1          ; 1770: the head's track (&FF: not known)
i_since = fdc_cur               ; (8271: when the wait for the drive began)
.nmi_left      SKIP 1          ; (startup.6502's Nmi: the bytes still wanted)
.fe_pos                        ; where on the disc: sector, track (the reader's)
.fdc_sect      SKIP 1
.fdc_track     SKIP 1
.fe_len        SKIP 2          ; how many bytes
.fe_dst        SKIP 2          ; to where
.item_top      SKIP 2          ; (disc.6502: the cache's next free byte)
.it_n          SKIP 1          ; (disc.6502: items in the cache)
.epoch         SKIP 1          ; on one at each room entered
.pf_cur        SKIP 1          ; the room the cache was set up for
ENDIF
ENDSECTION

\ The game's state on its way to and from the front end (state.6502,
\ menu.6502): a saved game is the 64 bytes from SAVE_HDR (MENU's header
\ and the keys; not the high scores, which are CE2HI's: decision 38), then
\ the regions at STATE. Above anything CE2 loads over (main.6502 checks)
\ and below MODE 7's screen, so it survives the reset, MENU and the game's
\ reload.
STATE      = &6000
SAVE_HDR   = STATE - 64     ; "CE2SAVE" and the build stamp (menu.6502 checks)
SAVE_KEYS  = STATE - 8

\ The streaming edition's mailbox (docs/streaming.md), with no sideways
\ bank to keep it in: CE2DATA's first bytes (its magic and state.6502's
\ mailbox) at the top of main RAM, where MENU reads and writes them. CE2S
\ loads over them, so MENU leaves a copy at MB_XFER for its loader to put
\ back. (MB_STREAM is in main.6502, which knows the stamp's length.)
MB_XFER   = &7600
ASSERT MB_XFER >= STATE + &800

\ What a soft BREAK keeps of the OS's page 2 (the reset code clears and
\ resets the rest), including the start-up options at &028F.
OS_KEPT     = &027F
OS_KEPT_LEN = &1D
