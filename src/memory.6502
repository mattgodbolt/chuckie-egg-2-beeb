\ ***************************************************************************
\ Memory outside the code: every table is laid out here, in guarded
\ sections, so baron places them and refuses an overlap. Never hand-place
\ an address.
\ ***************************************************************************

\ Zero page &00-&5F is baron's allocator pool (ZA_POOL in main.6502). The
\ game's permanent state is here, outside it: death resets the stack and
\ jumps back into the main loop, as the original does, which the allocator
\ would read as recursion.
ZP_FIXED = &60
SECTION ZeroPage, org = ZP_FIXED, guard = &90
\ Harry (docs/research/harry.md). The original keeps addresses; the logic
\ needs only the cell (row * 32 + col), yf and xf.
.h_cell     SKIP 2          ; top-left cell
.h_yf       SKIP 1          ; pixel line in the cell, 0-7
.h_xf       SKIP 1          ; 2-pixel step in the cell, 0-3; climbing phase on ladders
.h_dx       SKIP 1          ; this update's move: -1/0/+1 (2 walking off an edge)
.h_dy       SKIP 1          ; ... pixels, up positive
.h_face     SKIP 1          ; 0 right, 4 left, 8 climbing
.h_mom      SKIP 1          ; momentum: the direction of a jump or slope
.h_state    SKIP 1          ; 0 fall 1 walk 2 pipe 3 ladder 4 rope 5 slope up 6 slide 7 jump 8 lift
.h_cnt      SKIP 1          ; jump count (&A485)
.h_fall     SKIP 1          ; fall counter (&A486)
.h_frame    SKIP 2          ; the frame to draw
.hptr       SKIP 2          ; type_map + h_cell, for T(off)
.hptr_up    SKIP 2          ; ... a row up, for the negative offsets
.ctrl       SKIP 1          ; the keys: 4 up 3 down 2 left 1 right 0 jump (&A48A)
.room       SKIP 1          ; 1-120 (&A3FE)
.room_delta SKIP 1          ; set by leaving a room (&A48B)
.carried    SKIP 1          ; the object Harry carries, &FF none (&A560)
.drawn      SKIP 1          ; bit 7: Harry is on screen at d_cell, d_yf, d_frame
.d_cell     SKIP 2
.d_yf       SKIP 1
.d_frame    SKIP 2
\ The room's colour map (screen.6502): long-lived, so out of the
\ allocator's pool with the rest.
ENDSECTION

\ The game's other state, in the DFS's NMI page (free once the disc is done).
SECTION LowState, org = &0D00, guard = &0E00
\ The checkpoint (&A46B): Harry as he entered the room, for a death.
.checkpoint SKIP 16
.dbg_room   SKIP 1          ; tests: a room to put Harry in (game.6502),
.dbg_start  SKIP 6          ; ... and his cell (2), yf, xf, state, face
\ The RNG (&91B1), big-endian: "9090" when the game is loaded.
.rng_state  SKIP 4
\ The monsters (&A490, docs/research/monsters.md 2.2): parallel arrays,
\ one entry a monster, at most NM in a room.
NM = 5
.m_count    SKIP 1          ; monsters in this room (&A48F)
.m_cell_lo  SKIP NM         ; top-left cell
.m_cell_hi  SKIP NM
.m_yf       SKIP NM         ; pixel line in the cell
.m_sub      SKIP NM         ; 2-pixel step across, or the animation phase (+A)
.m_dx       SKIP NM         ; quarter cells a step (+B)
.m_dy       SKIP NM         ; lines a step, up positive (+C)
.m_frame_lo SKIP NM         ; the frame's header
.m_frame_hi SKIP NM
.m_tick     SKIP NM         ; ticks to the next move (+8)
.m_ink      SKIP NM         ; Spectrum colour (+9)
.m_base     SKIP NM         ; base frame (+D)
.m_flags    SKIP NM         ; type flags (+12)
.m_speed    SKIP NM         ; delay, special bit and state (+13)
.m_srow     SKIP NM         ; start row (+14)
.m_scol     SKIP NM         ; start column (+15)
.m_ocell_lo SKIP NM         ; where it was last drawn
.m_ocell_hi SKIP NM
.m_oyf      SKIP NM
.m_oframe_lo SKIP NM
.m_oframe_hi SKIP NM
.m_vis      SKIP NM         ; drawn and not since erased (collide.6502)
\ The draw list (&A41C): monsters that moved this tick, in order.
.dl_count   SKIP 1
.draw_list  SKIP NM
\ The objects (docs/research/objects.md).
.egg        SKIP 1          ; the egg being made, 1 up (&A3F9)
.factory    SKIP 1          ; power, toy made, girder, toy placed, egg made, 3 vats (&A48C)
.carried_h  SKIP 1          ; the carried thing's height (&A561)
.take_latch SKIP 1          ; one take or drop per press (&A562)
.delivered  SKIP 4          ; toy parts, milk, cocoa, sugar delivered (&A563)
.in_basket  SKIP 4          ; ... in their baskets (&A567)
.cell_hit   SKIP 1          ; the last non-zero cell a footprint met (&9B24)
\ The current thing (&A402): the round robin's pick, drawn every frame.
.o_index    SKIP 1          ; the round robin's pointer ((&A400) low byte)
.o_thing    SKIP 1          ; the thing loaded into the record
.o_sel      SKIP 1          ; non-zero: one is selected (&A405)
.o_cell     SKIP 2
.o_frame    SKIP 2          ; its graphic's header
.o_ink      SKIP 1
.o_kind     SKIP 1          ; (&A414)
.o_gfx      SKIP 1          ; (&A40F)
\ A dropped thing falling into a hopper (&A546).
.f_thing    SKIP 1          ; which; bit 7 set: none (&A54E)
.f_cell     SKIP 2
.f_yf       SKIP 1
.f_frame    SKIP 2
.f_ink      SKIP 1
.f_ocell    SKIP 2          ; where it was drawn
.f_oyf      SKIP 1
.train_room SKIP 1          ; the train: its room (&A48D)
.train_pos  SKIP 1          ; ... and position (&A48E)
\ Things drawn in this room since it was entered (for collide.6502).
.on_screen  SKIP 32         ; a bit per thing
.noise_flag SKIP 1          ; the train's noise on (&91B5)
.score      SKIP 10         ; the score's digits, most significant first (&A445)
.lives      SKIP 1          ; (&A3FA)
.carrying_name SKIP 1       ; the carried thing's name in the status bar
\ screen_bits' looked-up cells (collide.6502), one for each of Harry's columns.
.sbc_lo     SKIP 2
.sbc_hi     SKIP 2
.sbc_glo    SKIP 2
.sbc_ghi    SKIP 2
.sbc_paper  SKIP 2
.truck_strip SKIP 1         ; the truck strip repainted last (&91B6)
\ The lift (&A52C): type (0 none, 1 rising bar, 2 platform), start, place.
.l_type     SKIP 1
.l_srow     SKIP 1
.l_scol     SKIP 1
.l_width    SKIP 1
.l_dy       SKIP 1
.l_cell     SKIP 2
.l_yf       SKIP 1
.l_frame    SKIP 2
.l_ocell    SKIP 2
.l_oyf      SKIP 1
.l_oframe   SKIP 2
ENDSECTION

\ The three 32 x 24 maps the room drawer fills, one byte a cell, indexed by
\ cell = row * 32 + column, as the original's at &5D00, &6000 and &6300.
\ They sit in OS workspace the game doesn't use once it is running: the
\ language's pages (&0400-&07FF), the sound and printer buffers (&0800), the
\ cassette and serial buffers (&0900-&0AFF), soft keys (&0B00) and
\ user-defined characters (&0C00). Page-aligned: a map's address is its
\ page plus the cell number.
SECTION Maps, org = &0400, guard = &0D00
.attr_map   SKIP 768        ; the attribute of each cell (Spectrum format)
.tile_map   SKIP 768        ; the tile drawn there; bit 7 set for text
.type_map   SKIP 768        ; the cell type: what Harry can stand on, climb...
ENDSECTION

\ Scratch variables in zero page &90-&FB: the OS's, but the game makes no
\ OS calls once it owns the interrupts (decision 11), and the OS's IRQ entry
\ only uses &FC. Nothing here is used before install_irq.
SECTION Scratch, org = &90, guard = &FC
\ (irq.6502)
.room_ula      SKIP 16
\ (screen.6502)
.dg_band       SKIP 1          ; draw_glyph's band offset
.sp_row        SKIP 1          ; draw_sprite's screen row
.sb_p          SKIP 2          ; setup_bands' pointer (bands.6502: no allocator there)
.irq_split     SKIP 1          ; the next T1 split: 0 the status bar's, then bands 1, 2
.sb_slot       SKIP 1          ; screen_bits' column of Harry, 0 or 1
.set_logical_t SKIP 1
.gbyte         SKIP 1
\ (rooms.6502)
.back_cells_n  SKIP 1
\ (status.6502)
.vb_value      SKIP 1
.vb_n          SKIP 1
.status_i      SKIP 1
.status_x      SKIP 1
\ (unpack.6502)
.unpack_pick   SKIP 1
.rec_len       SKIP 1
.rec_pos       SKIP 1
.rec_buf       SKIP 18          ; the longest record is 17 bytes, a text
.unpack_capped SKIP 1
.unpack_vert   SKIP 1
\ (harry.6502)
.harry_vec     SKIP 2
\ (monsters.6502)
.m_entry       SKIP 1
.m_step        SKIP 1
.cf_x          SKIP 1
.m_cur         SKIP 1
.m_c           SKIP 1
.m_n           SKIP 1
.m_ropes       SKIP 1
.m_w           SKIP 1
.m_h           SKIP 1
.dl_i          SKIP 1
\ (collide.6502)
.ccol          SKIP 1
.c_m           SKIP 1          ; who_was_hit's monster
.box_l         SKIP 1
.box_r         SKIP 1
.box_t         SKIP 1
.box_b         SKIP 1
\ (objects.6502)
.tc_x          SKIP 1
.tl_t          SKIP 1
.tl_kind       SKIP 1
.bonus_n       SKIP 1
.drop_x        SKIP 1
.drop_row      SKIP 1
.drop_col      SKIP 1
.drop_g        SKIP 1
.drop_g2       SKIP 1
.old_row       SKIP 1
.old_col       SKIP 1
.dv_g          SKIP 1
.wl_x          SKIP 1
.ei_n          SKIP 1
\ (machines.6502)
.ds_ink        SKIP 1
.ds_rows       SKIP 1
.ds_b          SKIP 1          ; strips
.ds_c          SKIP 1          ; the first strip's frame
.ds_d          SKIP 1          ; column
.ds_e          SKIP 1          ; row
.rc_b          SKIP 1
.rc_c          SKIP 1
.rc_d          SKIP 1
.ta_b          SKIP 1
.w10_n         SKIP 1
.sl_row        SKIP 1
\ (game.6502)
.ed_n          SKIP 1
.keys_i        SKIP 1
.save_armed    SKIP 1
\ (sound.6502)
.si_x          SKIP 1
.dt_i          SKIP 1
.dt_n          SKIP 1
.ms_l0         SKIP 1
.ms_n          SKIP 1
.noise_on      SKIP 1
ENDSECTION

\ The game's state on its way to and from the front end (state.6502,
\ menu.6502): a saved game is the 256 bytes from SAVE_HDR (MENU's header,
\ the keys and the high-score table), then the regions at STATE. Above
\ anything CE2 loads over (main.6502 checks) and below MODE 7's screen,
\ so it survives the reset, MENU and the game's reload.
SAVE_HDR   = &5F00          ; "CE2SAVE" and the build stamp, 40 bytes
SAVE_KEYS  = &5F28
SAVE_TABLE = &5F30          ; 200 bytes
STATE      = &6000

\ What a soft BREAK keeps of the OS's page 2 (the reset code clears and
\ resets the rest), including the start-up options at &028F.
OS_KEPT     = &027F
OS_KEPT_LEN = &1D
