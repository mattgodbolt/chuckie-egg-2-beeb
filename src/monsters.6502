\ ***************************************************************************
\ Monsters: a transcription of the original's (docs/research/monsters.md,
\ sections 3 and 4). At most four in a room; each ticks twice a pass, moves
\ when its counter runs out, and is redrawn at the next frame if it moved.
\
\ The original's 26-byte records become parallel arrays indexed by the
\ monster's number (memory.6502); positions are a cell, yf and sub (the
\ original's IY+A: 2-pixel steps across, or the animation phase).
\ ***************************************************************************

\ Type flags (byte 2 of a type).
MF_FAST    = &80            ; step 2 (4 pixels), half as many frames
MF_VERT    = &40            ; moves vertically
MF_FREE    = &20            ; needs no floor ahead (flyers) or rope (vertical)
MF_RESPAWN = &10            ; when blocked: back to the start
MF_NEG     = &08            ; starts left / down
MF_BOUNCE  = &04            ; knocks Harry back
MF_KILL    = &02            ; kills Harry
MF_STATIC  = &01            ; never moves

\ (mon_types, 4 bytes a type: ink, base, flags, speed. The streaming
\ edition's bodies have the type's four bytes in its place:
\ tools/mkrecords.py.)

\ The noise flag (&91B5): set while the train is drawn with the power on.
\ The noise routine (&92E7) is called nine times a pass and, while the flag
\ is set, takes a random number each time, so the calls stay in the
\ original's places even before there is sound.
.noise
    LDA noise_flag : BEQ rng.done
    \ Fall into rng.
\ The RNG (&918A): 32 bits, big-endian, shifted left with bit 30 EOR bit
\ 27 coming in at the bottom; returns the new top byte. Called once for
\ every monster every tick, so the calls must stay in the original's
\ order. X and Y are kept (the tick relies on X).
.rng
{
    LDA rng_state : AND #&48 : ADC #&38         ; bit 6 = bit 6 EOR bit 3 (a carry
                                                ; in only sets bit 0)
    ASL A : ASL A                               ; ... into the carry
    ROL rng_state+3 : ROL rng_state+2 : ROL rng_state+1 : ROL rng_state
    LDA rng_state
.done
    RTS
}

\ Set up the room's monsters (&8B2A). The original scans its monster
\ table, entries 1-255 then 0, for this room's; the room's body has them in
\ that order (tools/mkrecords.py): entry, row, column, type. An entry is on
\ from 1 to mon_limit; the sitting dog, 0, is on in place of the running
\ one, 1, once dog_sat (as egg_init and respawn set the original's bit 7s).
.setup_monsters
{
    ZA_AUTO1 left
    \ (dl_count needs no clearing: monsters_tick sets it before
    \ draw_monsters reads it.)
    LDA #0 : STA m_count
    LDY rb_mon
    LDA (rb),Y : STA left
.scan
    DEC left : BMI done
    INY : STY m_entry
    \ Entries 0 and 1, the sitting dog and the running one: the one that
    \ dog_sat (0 or 1) says is on, entry EOR dog_sat = 1.
    LDA (rb),Y : CMP #2 : BCS limit
    EOR dog_sat : BEQ off       ; (else A = 1: on, as mon_limit is at least 155)
.limit
    CMP mon_limit : BEQ on : BCS off
.on
    \ (A room has at most four entries, fewer than NM: tools/mkrecords.py.)
    LDX m_count
    JSR setup_monster
    INC m_count
.off
IF DEFINED(STREAM)
    \ (The entry's type's four bytes, not its number: seven a monster.)
    LDA m_entry : CLC : ADC #6 : TAY
ELSE
    LDY m_entry : INY : INY : INY
ENDIF
    BNE scan                    ; (always: the entry's type is in the body)
.done
    RTS
}

\ Monster X from the entry at rb + m_entry (&8B5D).
.setup_monster
{
    LDY m_entry
    INY : LDA (rb),Y : STA m_srow,X
    INY : LDA (rb),Y : STA m_scol,X
IF DEFINED(STREAM)
    INY : LDA (rb),Y : STA m_ink,X
    INY : LDA (rb),Y : STA m_base,X
    INY : LDA (rb),Y : STA m_flags,X
    INY : LDA (rb),Y : STA m_speed,X
ELSE
    INY : LDA (rb),Y : ASL A : ASL A : TAY
    LDA mon_types,Y : STA m_ink,X
    LDA mon_types+1,Y : STA m_base,X
    LDA mon_types+2,Y : STA m_flags,X
    LDA mon_types+3,Y : STA m_speed,X
ENDIF
    JSR m_to_start                          ; (A = 0)
    STA m_sub,X : STA m_dx,X : STA m_dy,X
    INX : TXA : DEX : STA m_tick,X          ; staggers the first moves
    \ The step: 1, or 2 when fast; negative if NEG.
    LDA m_flags,X : AND #MF_NEG : BEQ positive
    LDA #&FE
.positive
    ORA #1
    LDY m_flags,X : BPL slow
    ASL A
.slow
    TAY
    LDA m_flags,X : ASL A : BPL across      ; MF_VERT, shifted into bit 7
    TYA : ASL A : STA m_dy,X
    BNE choose_frame                        ; (always)
.across
    TYA : STA m_dx,X
    \ Fall into choose_frame.
}

\ ChooseFrame (&8E70): base + (dx < 0 ? 4 : 0) + sub, halved when fast.
.choose_frame
{
    LDA m_sub,X
    LDY m_dx,X : BPL right
    ORA #4                                  ; (sub is 0-3)
.right
    LDY m_flags,X : BPL slow
    LSR A
.slow
    CLC : ADC m_base,X
    STX cf_x
    JSR sprite_frame
    LDY cf_x
    STA m_frame_lo,Y
    TXA : STA m_frame_hi,Y
    LDX cf_x
    RTS
}

\ Monster X to its start cell, top line. Returns A = 0 (setup_monster
\ and respawn rely on it).
.m_to_start
    LDY m_scol,X : LDA m_srow,X : JSR row_col_cell
    STA m_cell_lo,X
    TYA : STA m_cell_hi,X
    LDA #0 : STA m_yf,X
    RTS

\ Both ticks of a pass (&8C0A): every monster, in order; the ones that move
\ go on the draw list.
.monsters_tick
{
    LDX #0 : STX dl_count
.loop
    CPX m_count : BEQ done
    STX m_cur
    JSR tick                                ; (which returns X = m_cur)
    INX
    BNE loop                                ; (always)
.done
    RTS
}

\ Specials (4.5): icicles, drips, bubbles, clouds. State in speed bits 6,
\ 5: 00 idle, 01 forming, 10 formed, 11 moving, each the last + &20 (and
\ respawn's back to 00). (Before tick, which branches back to it.)
.m_special
{
    LDA m_speed,X : AND #&60
    BEQ idle
    ASL A : ASL A : BCC forming             ; 01
    BPL formed                              ; 10
    \ 11: moving; tested on a character boundary.
    LDA m_yf,X : BNE go
    JMP vcheck
.idle
    LDA m_flags,X : AND #MF_NEG : BNE appear
    JSR rng : CMP #10 : BCS wait            ; 10 in 256 a tick
.appear
    LDA #0 : STA m_sub,X : STA m_dy,X
    JSR next_state                          ; 01
    BNE ten                                 ; (always: the speed's bit 7)
.forming
    LDA m_sub,X : CMP #3 : BEQ advance      ; 10
    INC m_sub,X
.ten
    LDA #10 : STA m_tick,X
    BNE go                                  ; (always)
.formed
    \ Falls (up if NEG, at 10 in 256 a tick; down at once).
    LDA m_flags,X : AND #MF_NEG : BEQ rise
    JSR rng : CMP #10 : BCS wait
    LDA #&FE : BNE set_dy                   ; (always)
.rise
    LDA #2
.set_dy
    STA m_dy,X
.advance                                    ; 11 (or 10, from forming)
    JSR next_state
.go
    JMP m_move
\ The next state: + &20 (from 00, 01 or 10, so bit 7 stays set).
.next_state
    LDA m_speed,X : CLC : ADC #&20 : STA m_speed,X
.wait
    RTS
}

\ Tick (&8C2C). X = m_cur all through, and on the way out (monsters_tick
\ relies on it: every path keeps X, or loads m_cur again).
.tick
{
    JSR rng                                 ; every monster, every tick
    DEC m_tick,X : BPL m_special.wait
    LDA m_speed,X : TAY : AND #&1F : STA m_tick,X
    TYA : BMI m_special
    LDA m_flags,X : LSR A : BCC moves       ; MF_STATIC
    LDA #0 : STA m_dx,X : STA m_dy,X
    BEQ to_move                             ; (always)
.moves
    AND #MF_VERT DIV 2 : BNE vertical       ; (the flags, shifted down one)
\ Horizontal movers (4.3): tested only on a character boundary.
    LDA m_sub,X : BNE to_move
    JSR m_size                              ; m_w, m_h; mon_p = type map at the cell
    LDA mon_p : AND #31                     ; the column
    LDY m_dx,X : BPL right
    \ Left: the column just before, mon_p - 1 (the column isn't 0, so
    \ mon_p's low byte isn't either: no borrow).
    TAY : BEQ blocked
    DEC mon_p
    LDY #0 : BEQ column                     ; (always)
.right
    \ Right: the column just past the monster, blocked if that is 32 or
    \ more (at most 31 + 15: bit 5). (m_size leaves C clear; so does the
    \ sum.)
    ADC m_w : AND #32 : BNE blocked
    LDY m_w
.column
    \ m_h cells down from (mon_p),Y must all be clear (anything but bit 1)...
.cells
    LDA (mon_p),Y : AND #&FD : BNE blocked
    TYA : ADC #32 : TAY                     ; (C is clear every way in)
    BCC no_page
    INC mon_p+1 : CLC
.no_page
    DEC m_h : BNE cells                     ; (nothing reads m_h after)
    \ ... and unless it flies, the cell below them must be floor.
    LDA m_flags,X : AND #MF_FREE : BNE to_move
    LDA (mon_p),Y : AND #&21 : BNE to_move
.blocked
    \ (C is clear every way here, which m_blocked relies on.)
    TXA : TAY                               ; (m_blocked's m_dx,Y: the step across)
    BPL m_blocked                           ; (always)
.to_move
    JMP m_move

\ Vertical movers (4.4): the animation from the pixel line; tested every
\ fourth step, on a character boundary.
.vertical
    LDA m_yf,X : LSR A : STA m_sub,X
    BNE to_move
    \ Fall into vcheck.
}

\ VCheck (&8CD3): up needs the row above clear, down the row below; each
\ cell clear but for ropes, and unless free, at least one rope.
.vcheck
{
    JSR m_size                              ; (C clear)
    LDA m_dy,X : BMI down
    \ Up: blocked at rows 0-2 (the top row of the room is 2), cells 0-95.
    LDA mon_p : CMP #3 * 32
    LDA mon_p+1 : SBC #HI(type_map) : BCC vblocked
    LDA mon_p : SBC #32 : STA mon_p         ; (C set)
    BCS test
    DEC mon_p+1
    BCC test                                ; (always)
.down
    \ Down: the row h below (h < 8: h * 32 is a byte, and the shifts
    \ leave C clear); blocked if that is row 24 or more, past the end of
    \ the map (as the columns are 0-31).
    LDA m_h : ASL A : ASL A : ASL A : ASL A : ASL A
    ADC mon_p : STA mon_p
    BCC row_ok
    INC mon_p+1
.row_ok
    LDA mon_p+1 : CMP #HI(type_map) + 3 : BCS vblocked
.test
    \ The w cells ORed together: nothing but rope bits (2), and unless it
    \ is free, some. (A frame is at least a column wide.)
    LDY m_w : DEY
    LDA #0
.vcell
    ORA (mon_p),Y
    DEY : BPL vcell
    CMP #2 : BEQ m_move
    TAY : BNE vblocked
    LDA m_flags,X : AND #MF_FREE : BNE m_move
.vblocked
    TXA : CLC : ADC #NM : TAY               ; (m_blocked's m_dx,Y: m_dy)
    \ Fall into m_blocked.
}

\ Blocked: back to the start if it respawns, else it turns, and steps the
\ same tick. m_dx,Y is the step that was blocked: Y is X across, X + NM
\ (m_dy) up or down. C is clear (tick's and vcheck's paths here).
    ASSERT m_dy = m_dx + NM
.m_blocked
{
    LDA m_flags,X : AND #MF_RESPAWN : BEQ turn
    JMP respawn
.turn
    LDA #1 : SBC m_dx,Y : STA m_dx,Y        ; (C clear: 1 - step - 1)
    \ Fall into m_move.
}

\ Move (&8E59): save where it is, step, pick the frame, put it on the
\ draw list. (X = m_cur.)
.m_move
    JSR m_save_old
.m_move_nosave                              ; (X = m_cur)
{
    \ Step (&8E94): across by dx quarter cells, up by dy lines.
    LDA m_sub,X : CLC : ADC m_dx,X : TAY
    AND #3 : STA m_sub,X
    TYA : BMI left
    CMP #4 : BCC vertical
    INC m_cell_lo,X : BNE vertical
    INC m_cell_hi,X
    BNE vertical                            ; (always)
.left
    LDA m_cell_lo,X : BNE no_borrow
    DEC m_cell_hi,X
.no_borrow
    DEC m_cell_lo,X
.vertical
    LDA m_yf,X : SEC : SBC m_dy,X : TAY
    AND #7 : STA m_yf,X
    TYA : BMI up
    CMP #8 : BCC framed
    LDA m_cell_lo,X : ADC #31 : STA m_cell_lo,X     ; (C set: + 32)
    BCC framed
    INC m_cell_hi,X
    BNE framed                              ; (always)
.up
    \ (C clear: yf - dy is negative only by a borrow, as |dy| <= 4 and
    \ yf < 8; so - 32.)
    LDA m_cell_lo,X : SBC #31 : STA m_cell_lo,X
    BCS framed
    DEC m_cell_hi,X
.framed
    JSR choose_frame
    LDY dl_count : STX draw_list,Y
    INC dl_count
    RTS
}

\ m_w, m_h from monster X's frame; mon_p = type_map + its cell. C is left
\ clear (the cell's high byte is 0-2), which the checks rely on.
ZA_AUTO2 mon_p
ZA_AUTO2 mframe
.m_size
    LDA m_frame_lo,X : STA mframe
    LDA m_frame_hi,X : STA mframe+1
    LDY #0 : LDA (mframe),Y : AND #7 : STA m_h     ; (the header's other bits: sprite.6502)
    INY : LDA (mframe),Y : AND #15 : STA m_w
    LDA m_cell_lo,X : STA mon_p
    CLC : LDA m_cell_hi,X : ADC #HI(type_map) : STA mon_p+1
    RTS

\ Respawn (&8D4D), with the two room events.
.respawn
{
    JSR m_save_old
    LDA room : CMP #120 : BNE not120
    \ The dinosaur on its scooter stops.
    INC m_base,X : INC m_base,X
    BNE static                          ; (always: the bases are under &FE)
.not120
    CMP #2 : BNE general
    \ The dog sits, for good: entry 0 (sitting) replaces entry 1.
    LDA #&0C : STA m_base,X
    LDA #1 : STA dog_sat
    \ And the bone is gone, wherever it is: its footprint toggled in this
    \ room's map at its row and column (a stray &40 if it's elsewhere, as
    \ in the original) and its image erased here.
    LDX #&24 : JSR thing_cells
    LDA #0 : STA t_room+&24
    JSR erase_object
    LDA #0 : STA o_sel
    LDX m_cur
.static
    LDA #MF_STATIC : STA m_flags,X
    LDA #0 : STA m_dx,X : STA m_sub,X
.nosave
    JMP m_move_nosave
.general
    LDA m_speed,X : BPL back
    \ Specials vanish now, and wait invisible.
    JSR m_erase
    LDX m_cur
    LDA m_speed,X : AND #&9F : STA m_speed,X    ; idle
    JMP m_to_start
.back
    JSR m_to_start
    BEQ nosave                          ; and step from the start at once (always)
}

\ The old position := the current one (&884D).
.m_save_old
    LDA m_cell_lo,X : STA m_ocell_lo,X
    LDA m_cell_hi,X : STA m_ocell_hi,X
    LDA m_yf,X : STA m_oyf,X
    LDA m_frame_lo,X : STA m_oframe_lo,X
    LDA m_frame_hi,X : STA m_oframe_hi,X
    RTS

\ Erase monster X at its old position.
.m_erase
    LDA m_ocell_lo,X : STA sp_cell
    LDA m_ocell_hi,X : STA sp_cell+1
    LDA m_oyf,X : STA sp_yf
    LDA m_oframe_lo,X : STA sp_frame
    LDA m_oframe_hi,X : STA sp_frame+1
    JMP erase_image

\ The draw list, at the frame after a tick (the original's interrupt):
\ each monster erased then drawn before the next is touched.
.draw_monsters
{
    LDY #0
.loop
    CPY dl_count : BEQ done
    STY dl_i
    LDX draw_list,Y
    JSR m_erase
    LDY dl_i : LDX draw_list,Y
    LDA m_cell_lo,X : STA sp_cell
    LDA m_cell_hi,X : STA sp_cell+1
    LDA m_yf,X : STA sp_yf
    LDA m_frame_lo,X : STA sp_frame
    LDA m_frame_hi,X : STA sp_frame+1
    LDA m_ink,X : STA sp_ink
    JSR draw_sprite
    LDY dl_i : INY
    BNE loop                                ; (always)
.done
    RTS
}
