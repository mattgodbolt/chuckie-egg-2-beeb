\ ***************************************************************************
\ Music (decisions 46 and 47; the sideways RAM edition only): the Dance of
\ the Sugar Plum Fairy from Tchaikovsky's The Nutcracker (music/README.md),
\ which tools/mkmusic.py turns into music (events) and
\ music_latch/music_data (the dividers the events index; data/music.6502).
\
\ The VSync interrupt plays it (music_tick): the tune on channel 0, an inner
\ voice on channel 1, the bass on channel 2, and with each bass note a
\ pluck of noise. Each voice is an instrument: its loudness follows an
\ envelope (mu_envs) from each note's start, and the tune's sounds an
\ octave up for its first frame, a chime's strike.
\
\ The game's own sounds come first: the life-lost tune takes the voices
\ (music_death: the music plays it, harmonised), the movement tick
\ borrows channel 1, and the train's noise, clocked by
\ channel 2, takes that and the noise channel while it's on. A voice they
\ used is marked in mu_dirty, and the next VSync writes its note again. M
\ switches it off and on (read_keys).
\
\ The interrupt's writes to the sound chip go through the System VIA, as
\ the game's do. The chip takes a register's number in one byte and its
\ value in the next, so the game's code keeps the interrupt off the chip
\ (mu_busy) while it writes a sound, and sound_write for each byte; a
\ frame the interrupt missed then is played with the next (mu_owed). It
\ puts back the port as the code it interrupted had it (key_down's
\ included).
\ ***************************************************************************

MU_ON = &80                         ; mu_on: M has it on
MU_ALL = %1111                      ; mu_dirty: every voice
MU_TRAIN = %1100                    ; ... the bass and the pluck (channel 2, noise)
MU_BLIPS = %0001                    ; the voices whose notes start an octave up
MU_VIBS = %0010                     ; ... and those with vibrato
MU_VIB_DELAY = 10                   ; frames into a note before its vibrato
MU_QUIET = 2                        ; every envelope this much quieter (2dB a step)
ASSERT (MU_VIBS AND (MU_BLIPS OR MU_TRAIN)) = 0
MU_NOISE = &E4                      ; the pluck's noise: white, the fastest shift

\ Vibrato: the pitch's wobble a frame, in steps of a 128th of the divider,
\ round from MU_VIB_DELAY on (eight frames: about 6Hz).
.mu_vib     EQUB 0, 1, 1, 1, 0, -1, -1, -1

\ Each voice: its bit (mu_dirty, mu_blip), its volume register, and where
\ its envelope starts in mu_envs. Voice 3, the pluck, has no note: it
\ starts with the bass's.
.mu_bits    EQUB 1, 2, 4, 8
.mu_volreg  EQUB &90, &B0, &D0, &F0
.mu_instr   EQUB mu_chime - mu_envs, mu_flute - mu_envs
            EQUB mu_pizz - mu_envs, mu_pluck - mu_envs

\ The envelopes: each byte an attenuation (0 the loudest, 15 silent) in
\ the low four bits, MU_QUIET added, for the top four bits + 1 frames.
\ Each ends silent, and stays there.
MACRO MU_ENV att, frames
    ASSERT att < 16 AND frames >= 1 AND frames <= 16
    IF att + MU_QUIET < 15
        EQUB (frames - 1) * 16 + att + MU_QUIET
    ELSE
        EQUB (frames - 1) * 16 + 15
    ENDIF
ENDMACRO
.mu_envs
    MU_ENV 15, 1                    ; (silent: before a voice's first note)
.mu_chime
    MU_ENV 0, 2 : MU_ENV 2, 1 : MU_ENV 3, 2 : MU_ENV 4, 3 : MU_ENV 5, 4
    MU_ENV 6, 6 : MU_ENV 7, 8 : MU_ENV 8, 10 : MU_ENV 9, 12 : MU_ENV 10, 14
    MU_ENV 11, 16 : MU_ENV 12, 16 : MU_ENV 13, 16 : MU_ENV 14, 16 : MU_ENV 15, 1
.mu_flute
    MU_ENV 9, 1 : MU_ENV 7, 1 : MU_ENV 6, 1 : MU_ENV 5, 16 : MU_ENV 5, 8
    MU_ENV 6, 12 : MU_ENV 7, 12 : MU_ENV 8, 12 : MU_ENV 9, 12 : MU_ENV 10, 12
    MU_ENV 12, 12 : MU_ENV 15, 1
.mu_pizz
    MU_ENV 1, 2 : MU_ENV 3, 2 : MU_ENV 5, 2 : MU_ENV 7, 2 : MU_ENV 9, 3
    MU_ENV 11, 3 : MU_ENV 13, 3 : MU_ENV 15, 1
.mu_pluck
    MU_ENV 9, 1 : MU_ENV 12, 1 : MU_ENV 15, 1
.mu_envs_end
ASSERT mu_envs_end - mu_envs <= 256

\ The instruments' state (music_init sets it; zero page and LowState are
\ full, and a saved game needn't keep it), and where the music was while
\ the life-lost tune plays.
.mu_pos     SKIP 4                  ; each voice's place in mu_envs
.mu_cnt     SKIP 4                  ; ... and frames more there
.mu_blip    SKIP 1                  ; a bit a voice whose note is an octave up its first frame
.mu_age     SKIP 4                  ; frames into each voice's note, for its vibrato
.mu_tmp     SKIP 1                  ; (mu_strike's)
MU_PLACE = 6                        ; mu_ptr, mu_ret, mu_left, mu_wait
ASSERT mu_wait = mu_ptr + MU_PLACE - 1
.mu_place   SKIP MU_PLACE
.mu_notes   SKIP 3                  ; ... and mu_note

\ The VSync interrupt's (irq.6502, which keeps X): the frame's events,
\ then the envelopes.
.music_tick
{
    LDA mu_on : CMP #MU_ON : BNE out
    LDA mu_busy : BEQ playing
    INC mu_owed
.out
    RTS
.playing
    TYA : PHA
    LDA sysvia_ddra : PHA
    LDA sysvia_ora_nh : PHA
    \ The voices the game's sounds used.
    LDX #3
.dirty
    LDA mu_dirty : AND mu_bits,X : BEQ clean
    JSR mu_voice
.clean
    DEX : BPL dirty
    \ The events due, this frame's and any missed. Each frame first puts
    \ a note that started an octave up the frame before at its own pitch.
.frame
    LDA mu_blip : BEQ blips_done
    LDX #2
.blip
    LDA mu_blip : AND mu_bits,X : BEQ blip_next
    JSR mu_voice
.blip_next
    DEX : BPL blip
.blips_done
    LDA mu_wait : BEQ read
    DEC mu_wait
.frame_done
    LDA mu_owed : BEQ envelopes
    DEC mu_owed
    JMP frame
.read
    JSR mu_byte
    CMP #&C0 : BCS not_note
    \ A note: its voice from the latch byte's channel.
    TAY
    LDA music_latch,Y
    LSR A : LSR A : LSR A : LSR A : LSR A : AND #3 : TAX
    TYA : STA mu_note,X
    JSR mu_strike
    CPX #2 : BNE read
    LDX #3 : JSR mu_strike          ; the bass's pluck
    JMP read
.not_note
    CMP #&FE : BCC wait : BEQ repeat
    \ &FF: from the start again; or the life-lost tune's, past the music's.
    LDA mu_ptr : CMP #LO(music + MU_DEATH + 1)
    LDA mu_ptr+1 : SBC #HI(music + MU_DEATH + 1) : BCS tune_end
    JSR music_init.from_start
    JMP read
.tune_end
    JSR music_resume
    JMP frame_done
.wait
    SBC #&BF                        ; (carry clear) the frames less one
    STA mu_wait
    BCS frame_done                  ; (always: no borrow)
    ZA_UNREACHABLE
.repeat
    \ The bytes at music + (hi lo), len of them, then back here.
    JSR mu_byte : CLC : ADC #LO(music) : PHA
    JSR mu_byte : ADC #HI(music) : PHA      ; (mu_byte keeps the carry)
    JSR mu_byte : STA mu_left
    LDA mu_ptr : STA mu_ret
    LDA mu_ptr+1 : STA mu_ret+1
    PLA : STA mu_ptr+1
    PLA : STA mu_ptr
    JMP read
.envelopes
    \ Each voice a frame on in its envelope, and its volume when that
    \ moves to the next step, until it's silent.
    LDX #3
.voice
    LDA mu_cnt,X : BEQ step
    DEC mu_cnt,X
    JMP next
.step
    LDY mu_pos,X : LDA mu_envs,Y : AND #15 : CMP #15 : BEQ next
    INY : TYA : STA mu_pos,X
    LDA mu_envs,Y : LSR A : LSR A : LSR A : LSR A : STA mu_cnt,X
    CPX #2 : BCC write
    LDA noise_on : BNE next         ; (the train's)
.write
    LDA mu_envs,Y : AND #15 : ORA mu_volreg,X : JSR sound_write
.next
    DEX : BPL voice
    \ The vibrato.
    LDX #2
.vibrato
    LDA mu_bits,X : AND #MU_VIBS : BEQ vib_next
    LDY mu_note,X : BMI vib_next
    LDA mu_age,X : CMP #MU_VIB_DELAY : BCS wobble
    INC mu_age,X
    JMP vib_next
.wobble
    AND #7 : TAY
    INC mu_age,X : BNE aged
    LDA #MU_VIB_DELAY : STA mu_age,X        ; (round again)
.aged
    LDA mu_vib,Y : PHA
    LDY mu_note,X
    LDA music_data,Y : LSR A : LSR A : LSR A    ; a 128th of the divider
    BNE depth
    LDA #1
.depth
    STA mu_tmp
    PLA : BEQ set                   ; (A = 0: at its pitch)
    BPL up
    LDA #0 : SEC : SBC mu_tmp : JMP set
.up
    LDA mu_tmp
.set
    JSR mu_bend
.vib_next
    DEX : BPL vibrato
    \ The port as it was. key_down's (bit 7 an input) wants the keyboard
    \ back on the bus; sound_write's leaves it off.
    PLA : STA sysvia_ora_nh
    PLA : STA sysvia_ddra
    CMP #&7F : BNE port_done
    LDA #3 : STA sysvia_orb
.port_done
    PLA : TAY
    RTS
}

\ The next byte of the tune, from a repeat's bytes while there are any.
\ Keeps X and the carry.
.mu_byte
{
    LDY #0 : LDA (mu_ptr),Y
    INC mu_ptr : BNE same
    INC mu_ptr+1
.same
    LDY mu_left : BEQ done
    DEC mu_left : BNE done
    LDY mu_ret : STY mu_ptr
    LDY mu_ret+1 : STY mu_ptr+1
.done
    RTS
}

\ Voice X's note (the pluck's noise) and volume to the chip, and its
\ mu_dirty and mu_blip bits cleared; but not the bass's or the pluck's
\ while the train's noise is clocked by channel 2. Keeps X.
.mu_voice
{
    CPX #2 : BCC voice
    LDA noise_on : BNE done
.voice
    LDA mu_bits,X : EOR #&FF : PHA
    AND mu_dirty : STA mu_dirty
    PLA : AND mu_blip : STA mu_blip
    CPX #3 : BEQ pluck
    LDY mu_note,X : BMI volume      ; (none yet)
    LDA music_latch,Y : JSR sound_write
    LDY mu_note,X
    LDA music_data,Y : JSR sound_write
    JMP volume
.pluck
    LDA #MU_NOISE : JSR sound_write
.volume
    LDY mu_pos,X : LDA mu_envs,Y : AND #15 : ORA mu_volreg,X : JMP sound_write
.done
    RTS
}

\ Voice X's note to the chip bent by A (signed, a few steps of its
\ divider). Keeps X.
.mu_bend
{
    STA mu_tmp
    LDY mu_note,X
    LDA music_latch,Y : AND #15 : CLC : ADC mu_tmp : PHA
    AND #15 : STA mu_tmp
    LDA music_latch,Y : AND #&F0 : ORA mu_tmp : JSR sound_write
    LDY mu_note,X
    LDA music_data,Y : STA mu_tmp
    \ The low four bits' carry or borrow into the data byte's.
    PLA : CMP #16 : BCC write
    CMP #&80 : BCS down
    INC mu_tmp
    JMP write
.down
    DEC mu_tmp
.write
    LDA mu_tmp : JMP sound_write
}

\ Voice X's note starts: its envelope from the top, and the note to the
\ chip, an octave up for its first frame if the voice's notes start so.
\ Keeps X.
.mu_strike
{
    LDA mu_instr,X : STA mu_pos,X : TAY
    LDA mu_envs,Y : LSR A : LSR A : LSR A : LSR A : STA mu_cnt,X
    INC mu_cnt,X                    ; (this frame's envelopes step it once)
    LDA #0 : STA mu_age,X
    LDA mu_bits,X : AND #MU_BLIPS : BEQ plain
    ORA mu_blip : STA mu_blip
    \ Half the divider: its low bit drops out of the latch byte, and the
    \ data byte's low bit moves into it.
    LDY mu_note,X
    LDA music_data,Y : AND #1 : ASL A : ASL A : ASL A : ASL A : STA mu_tmp
    LDA music_latch,Y : AND #15 : ORA mu_tmp : LSR A : STA mu_tmp
    LDA music_latch,Y : AND #&F0 : ORA mu_tmp : JSR sound_write
    LDY mu_note,X
    LDA music_data,Y : LSR A : JSR sound_write
    JMP mu_voice.volume
.plain
    JMP mu_voice
}

\ The life-lost tune (sound.6502's death_tune): the music's place kept,
\ every voice silent, and the player on to the tune's events (music +
\ MU_DEATH: tools/mkmusic.py), which it plays from the next VSync. They
\ end in an &FF, which puts the music back (music_resume) once the last
\ chord has rung, the game going on meanwhile. A life lost before then
\ plays the tune again, and the place kept is still the music's.
.music_death
{
    INC mu_busy                     ; (the interrupt out until it's set up)
    LDA mu_ptr : CMP #LO(music + MU_DEATH)
    LDA mu_ptr+1 : SBC #HI(music + MU_DEATH) : BCS dying
    LDX #MU_PLACE - 1
.keep
    LDA mu_ptr,X : STA mu_place,X
    DEX : BPL keep
    LDX #2
.keep_notes
    LDA mu_note,X : STA mu_notes,X
    DEX : BPL keep_notes
.dying
    LDA #LO(music + MU_DEATH) : STA mu_ptr
    LDA #HI(music + MU_DEATH) : STA mu_ptr+1
    LDA #0 : STA mu_left : STA mu_wait : STA mu_owed
    JSR mu_silence
    DEC mu_busy
    RTS
}

\ The tune's &FF (music_tick's): the music where it was, after MU_GAP
\ frames of silence, its voices silent until their next notes.
MU_GAP = 15                         ; frames between the tune and the music
.music_resume
{
    LDX #MU_PLACE - 1
.back
    LDA mu_place,X : STA mu_ptr,X
    DEX : BPL back
    LDX #2
.back_notes
    LDA mu_notes,X : STA mu_note,X
    DEX : BPL back_notes
    JSR mu_silence
    LDA mu_wait : CLC : ADC #MU_GAP - 1 : STA mu_wait     ; (this frame the first)
    RTS
}

\ Every voice silent, at mu_envs's silence, nothing owed to the chip.
.mu_silence
{
    JSR music_quiet
    LDX #3
    LDA #0
.voice
    STA mu_pos,X : STA mu_cnt,X
    DEX : BPL voice
    STA mu_blip : STA mu_dirty
    RTS
}

\ Silence the music's voices: the life-lost tune takes them, or M
\ switched it off. (Channel 2 is silent while it clocks the train's noise, too, and
\ the noise channel is the train's.)
.music_quiet
{
    LDA #&9F : JSR sound_write
    LDA #&BF : JSR sound_write
    LDA #&DF : JSR sound_write
    LDA noise_on : BNE done
    LDA #&FF : JMP sound_write
.done
    RTS
}

\ M: the music off, or on again where it was.
.music_switch
{
    LDA mu_on : EOR #MU_ON : STA mu_on
    BMI on
    JMP music_quiet
.on
    LDA #MU_ALL : STA mu_dirty
    RTS
}

\ From the start, every voice silent, and on (sound_init: each time the
\ game is loaded, after the chip is set up for the game's sounds).
.music_init
{
    LDX #3
.voice
    LDA #0 : STA mu_pos,X : STA mu_cnt,X    ; mu_envs's silence
    DEX : BPL voice
    LDA #&FF : STA mu_note : STA mu_note+1 : STA mu_note+2
    LDA #MU_ALL : STA mu_dirty
    LDA #0 : STA mu_wait : STA mu_key : STA mu_owed : STA mu_blip
    LDA #MU_ON : STA mu_on
.from_start
    LDA #LO(music) : STA mu_ptr
    LDA #HI(music) : STA mu_ptr+1
    LDA #0 : STA mu_left
    RTS
}
