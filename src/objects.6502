\ ***************************************************************************
\ Objects ("things"): a transcription of the original's
\ (docs/research/objects.md). 256 things in four parallel arrays: room
\ (bit 7 set: not in the world), row, column, type. 0-&28 are portable,
\ &29-&39 machine parts, &3A-&FF bonus items. Only the round robin's
\ current thing is drawn (every frame) and can be touched. The machine
\ parts and bonus items never move, and only thing_load reads where they
\ are: their rows, columns and types are in their rooms' bodies
\ (tools/mkrecords.py), and only the portable things' rows and columns
\ are kept here (their types never change, and thing_load works them out).
\ ***************************************************************************

t_room = things
t_row  = things + &100
t_col  = t_row + NPORT

\ The thing types (NTYPES, renumbered: tools/mkobjects.py), as three
\ tables a type indexes: ink, kind, and graphic from type 9. Types 0-8,
\ the toy's parts and the toy, show each egg's toy (thing_load). None
\ changes.
ty_ink  = thing_types
ty_kind = ty_ink + NTYPES
ty_gfx  = ty_kind + NTYPES - 9

KIND_FIXED = &40            ; kind bit 6 (with bit 7): a machine part

\ ThingCells (&9A10): load thing X into the current-thing record and toggle
\ its footprint in the cell-type map (&40, &41 the girder, &42 the
\ ladder). The same call places and removes; cell_hit says whether any of
\ its cells was already taken.
.thing_cells
{
    ZA_AUTO2 tp
    ZA_AUTO1 tw
    ZA_AUTO1 th
    ZA_AUTO1 txor
    LDY #0 : STY cell_hit
    \ &40 + 1 for the girder (&25), + 2 for the ladder (&26): thing EOR
    \ &24 when that is under 3 (the bone's 0).
    TXA : EOR #&24 : CMP #3 : BCS other
    TAY
.other
    TYA : ORA #&40 : STA txor
    JSR thing_load
    \ The footprint: h x w cells from the thing's cell.
    LDA o_cell : STA tp
    CLC : LDA o_cell+1 : ADC #HI(type_map) : STA tp+1
    LDY #1 : LDA (o_frame),Y : AND #15 : STA tw    ; (the header's other bits: sprite.6502)
    DEY : LDA (o_frame),Y : AND #7 : STA th
    \ Y = row * 32 + column from tp (h < 8: a byte), from 0.
.each
    LDA (tp),Y : BEQ clear
    STA cell_hit
.clear
    EOR txor : STA (tp),Y
    INY : TYA : AND #31 : CMP tw : BNE each
    TYA : ORA #31 : TAY : INY       ; the next row's first (w < 32)
    DEC th : BNE each
    RTS                             ; (X kept: thing_load keeps it)
}

\ Load thing X's position, ink, graphic and kind into the current-thing
\ record, as &9A10 and &7F01 do. (The original's &9A10 leaves the kind:
\ only touch_thing reads it, for the round robin's pick, which next_object
\ loads after any other load.) The round robin's pointer (o_index, the
\ original's &A400) is the round robin's alone: touching and taking act on
\ that thing, whatever the record last had loaded into it.
.thing_load
{
    CPX #NPORT : BCS fixed
    \ A portable thing's type (tools/mkobjects.py numbers them so): its
    \ number for the toy's parts, 0-7; 8 + thing / 8 for the ingredients
    \ and the baskets, 8-&23; from &24 a table.
    TXA : CMP #8 : BCC port_type
    CMP #&24 : BCS port_table
    LSR A : LSR A : LSR A : ORA #8
    BNE port_type                           ; (always)
.port_table
    LDA port_types - &24,X
.port_type
    STA tl_t
    LDY t_col,X : LDA t_row,X
.place
    JSR row_col_cell
    STA o_cell : STY o_cell+1
    LDY tl_t
    LDA ty_ink,Y : STA o_ink
    LDA ty_kind,Y : STA o_kind
    CPY #9 : BCS table
    \ The toy and its parts (types 0-8) are this egg's toy's: graphic
    \ 4 x the type + egg AND 3 (as egg_init set the original's types).
    TYA : ASL A : ASL A : STA tl_t
    LDA egg : AND #3 : ORA tl_t : TAY
    BPL graphic                             ; (always: 35 at most)
.table
    LDA ty_gfx,Y : TAY                      ; its graphic
.graphic
    LDA object_lo,Y : STA o_frame
    \ Its high byte: objgfx's, + 1 for each of its next pages that starts
    \ at or below this graphic (data/objects.6502: they are in order).
    LDA #HI(objgfx)
FOR page = 0..4
    CPY #OBJ_PAGES[page] : ADC #0           ; (+ C: never past 255, so C clear)
NEXT
    STA o_frame+1
    \ Selected: o_sel non-zero (the original: the attribute's high byte),
    \ as the graphic's high byte is.
    ASSERT HI(objgfx) <> 0
    STA o_sel
    RTS
.fixed
    \ A thing that never moves, so in this room (the round robin found it
    \ here): its type, row and column in the body, by its place among the
    \ room's (room_load's room_fixed).
    LDY #&FF : TXA
.find
    INY : CMP room_fixed,Y : BNE find   ; (it's there)
    STY tl_t : TYA : ASL A : ADC tl_t       ; 3 * its place (carry clear)
    ADC rb_things : TAY
    LDA (rb),Y : STA tl_t                   ; type
    INY : LDA (rb),Y : PHA                  ; row
    INY : LDA (rb),Y : TAY                  ; column
    PLA
    BCC place                       ; (always: the body's offsets are bytes)
}

\ The cell at row A, column Y: its low byte in A, its high byte in Y, and
\ both in `cell` (rooms.6502's), which three of the six callers want. X is
\ kept.
.row_col_cell
    STY cell                        ; (the column, for now)
    PHA
    LSR A : LSR A : LSR A : TAY : STY cell+1
    PLA
    ASL A : ASL A : ASL A : ASL A : ASL A
    ORA cell : STA cell
    RTS

\ RoomThings (&99F6): on entering a room, mark the footprints of the
\ portable things in it; select none. Nothing is drawn yet.
.room_things
{
    LDX #&28                        ; (the footprints EOR: any order)
.loop
    LDA t_room,X : CMP room : BNE next
    JSR thing_cells
.next
    DEX : BPL loop
    INX : STX o_sel                 ; (X = 0)
    RTS
}

\ NextObject (&7F01): the round robin. Look at up to 128 things after the
\ last one for the next in this room; it becomes the current thing.
.next_object
{
    LDX o_index
    LDA room
    LDY #128 / 4                    ; four a time: this runs twice a pass
.loop
    INX : CMP t_room,X : BEQ found
    INX : CMP t_room,X : BEQ found
    INX : CMP t_room,X : BEQ found
    INX : CMP t_room,X : BEQ found
    DEY : BNE loop
    STY o_sel                       ; (Y = 0) none
    STX o_index
    RTS
.found
    STX o_index
    JMP thing_load
}

\ PowerOn (&9606): the generator on; and the restart point is moved.
.power_on
{
    LSR factory : SEC : ROL factory         ; bit 0 on
    LDX #&34 : LDY #&37 : JSR power_signs
    \ The restart record (&962F): room 115, row 21, column 30, facing
    \ left, walking. (Before the checks, which don't read it.)
    LDX #CHECKPOINT_VARS
.copy
    LDA power_restart,X : STA checkpoint,X
    DEX : BPL copy
    JSR toy_check
    JMP egg_check
}
\ In save_checkpoint's layout: h_cell..h_frame, then the room.
.power_restart
    EQUW 21 * 32 + 30
    EQUB 0, 0, 0, 0, 4, 0, 1, 0, 0  ; yf xf dx dy face mom state cnt fall
    EQUW harry_gfx                  ; frame 0 (&DFA4 - 2)
    EQUB 115

\ Fixed things (&95F0): the power lever and the LIFT sign.
.fixed_thing
{
    \ (The original: kind AND 7, 1 the lever, 2 the LIFT sign. The fixed
    \ kinds are &C0-&C2: bit 0 the lever, bit 1 the sign.)
    LDA o_kind : LSR A : BCS lever
    LSR A : BCC touch_thing.done
    \ The LIFT sign (&9663): OUT OF ORDER instead, for the rest of the egg.
    \ (Thing &39, the only one of its kind; OUT OF ORDER is &39 - 3.)
    LDX o_index : JSR thing_off
    LDX #&36 : JSR thing_on
    JMP erase_object
.lever
    \ (&95FF) Jumped across from the left: on; from the right: off.
    LDA h_dx : BPL power_on
    \ (&9649)
    LSR factory : ASL factory               ; bit 0 off
    LDX #&37 : LDY #&34 : JSR power_signs
    JMP train_reset
}

\ Harry touched the current thing (&9515).
.touch_thing
{
    BIT o_kind : BPL bonus
    BVS fixed_thing                         ; (KIND_FIXED, bit 6)
\ Take (&956B)
    BIT ctrl : BVC done                     ; TAKE held
    LDA take_latch : BNE done
    LDX o_index
    CPX #&25 : BEQ done                     ; the girder is never taken
    CPX #&26 : BNE not_ladder
    LDA h_state : CMP #1 : BNE done         ; the ladder: standing only
.not_ladder
    LDA carried : BMI hands_empty
    CMP #&24 : BCS done                     ; hands full: only a basket...
    TXA : LSR A : LSR A : LSR A : TAX       ; (the thing's group)
    ORA #&20 : CMP carried : BNE done       ; ... of the thing's group
    INC in_basket,X
    BNE out_of_world                        ; (always: at most 8)
.hands_empty
    STX carried
    CPX #&27 : BNE not_toy
    LDA factory : AND #&F7 : STA factory    ; the toy off the egg maker
.not_toy
    \ Its name: kind AND 15, + 1 (portable kinds are &80-&89).
    LDA o_kind : SEC : SBC #&7F : JSR set_carrying
    LDY #0 : LDA (o_frame),Y : AND #7 : STA carried_h
.out_of_world
    LDX o_index : JSR thing_off
    JSR thing_cells
    JSR erase_object
    LDA #10 : STA take_latch
.done
    RTS
.bonus
    \ A bonus item: kind x 100 x egg points, plus random tens and units.
    LDX o_index : JSR thing_off             ; gone for this egg
    \ (The original adds the thousand and the hundreds egg times over;
    \ adding each egg times is the same sum.)
    LDA o_kind
    CMP #10 : BCC hundreds
    SBC #10 : PHA
    LDA #1 : LDX #6 : JSR times_egg         ; a thousand
    PLA
.hundreds
    LDX #7 : JSR times_egg
    LDX #8
.random
    JSR rng : AND #7 : JSR add_score        ; (both keep X)
    INX : CPX #10 : BNE random
    \ Fall into erase_object.
}
\ Erase the current thing where it is (&884D then &7FC9).
.erase_object
    LDX #o_cell
\ Draw or erase the sprite whose record is at X in zero page (memory.6502):
\ cell (2), yf, frame (2), and to draw, the ink.
.sp_erase_at
    JSR sp_record
    JMP erase_image
\ Draw the current thing (the original's interrupt ORs it on every frame).
.draw_object
    LDA o_sel : BEQ sp_record_done
    LDX #o_cell
    \ Fall into sp_draw_at.
.sp_draw_at
    LDA 5,X
\ ... in Spectrum colour A.
.sp_draw_ink
    STA sp_ink
    JSR sp_record
    JMP draw_sprite
.sp_record
    LDA 0,X : STA sp_cell
    LDA 1,X : STA sp_cell+1
    LDA 2,X : STA sp_yf
    LDA 3,X : STA sp_frame
    LDA 4,X : STA sp_frame+1
.sp_record_done
    RTS


\ The power's signs: things X and X+1 into the world, Y and Y+1 out of it.
.power_signs
    JSR thing_on : INX : JSR thing_on
    TYA : TAX
    JSR thing_off : INX
    \ Fall into thing_off.
\ Thing X out of the world (its room's bit 7 set), or into it. A, X, Y
\ kept.
.thing_off
    ASL t_room,X : SEC : ROR t_room,X
    RTS
.thing_on
    ASL t_room,X : LSR t_room,X
    RTS


\ The girder back to its start, the gap open (&9934; and a death, &8A29).
GIRDER_ROW = 13
GIRDER_COL = 10
.girder_home
    LDA factory : AND #&FB : STA factory
    LDX #GIRDER_ROW : LDY #GIRDER_COL
\ The girder at row X, column Y.
.girder_at
    STX t_row+&25 : STY t_col+&25
    RTS

\ Girder (&9934): in room 96, standing on it with empty hands, TAKE swings
\ it between the floor and the gap; Harry falls.
.girder
{
    LDA room : CMP #96 : BNE drop.done
    LDY #&40 : LDA (hptr),Y : CMP #&41 : BNE drop.done  ; under the left foot
    LDX #&25 : JSR thing_cells
    JSR erase_object
    LDA #0 : STA h_state : STA h_fall
    LDA factory : EOR #4 : STA factory      ; factory bit 2: across the gap
    LDX #GIRDER_ROW : LDY #GIRDER_COL       ; back (its start, the bit
    AND #4 : BEQ place                      ; just cleared)
    LDX #14 : LDY #19                       ; across
.place
    JSR girder_at
    LDX #&25 : JMP thing_cells
}

\ Drop (&96B1), twice a pass after the contact test. With empty hands,
\ the girder (&9934).
.drop
{
    \ One take or drop a press: TAKE released clears the latch.
    BIT ctrl : BVS held
    LDA #0 : STA take_latch
.done
    RTS
.held
    LDA take_latch : BNE done
    LDA f_thing : BPL done                  ; something is still falling
    LDA h_state : CMP #1 : BNE done         ; Harry must be standing
    LDX carried : BMI girder
    STX drop_x
    \ Tried at Harry's feet, the old place kept for a refusal (on the
    \ stack).
    LDA t_row,X : PHA
    LDA t_col,X : PHA
    \ Its column: Harry's left column facing left, his right facing right;
    \ its bottom level with his feet.
    LDA h_cell : AND #31
    LDY h_face : BNE left
    \ + his width - 1 (carry set: h_state's CMP; his frames are whole,
    \ decision 26, so the width byte is the width)
    INY : ADC (h_frame),Y : SBC #1
.left
    STA t_col,X
    LDA h_cell : LDX h_cell+1 : JSR cell_row    ; Harry's top row
    \ + h - 1 = his bottom row (h = 2), - the thing's height + 1
    CLC : ADC #3 : SBC carried_h
    LDX drop_x : STA t_row,X
    JSR thing_cells
    LDA cell_hit : BNE refused
    PLA : PLA                               ; (the old place not needed)
    LDA room : STA t_room,X                 ; in the world
    LDA #10 : STA take_latch
    LDA #&FF : STA carried
    LDA #0 : JSR set_carrying
    LDX drop_x
    CPX #&27 : BEQ toy_placed
    \ Gravity exists only for hoppers: the cell under its left column must
    \ be empty, the column 9-23, the room and the thing a match.
    LDX #o_cell : JSR under_record : BNE no_fall
    LDX drop_x
    LDA o_cell : AND #31
    SBC #9 - 1 : CMP #24 - 9 : BCS no_fall  ; 9-23 (under_record: carry clear)
    \ The hopper of its group (thing >> 3: 0 toy parts, 1-3 the
    \ ingredients) or of its basket (&20 + the group), in this room. (The
    \ original finds the room's hopper and compares both.)
    TXA : CMP #&20 : BCS basket
    LSR A : LSR A : LSR A
.basket
    AND #&1F : CMP #4 : BCS no_fall         ; (the bone, the ladder, the egg)
    TAY : LDA hopper_rooms,Y : CMP room : BNE no_fall
    \ (&9796) Out of the world, its footprint lifted; it falls 2 lines a
    \ call from where it is: the current-thing record (cell, yf 0, frame,
    \ ink), as the original copies it.
    STX f_thing
    JSR thing_off
    JSR thing_cells
    LDX #5
.copy
    LDA o_cell,X : STA f_cell,X
    DEX : BPL copy
.no_fall
    RTS
.toy_placed
    \ ToyPlaced (&985B): the toy dropped in room 48 with Harry at column 16
    \ or right.
    LDA room : CMP #48 : BNE no_fall
    LDA h_cell : AND #31 : CMP #16 : BCC no_fall
    LDA factory : ORA #8 : STA factory
    JMP egg_check
.refused
    \ Something there. Take the footprint back; still carried, where it was.
    JSR thing_cells
    PLA : STA t_col,X
    PLA : STA t_row,X
    RTS
}
\ (The hoppers' rooms, hopper_rooms, are in the tile font's spare room:
\ main.6502.)

\ The type of the cell under the bottom-left of the sprite record at X in
\ zero page (its height, at most 5, rows below); Z set if it is empty.
.under_record
{
    ZA_AUTO2 p
    LDA (3,X)                               ; the height (the shifts drop
    ASL A : ASL A : ASL A : ASL A : ASL A   ; the header's other bits: sprite.6502)
    TAY                                     ; rows below the cell
    CLC : LDA 0,X : STA p
    LDA 1,X : ADC #HI(type_map) : STA p+1   ; (the carry left clear)
    LDA (p),Y
    RTS
}

\ Falling (&97BA), twice a pass: 2 lines down a call until the cell under
\ its left column is taken, then delivered.
.falling
{
    LDA f_thing : BMI done
    LDX #f_cell
    LDA f_yf : BNE step_down
    \ On a cell boundary: is the cell under it taken?
    JSR under_record : BNE land
.step_down
    \ Erase it, step down 2 lines, draw it (the original saves where it was
    \ to erase it after the step: the same erase, then the same draw).
    JSR sp_erase_at
    LDA f_yf : CLC : ADC #2 : AND #7 : STA f_yf
    BNE same_cell
    LDA f_cell : ADC #32 : STA f_cell       ; (carry clear from 6 + 2)
    BCC same_cell
    INC f_cell+1
.same_cell
    LDX #f_cell : JMP sp_draw_at
.land
    JSR sp_erase_at                 ; where it is
    LDA f_thing : JSR deliver
    LDA #&FF : STA f_thing
.done
    RTS
}

\ Deliver (&97FA) thing A into its hopper.
.deliver
{
    TAX                                 ; (for part_delivered)
    CMP #&20 : BCC single
    BEQ toy_basket
    \ A basket (&21-&23): its contents.
    AND #3 : TAY
    LDA in_basket,Y
    BCS count                           ; (always: C from the compare)
.single
    LSR A : LSR A : LSR A : TAY         ; 0 a toy part, 1-3 an ingredient
    BEQ toy_basket.part_delivered
    LDA #1
.count
    CLC : ADC delivered,Y : STA delivered,Y
    CMP #8 : BNE falling.done           ; exactly 8
    TYA : ORA #&30 : TAX : JSR thing_on ; FULL! (&31-&33)
    LDA #&10                            ; vat bits 5, 6, 7
.shift
    ASL A : DEY : BNE shift
    ORA factory : STA factory
    LDA #1 : JSR reward                 ; 10,000 a time
    JMP egg_check
}

\ ToyBasket (&9883): every part in the basket's light comes on, and they
\ are counted; PartDelivered (&9872): its light comes on, and one more.
.toy_basket
{
    LDX #7
.loop
    LDA t_room,X : BPL next
    ASL t_room+&29,X : LSR t_room+&29,X
.next
    DEX : BPL loop
    CLC : LDA in_basket
    BCC add                             ; (always)
.part_delivered
    ASL t_room+&29,X : LSR t_room+&29,X ; (X the part, from deliver)
    LDA #1                              ; (C clear: the LSR's bit 0 was the ASL's 0)
.add
    ADC delivered : STA delivered
    \ Fall into toy_check.
}
\ ToyCheck (&989E): with power and all eight parts, the toy.
.toy_check
{
    LDA factory : AND #3 : CMP #1 : BNE wipe_lights.done    ; power on, no toy yet
    LDA delivered : CMP #8 : BNE wipe_lights.done
    LDX #&30
.lights
    JSR thing_off                       ; the parts' lights, &29-&30
    DEX : CPX #&29 : BCS lights
    DEX : JSR thing_on                  ; THE TOY! (&27)
    INC factory : INC factory           ; bit 1 on (bits 0-1 were 01)
    LDA #2 : JSR reward                 ; 20,000 a time
    LDA room : CMP #95 : BNE wipe_lights.done
    \ Fall into wipe_lights.
}


\ The toy maker's lights wiped when the toy is made in front of you (the
\ original prints spaces in black over them, {AT 21,9}..{AT 22,9}). Black
\ is room 95's paper, logical 0 in every band of its (src/data/rooms.6502,
\ bands.6502), so the cells are cleared to zero.
.wipe_lights
{
    LDA #0 : LDX #4 * 16 - 1
.loop
    STA screen + 16 * (21 * 32 + 9),X
    STA screen + 16 * (22 * 32 + 9),X
    DEX : BPL loop
.done
    RTS
}

\ EggCheck (&98F2): power, toy made and placed, three vats: the egg.
.egg_check
{
    LDA factory : ORA #4 : CMP #&EF : BNE wipe_lights.done
    LDX #&28 : JSR thing_on             ; THE EGG!
    LDA factory : ORA #&10 : STA factory
    DEX : JSR thing_off                 ; the toy (&27) is used up
    LDA #2 : JSR reward
    LDA room : CMP #48 : BNE wipe_lights.done
    LDX #&27 : JSR thing_cells          ; the toy's footprint and picture go
    JMP erase_object
}

\ (set_carrying, add_score, reward and extra_life are in status.6502,
\ falling into what they draw.)

\ Add A to score digit X, egg times. X kept.
.times_egg
{
    ZA_AUTO1 n
    ZA_AUTO1 value
    STA value
    LDA egg : STA n
.loop
    LDA value : JSR add_score       ; (which keeps X)
    DEC n : BNE loop
    RTS
}

\ EggInit (&9A80): every new egg, the factory back as it was.
.egg_init
{
    \ The portable things back where they start: their rooms, and their
    \ rows and columns (thing_init's, as t_row's and t_col's, one after
    \ the other).
    ASSERT t_col = t_row + NPORT
    LDX #2 * NPORT - 1
.init
    LDA thing_init + NPORT,X : STA t_row,X
    CPX #NPORT : BCS no_room
    LDA thing_init,X : STA t_room,X
.no_room
    DEX : BPL init
    \ In the world: 0-&26 and &37-&FF; out: &27-&36. (X from &FF down to
    \ 1: thing 0's room is thing_init's, in the world.)
.world
    ASL t_room,X
    TXA : SEC : SBC #&37 : CMP #&F0 ; C set: &27-&36, out
    ROR t_room,X
    DEX : BNE world
    LDA #&FF : STA carried : STA f_thing
    \ Every room's visit bonus again; factory, take_latch, delivered and
    \ in_basket zeroed.
    ASSERT in_basket + 3 - factory < 16
    LDX #15 : LDA #0
.zero
    STA visited,X
    CPX #in_basket + 4 - factory : BCS visit_only
    STA factory,X
.visit_only
    DEX : BPL zero
    STA dog_sat                 ; the running dog, not the sitting one
    JSR set_carrying            ; NOTHING
    \ More monsters each egg: entries 1 .. min(130 + 25 * egg, 255).
    LDX egg : LDA #&82 : CLC    ; (egg is at least 1)
.add
    ADC #&19 : BCS max          ; (from egg 6)
    DEX : BNE add
    BEQ limit                   ; (always)
.max
    LDA #255
.limit
    STA mon_limit               ; the last entry on (setup_monsters)
    LDA #4 : STA truck_strip    ; (&9AF5)
    \ (This egg's toy, &9B08's graphics for types 0-8: thing_load works
    \ them out from egg.)
    \ Fall into train_reset.
}
\ The train back to its start (&9AFD).
.train_reset
    LDA #74 : STA train_room
    LDA #6 : STA train_pos
    RTS
\ (port_types is in data/objects.6502.)
