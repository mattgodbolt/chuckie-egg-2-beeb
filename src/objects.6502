\ ***************************************************************************
\ Objects ("things"): a transcription of the original's
\ (docs/research/objects.md). 256 things in four parallel arrays: room
\ (bit 7 set: not in the world), row, column, type. 0-&28 are portable,
\ &29-&39 machine parts, &3A-&FF bonus items. Only the round robin's
\ current thing is drawn (every frame) and can be touched.
\ ***************************************************************************

t_room = things
t_row  = things + &100
t_col  = things + &200
t_type = things + &300

KIND_FIXED = &40            ; kind bit 6 (with bit 7): a machine part

\ ThingCells (&9A10): load thing X into the current-thing record and toggle
\ its footprint in the cell-type map (&40, &41 the girder, &42 the
\ ladder). The same call places and removes; cell_hit says whether any of
\ its cells was already taken.
.thing_cells
{
    ZA_AUTO2 tp
    ZA_AUTO1 tw
    ZA_AUTO1 th
    ZA_AUTO1 txor
    STX tc_x
    LDA #0 : STA cell_hit
    LDY #&40
    CPX #&26 : BNE not_ladder
    LDY #&42
.not_ladder
    CPX #&25 : BNE not_girder
    LDY #&41
.not_girder
    STY txor
    JSR thing_load
    \ The footprint: h x w cells from the thing's cell.
    LDA o_cell : STA tp
    CLC : LDA o_cell+1 : ADC #HI(type_map) : STA tp+1
    LDY #0 : LDA (o_frame),Y : STA th
    INY : LDA (o_frame),Y : STA tw
.row
    LDY #0
.col
    LDA (tp),Y : BEQ clear
    STA cell_hit
.clear
    EOR txor : STA (tp),Y
    INY : CPY tw : BNE col
    CLC : LDA tp : ADC #32 : STA tp
    BCC no_carry
    INC tp+1
.no_carry
    DEC th : BNE row
    LDX tc_x
    RTS
}

\ Load thing X's position, ink and graphic into the current-thing record,
\ as &9A10 and &7F01 do. The round robin's pointer (o_index, the
\ original's &A400) is the round robin's alone: touching and taking act on
\ that thing, whatever the record last had loaded into it.
.thing_load
{
    LDY t_col,X : LDA t_row,X : JSR row_col_cell
    STA o_cell : STY o_cell+1
    LDA #1 : STA o_sel              ; (the original: the attribute's high byte)
    LDA t_type,X : STA tl_t : ASL A : CLC : ADC tl_t : TAY
    LDA thing_types,Y : STA o_ink
    LDA thing_types+2,Y : STA tl_kind
    LDA thing_types+1,Y : ASL A : TAY       ; its graphic
    LDA object_frames,Y : STA o_frame
    LDA object_frames+1,Y : STA o_frame+1
    RTS
}

\ The cell at row A, column Y: its low byte in A, its high byte in Y. X is
\ kept.
.row_col_cell
{
    ZA_AUTO1 col
    STY col
    PHA
    LSR A : LSR A : LSR A : TAY
    PLA
    ASL A : ASL A : ASL A : ASL A : ASL A
    ORA col
    RTS
}

\ RoomThings (&99F6): on entering a room, mark the footprints of the
\ portable things in it; select none. Nothing is drawn yet.
.room_things
{
    LDX #0
.loop
    LDA t_room,X : CMP room : BNE next
    JSR thing_cells
.next
    INX : CPX #&29 : BNE loop
    LDA #0 : STA o_sel
    RTS
}

\ NextObject (&7F01): the round robin. Look at up to 128 things after the
\ last one for the next in this room; it becomes the current thing.
.next_object
{
    LDX o_index
    LDY #128
.loop
    INX
    LDA t_room,X : CMP room : BEQ found
    DEY : BNE loop
    STX o_index
    LDA #0 : STA o_sel
    RTS
.found
    STX o_index
    JSR thing_load
    LDA tl_kind : STA o_kind
    RTS
}

\ Draw the current thing (the original's interrupt ORs it on every frame).
.draw_object
{
    LDA o_sel : BEQ none
    LDX #o_cell : JMP sp_draw_at
.none
    RTS
}

\ Erase the current thing where it is (&884D then &7FC9).
.erase_object
    LDX #o_cell : JMP sp_erase_at

\ Draw or erase the sprite whose record is at X in zero page (memory.6502):
\ cell (2), yf, frame (2), and to draw, the ink.
.sp_draw_at
    LDA 5,X
\ ... in Spectrum colour A.
.sp_draw_ink
    STA sp_ink
    JSR sp_record
    JMP draw_sprite
.sp_erase_at
    JSR sp_record
    JMP erase_image
.sp_record
    LDA 0,X : STA sp_cell
    LDA 1,X : STA sp_cell+1
    LDA 2,X : STA sp_yf
    LDA 3,X : STA sp_frame
    LDA 4,X : STA sp_frame+1
    RTS

\ PowerOn (&9606): the generator on; and the restart point is moved.
.power_on
{
    LDA factory : ORA #1 : STA factory
    LDX #&34 : LDY #&37 : JSR power_signs
    JSR toy_check
    JSR egg_check
    \ The restart record (&962F): room 115, row 21, column 30, facing
    \ left, walking.
    LDX #CHECKPOINT_VARS
.copy
    LDA power_restart,X : STA checkpoint,X
    DEX : BPL copy
    RTS
}
\ In save_checkpoint's layout: h_cell..h_frame, then the room.
.power_restart
    EQUW 21 * 32 + 30
    EQUB 0, 0, 0, 0, 4, 0, 1, 0, 0  ; yf xf dx dy face mom state cnt fall
    EQUW sprites                    ; frame 0 (&DFA4 - 2)
    EQUB 115

\ Fixed things (&95F0): the power lever and the LIFT sign.
.fixed_thing
{
    LDA o_kind : AND #7
    CMP #1 : BEQ lever
    CMP #2 : BNE done
    \ The LIFT sign (&9663): OUT OF ORDER instead, for the rest of the egg.
    LDX o_index : JSR thing_off
    DEX : DEX : DEX : JSR thing_on
    JMP erase_object
.lever
    \ (&95FF) Jumped across from the left: on; from the right: off.
    LDA h_dx : BPL power_on
    \ (&9649)
    LDA factory : AND #&FE : STA factory
    LDX #&37 : LDY #&34 : JSR power_signs
    JMP train_reset
.done
    RTS
}

\ Harry touched the current thing (&9515).
.touch_thing
{
    LDA o_kind : BPL bonus
    AND #KIND_FIXED : BNE fixed_thing
\ Take (&956B)
    BIT ctrl : BVC done                     ; TAKE held
    LDA take_latch : BNE done
    LDX o_index
    CPX #&25 : BEQ done                     ; the girder is never taken
    CPX #&26 : BNE not_ladder
    LDA h_state : CMP #1 : BNE done         ; the ladder: standing only
.not_ladder
    LDA carried : BMI hands_empty
    CMP #&24 : BCS done                     ; hands full: only a basket...
    TXA : LSR A : LSR A : LSR A : TAY       ; (the thing's group)
    ORA #&20 : CMP carried : BNE done       ; ... of the thing's group
    LDA in_basket,Y : CLC : ADC #1 : STA in_basket,Y
    JMP out_of_world
.hands_empty
    LDA o_kind : AND #15 : CLC : ADC #1 : JSR set_carrying
    LDX o_index : STX carried
    LDY #0 : LDA (o_frame),Y : STA carried_h
    CPX #&27 : BNE out_of_world
    LDA factory : AND #&F7 : STA factory    ; the toy off the egg maker
.out_of_world
    LDX o_index : JSR thing_off
    JSR thing_cells
    JSR erase_object
    LDA #10 : STA take_latch
.done
    RTS
.bonus
    \ A bonus item: kind x 100 x egg points, plus random tens and units.
    LDX o_index : JSR thing_off             ; gone for this egg
    LDA egg : STA bonus_n
.score_loop
    LDA o_kind
    CMP #10 : BCC hundreds
    SBC #10 : PHA
    LDA #1 : LDX #6 : JSR add_score         ; a thousand
    PLA
.hundreds
    LDX #7 : JSR add_score
    DEC bonus_n : BNE score_loop
    JSR rng : AND #7 : LDX #8 : JSR add_score
    JSR rng : AND #7 : LDX #9 : JSR add_score
    JMP erase_object
}

\ The power's signs: things X and X+1 into the world, Y and Y+1 out of it.
.power_signs
    JSR thing_on : INX : JSR thing_on
    TYA : TAX
    JSR thing_off : INX
    \ Fall into thing_off.
\ Thing X out of the world (its room's bit 7 set), or into it. X, Y kept.
.thing_off
    LDA t_room,X : ORA #&80 : STA t_room,X
    RTS
.thing_on
    LDA t_room,X : AND #&7F : STA t_room,X
    RTS

\ The train back to its start (&9AFD).
.train_reset
    LDA #74 : STA train_room
    LDA #6 : STA train_pos
    RTS

\ The girder back to its start, the gap open (&9934; and a death, &8A29).
.girder_home
    LDA #13 : STA t_row+&25 : LDA #10 : STA t_col+&25
    LDA factory : AND #&FB : STA factory
    RTS

\ Girder (&9934): in room 96, standing on it with empty hands, TAKE swings
\ it between the floor and the gap; Harry falls.
.girder
{
    LDA room : CMP #96 : BNE done
    LDY #&40 : LDA (hptr),Y : CMP #&41 : BNE done   ; under the left foot
    LDX #&25 : JSR thing_cells
    JSR erase_object
    LDA #0 : STA h_state : STA h_fall
    LDA factory : EOR #4 : STA factory      ; factory bit 2: across the gap
    AND #4 : BEQ back
    LDA #14 : STA t_row+&25 : LDA #19 : STA t_col+&25
    BNE place                               ; (always)
.back
    JSR girder_home
.place
    LDX #&25 : JMP thing_cells
.done
    RTS
}

\ Drop (&96B1), twice a pass after the contact test. With empty hands,
\ the girder (&9934).
.drop
{
    \ One take or drop a press: TAKE released clears the latch.
    BIT ctrl : BVS held
    LDA #0 : STA take_latch
.done
    RTS
.held
    LDA take_latch : BNE done
    LDA f_thing : BPL done                  ; something is still falling
    LDA h_state : CMP #1 : BNE done         ; Harry must be standing
    LDX carried : BMI girder
    STX drop_x
    \ Its column: Harry's left column facing left, his right facing right;
    \ its bottom level with his feet.
    LDA h_cell : AND #31 : STA drop_col
    LDA h_face : BNE left
    LDY #1 : LDA (h_frame),Y
    CLC : ADC drop_col : STA drop_col : DEC drop_col
.left
    LDA h_cell : LSR A : LSR A : LSR A : LSR A : LSR A : STA drop_row
    LDA h_cell+1 : ASL A : ASL A : ASL A : ORA drop_row  ; Harry's top row
    \ + h - 1 = his bottom row (h = 2), - the thing's height + 1
    CLC : ADC #2 : SEC : SBC carried_h : STA drop_row
    JSR swap_place                          ; tried there, the old place kept
    JSR thing_cells
    LDA cell_hit : BNE refused
    LDA room : STA t_room,X                 ; in the world
    LDA #10 : STA take_latch
    LDA #&FF : STA carried
    LDA #0 : JSR set_carrying
    LDX drop_x
    CPX #&27 : BNE not_toy
    JMP toy_placed
.not_toy
    \ Gravity exists only for hoppers: the cell under its left column must
    \ be empty, the column 9-23, the room and the thing a match.
    LDX #o_cell : JSR under_record : BNE no_fall
    LDX drop_x
    LDA o_cell : AND #31
    CMP #9 : BCC no_fall
    CMP #24 : BCS no_fall
    LDY #3
.find
    LDA hopper_rooms,Y : CMP room : BEQ hopper
    DEY : BPL find
.no_fall
    RTS
.hopper
    TYA : ORA #&20 : STA drop_g
    CPX drop_g : BEQ falls                  ; its basket (&20 + Y)
    TXA : LSR A : LSR A : LSR A : STA drop_g
    CPY drop_g : BEQ falls                  ; or one of its group (Y)
    RTS
.falls
    \ (&9796) Out of the world, its footprint lifted; it falls 2 lines a
    \ call from where it is: the current-thing record (cell, yf 0, frame,
    \ ink), as the original copies it.
    STX f_thing
    JSR thing_off
    JSR thing_cells
    LDX #5
.copy
    LDA o_cell,X : STA f_cell,X
    DEX : BPL copy
    RTS
.refused
    \ Something there. Take the footprint back; still carried.
    JSR thing_cells
    \ Fall into swap_place.
.swap_place
    \ The thing's row and column swapped with drop_row and drop_col.
    LDA t_row,X : LDY drop_row : STA drop_row : TYA : STA t_row,X
    LDA t_col,X : LDY drop_col : STA drop_col : TYA : STA t_col,X
    RTS
}
\ The hoppers' rooms: the toy parts' (basket &20), the milk's, the
\ cocoa's, the sugar's.
.hopper_rooms
    EQUB 95, 33, 51, 110

\ The type of the cell under the bottom-left of the sprite record at X in
\ zero page (its height, at most 5, rows below); Z set if it is empty.
.under_record
{
    ZA_AUTO2 p
    LDA 3,X : STA p
    LDA 4,X : STA p+1
    LDY #0 : LDA (p),Y                      ; the height
    ASL A : ASL A : ASL A : ASL A : ASL A
    CLC : ADC 0,X : STA p
    LDA 1,X : ADC #HI(type_map) : STA p+1
    LDA (p),Y
    RTS
}

\ Falling (&97BA), twice a pass: 2 lines down a call until the cell under
\ its left column is taken, then delivered.
.falling
{
    LDA f_thing : BPL active
    RTS
.active
    LDX #f_cell
    LDA f_yf : BNE step_down
    \ On a cell boundary: is the cell under it taken?
    JSR under_record : BNE land
.step_down
    \ Erase it, step down 2 lines, draw it (the original saves where it was
    \ to erase it after the step: the same erase, then the same draw).
    JSR sp_erase_at
    LDA f_yf : CLC : ADC #2 : AND #7 : STA f_yf
    BNE same_cell
    CLC : LDA f_cell : ADC #32 : STA f_cell
    BCC same_cell
    INC f_cell+1
.same_cell
    LDX #f_cell : JMP sp_draw_at
.land
    JSR sp_erase_at                 ; where it is
    LDA f_thing : JSR deliver       ; (which can read f_thing)
    LDA #&FF : STA f_thing
    RTS
}

\ Deliver (&97FA) thing A into its hopper.
.deliver
{
    CMP #&20 : BCC single
    BEQ toy_basket
    \ A basket (&21-&23): its contents.
    AND #3 : TAY
    LDA in_basket,Y
    BCS count                           ; (always: C from the compare)
.single
    LSR A : LSR A : LSR A : TAY         ; 0 a toy part, 1-3 an ingredient
    BEQ part_delivered
    LDA #1
.count
    CLC : ADC delivered,Y : STA delivered,Y
    CMP #8 : BNE done                   ; exactly 8
    LDA t_room+&30,Y : AND #&7F : STA t_room+&30,Y  ; FULL!
    LDA #&10                            ; vat bits 5, 6, 7
.shift
    ASL A : DEY : BNE shift
    ORA factory : STA factory
    LDA #1 : JSR reward                 ; 10,000 a time
    JMP egg_check
.done
    RTS
}

\ PartDelivered (&9872): its light comes on; ToyBasket (&9883): every part
\ in the basket's.
.part_delivered
    LDX f_thing
    LDA t_room+&29,X : AND #&7F : STA t_room+&29,X
    INC delivered
    JMP toy_check
.toy_basket
{
    LDX #7
.loop
    LDA t_room,X : BPL next
    LDA t_room+&29,X : AND #&7F : STA t_room+&29,X
.next
    DEX : BPL loop
    LDA delivered : CLC : ADC in_basket : STA delivered
    \ Fall into toy_check.
}
\ ToyCheck (&989E): with power and all eight parts, the toy.
.toy_check
{
    LDA factory : AND #3 : CMP #1 : BNE done    ; power on, no toy yet
    LDA delivered : CMP #8 : BNE done
    LDX #7
.lights
    LDA t_room+&29,X : ORA #&80 : STA t_room+&29,X
    DEX : BPL lights
    LDX #&27 : JSR thing_on             ; THE TOY!
    LDA factory : ORA #2 : STA factory
    LDA #2 : JSR reward                 ; 20,000 a time
    LDA room : CMP #95 : BNE done
    JMP wipe_lights
.done
    RTS
}

\ ToyPlaced (&985B): the toy dropped in room 48 with Harry at column 16 or
\ right.
.toy_placed
{
    LDA room : CMP #48 : BNE done
    LDA h_cell : AND #31 : CMP #16 : BCC done
    LDA factory : ORA #8 : STA factory
    JMP egg_check
.done
    RTS
}

\ EggCheck (&98F2): power, toy made and placed, three vats: the egg.
.egg_check
{
    LDA factory : ORA #4 : CMP #&EF : BNE done
    LDX #&28 : JSR thing_on             ; THE EGG!
    LDA factory : ORA #&10 : STA factory
    LDX #&27 : JSR thing_off            ; the toy is used up
    LDA #2 : JSR reward
    LDA room : CMP #48 : BNE done
    LDX #&27 : JSR thing_cells          ; the toy's footprint and picture go
    JMP erase_object
.done
    RTS
}

\ SetCarrying (&9986): the status bar's name, 0 NOTHING to 10 BASKET.
.set_carrying
    STA carrying_name
    JMP draw_carrying

\ AddScore (&A0BD): add A to score digit X, one carry rippled up (lost
\ past digit 0), each changed digit redrawn.
.add_score
{
    CLC : ADC score,X
    CMP #10 : BCC store
    SBC #10 : STA score,X
    CPX #0 : BEQ redraw
    TXA : PHA
    DEX : LDA #1 : JSR add_score    ; (recursive: the digit on the stack)
    PLA : TAX
.redraw
    LDA score,X
.store
    STA score,X
    JMP draw_digit
}

\ Add A to score digit X, egg times.
.times_egg
{
    ZA_AUTO1 n
    ZA_AUTO1 digit
    ZA_AUTO1 value
    STA value : STX digit
    LDA egg : STA n
.loop
    LDA value : LDX digit : JSR add_score
    DEC n : BNE loop
    RTS
}

\ The factory's rewards: A x 10,000 x egg, and a life.
.reward
    LDX #5 : JSR times_egg
    \ Fall into extra_life.
\ ExtraLife (&A2DD): at most 255.
.extra_life
{
    INC lives : BNE ok
    DEC lives
.ok
    JMP draw_lives
}

\ The toy maker's lights wiped when the toy is made in front of you (the
\ original prints spaces in black over them, {AT 21,9}..{AT 22,9}). Black
\ is room 95's paper, logical 0 in every band of its (src/data/rooms.6502,
\ bands.6502), so the cells are cleared to zero.
.wipe_lights
{
    LDA #0 : LDX #4 * 16 - 1
.loop
    STA screen + 16 * (21 * 32 + 9),X
    STA screen + 16 * (22 * 32 + 9),X
    DEX : BPL loop
    RTS
}

\ EggInit (&9A80): every new egg, the factory back as it was.
.egg_init
{
    \ Every room's visit bonus again.
    LDX #120
.visit_reset
    LDA visits,X : AND #&7F : STA visits,X
    DEX : BPL visit_reset
    \ The portable things back where they start.
    LDX #&28
.init
    LDA thing_init,X : STA t_room,X
    LDA thing_init+41,X : STA t_row,X
    LDA thing_init+82,X : STA t_col,X
    DEX : BPL init
    \ In the world: 0-&26 and &37-&FF; out: &27-&36.
    LDX #0
.world
    LDA t_room,X : AND #&7F
    CPX #&27 : BCC set
    CPX #&37 : BCS set
    ORA #&80
.set
    STA t_room,X
    INX : BNE world
    LDA #&FF : STA carried : STA f_thing
    LDA #0
    LDX #in_basket + 3 - factory
.counts
    STA factory,X               ; factory, take_latch, delivered, in_basket
    DEX : BPL counts
    JSR set_carrying            ; NOTHING
    \ More monsters each egg: entries 1 .. min(130 + 25 * egg, 255).
    LDA egg : CMP #5 : BCC few
    LDA #5
.few
    TAX
    LDA #&82
.add
    CLC : ADC #&19 : DEX : BNE add
    STA ei_n                    ; the last entry on
    LDX #0
.monsters
    LDA mon_room,X : AND #&7F
    CPX ei_n : BEQ mset : BCC mset
    ORA #&80
.mset
    STA mon_room,X
    INX : BNE monsters
    LDA mon_room : ORA #&80 : STA mon_room   ; and entry 0 (the sitting dog) off
    LDA #4 : STA truck_strip    ; (&9AF5)
    \ This egg's toy (&9B08): motorbike, car, boat, jet, then again.
    LDA egg : SEC : SBC #1 : AND #3 : TAX
    LDA toy_frames,X
    LDX #0
.gfx
    STA thing_types+1,X
    CLC : ADC #1
    INX : INX : INX : CPX #27 : BNE gfx
    JMP train_reset
.toy_frames
    EQUB &25, &2E, &37, &40     ; each toy's first graphic
}
