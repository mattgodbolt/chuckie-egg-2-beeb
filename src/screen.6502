\ ***************************************************************************
\ The screen: palettes, clearing, and drawing an 8 x 8 tile into a cell in
\ the colours of a Spectrum attribute.
\
\ A cell is 16 bytes (two 4-pixel columns of 8 lines) and a row of 32
\ cells is 512 bytes, so cell n is at screen + 16n: one 16-bit shift.
\ ***************************************************************************

\ The room's colour maps (bands.6502): the logical colour of each Spectrum
\ colour 0-7 (decision 2), for each band of rows (decision 15).

ZA_AUTO2 glyph              ; the tile's 8 bytes
ZA_AUTO1 paper              ; a byte of four paper pixels
ZA_AUTO1 diff               ; ink pixels EOR paper pixels

\ Set the palette and colour maps for room A (1-120).
.set_room_palette
{
    PHA
    \ sb_p = room_palettes + 4 * the palette's number, which is in bits 3-7
    \ of the room's packed first byte (tools/packrooms.py), where setup_bands'
    \ map reader (bands.6502) can read the colour map too.
    JSR room_stream
    LDY #0 : LDA (bp),Y : LSR A : AND #&FC
    CLC : ADC #LO(room_palettes) : STA sb_p
    LDA #HI(room_palettes) : ADC #0 : STA sb_p+1
    \ Logical colours 0-3, a nibble each, low nibble first.
    LDX #3
.logical
    TXA : LSR A : TAY
    LDA (sb_p),Y
    BCC low
    LSR A : LSR A : LSR A : LSR A
.low
    AND #15 : JSR set_logical
    DEX : BPL logical
    \ The colour map, two bits a colour, as a band's.
    LDX #0
    LDY #2 : JSR setup_bands.sb_map
    LDY #3 : JSR setup_bands.sb_map
    PLA : JMP setup_bands
}

\ Logical colour X (0-3) shows physical colour A in the room: fill its four
\ entries of room_ula (irq.6502), which the interrupt writes to the ULA
\ every frame. Entry = l1 n1 l0 n0, n the "neighbour" (irq.6502): beside
\ n = 1 sets value bit 4, beside n = 2 bit 6. Logical 2 and 3 go at 0-7,
\ four each; logical 0 and 1 put their entries beside 2 at 8-9, and beside
\ 0, 1 and 3 (the six the status bar shows) at 10-15, logical 1 first.
\ X is kept.
.set_logical
    EOR #7                      ; the ULA wants the physical colour EOR 7
    ORA logical_bits,X          ; beside colour 0
    LDY beside013,X
    STA room_ula,Y              ; beside 0
    ORA #&10 : STA room_ula+1,Y ; beside 1
    ORA #&40 : STA room_ula+2,Y ; beside 3
    LDY beside2,X
    AND #&EF : STA room_ula,Y   ; beside 2
    RTS
.logical_bits
    EQUB &00, &20, &80, &A0     ; l0 at bit 5, l1 at bit 7
.beside013
    EQUB 13, 10, 0, 4
.beside2
    EQUB 9, 8, 3, 7

\ Fill the whole screen with zero (logical colour 0).
.cls
{
    ZA_AUTO2 p
    LDA #LO(screen) : STA p
    LDA #HI(screen) : STA p+1
    LDY #0 : TYA
.loop
    STA (p),Y
    INY : BNE loop
    INC p+1 : BPL loop
    RTS
}

\ How `cell` looks: glyph = its tile's 8 bytes, paper and diff its colours.
.cell_looks
    JSR cell_glyph
\ paper and diff alone (erase_image wants the glyph only for some cells).
.cell_colours
{
    ZA_AUTO2 ap
    LDA cell : STA ap
    CLC : LDA cell+1 : ADC #HI(attr_map) : STA ap+1
    LDY #0 : LDA (ap),Y
    \ Fall into attr_colours.
}
\ paper and diff for Spectrum attribute A in `cell`'s band.
.attr_colours
    TAY                         ; (cell_band keeps Y)
    JSR cell_band : STX dg_band
    TYA
    LSR A : LSR A : LSR A : AND #7 : ORA dg_band : TAX
    LDA band_cmaps,X
    TAX : LDA colour_bytes,X : STA paper
    TYA : AND #7 : ORA dg_band : TAX
    LDA band_cmaps,X
    TAX : LDA colour_bytes,X : EOR paper : STA diff
    RTS

\ glyph alone: `cell`'s tile's 8 bytes.
.cell_glyph
{
    ZA_AUTO2 mp
    LDA cell : STA mp
    CLC : LDA cell+1 : ADC #HI(tile_map) : STA mp+1
    LDY #0 : LDA (mp),Y
    \ glyph = 8 * the code + its font_lo/hi entry, by its top three bits.
    TAY
    LSR A : LSR A : LSR A : LSR A : LSR A : TAX
    TYA : ASL A : ASL A : ASL A
    CLC : ADC font_lo,X : STA glyph
    LDA font_hi,X : ADC #0 : STA glyph+1
    RTS
}

\ cell_glyph's glyph addresses, by a code's top three bits: 256 * those bits
\ (their share of 8 * the code) plus the font less 8 * its first code. Tiles
\ start at &20; text, bit 7 set, at &A0 in the OS's font (decision 4).
.font_lo
FOR x = 0..3
    EQUB LO(x * 256 + tiles - 8 * &20)
NEXT
FOR x = 4..7
    EQUB LO(x * 256 + text_font - 8 * &A0)
NEXT
.font_hi
FOR x = 0..3
    EQUB HI(x * 256 + tiles - 8 * &20)
NEXT
FOR x = 4..7
    EQUB HI(x * 256 + text_font - 8 * &A0)
NEXT

\ X = 8 * the band of `cell`'s row: the offset of its colour map in
\ band_cmaps.
.cell_band
    LDA cell : LSR A : LSR A : LSR A : LSR A : LSR A
    LDX cell+1 : ORA row_hi,X : TAX         ; the row
    LDA band_off,X : TAX
    RTS

\ A = the row of the cell whose low byte is A and high byte X.
.cell_row
    LSR A : LSR A : LSR A : LSR A : LSR A
    ORA row_hi,X
    RTS
.row_hi
    EQUB 0, 8, 16, 24           ; 8 * a cell's high byte (cells to 1023, as band_off)

\ Draw the 8 bytes at glyph into cell `cell` in the colours of Spectrum
\ attribute A: set bits in its ink, clear ones in its paper.
.draw_glyph
    JSR attr_colours
    \ Fall into draw_glyph_pd.
\ The same with paper and diff already set.
.draw_glyph_pd
{
    ZA_AUTO2 scr
    ZA_AUTO2 scr8
    LDA cell : LDX cell+1 : JSR cell_screen
    STA scr : STY scr+1 : STY scr8+1
    ORA #8 : STA scr8
    LDY #7
.line
    LDA (glyph),Y : STA gbyte
    LSR A : LSR A : LSR A : LSR A : TAX
    LDA spread_lo,X             ; the left four pixels, in both nibbles
    AND diff : EOR paper : STA (scr),Y
    LDA gbyte : AND #15 : TAX
    LDA spread_lo,X             ; the right four
    AND diff : EOR paper : STA (scr8),Y
    DEY : BPL line
    RTS
}

\ The screen address of cell A + 256 * X, screen + 16 * the cell: its low
\ byte in A, its high byte in Y.
.cell_screen
    PHA
    LSR A : LSR A : LSR A : LSR A
    ORA screen_hi,X : TAY
    PLA
    ASL A : ASL A : ASL A : ASL A
    RTS
.screen_hi
    EQUB HI(screen), HI(screen) + &10, HI(screen) + &20, HI(screen) + &30
    ASSERT LO(screen) = 0 AND (HI(screen) AND 15) = 0    ; so the ORA adds

\ (colour_bytes, a byte of four pixels in logical colour 0-3, is in page 2:
\ pages.6502.)

\ A Spectrum nibble (its leftmost pixel in bit 3) spread into both halves
\ of a MODE 1 byte, where a pixel's colour bits are 4 apart. (The top
\ nibble of a byte b is spread_lo[b >> 4].)
.spread_lo
FOR n = 0..15
    EQUB n * &11
NEXT
\ The same with the nibble turned over (its leftmost pixel in bit 0), for
\ drawing a mirror image (sprite.6502's sprite_mode patches it in).
.spread_rev
FOR n = 0..15
    EQUB ((n AND 1) * 8 + (n AND 2) * 2 + (n AND 4) DIV 2 + (n AND 8) DIV 8) * &11
NEXT
\ Which of them sprite.6502 spreads an image's nibbles with: a frame as it
\ is, and turned over. (sprite_mode patches only the low byte.)
.mode_spread
    EQUB LO(spread_lo), LO(spread_rev)
    ASSERT HI(spread_lo) = HI(spread_rev) AND HI(spread_lo) = HI(spread_rev + 15)
