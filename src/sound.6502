\ ***************************************************************************
\ Sound: the original's three (docs/research/frontend.md, section 7) on the
\ SN76489, written directly (decision 11: no OS calls). Channel 0 plays the
\ life-lost tune, channel 1 the movement tick, and the noise channel,
\ clocked by channel 2 at about 150 shifts a second, stands in for the
\ train's random beeper.
\ ***************************************************************************

\ Write A to the sound chip, through the System VIA's slow bus.
.sound_write
{
    LDX #&FF : STX sysvia_ddra
    STA sysvia_ora_nh
    LDX #0 : STX sysvia_orb         ; write enable low
    LDX #3                          ; ... for 8us
.hold
    DEX : BNE hold
    LDX #8 : STX sysvia_orb
    RTS
}

\ Everything silent, the noise set up and channel 2 clocking it, silent.
.sound_init
{
    LDA #0 : STA noise_on
    LDX #sound_init_end - sound_init_bytes - 1
.loop
    STX si_x
    LDA sound_init_bytes,X : JSR sound_write
    LDX si_x : DEX : BPL loop
    RTS
}
\ (sound_init_bytes is in page 1: pages.6502.)

\ Wait Y * 256 + X microseconds on the User VIA's timer 2 (one-shot).
.wait_us
    STX usrvia_t2cl : STY usrvia_t2ch       ; starts it; clears its flag
.wait_t2
    LDA usrvia_ifr : AND #&20 : BEQ wait_t2
    RTS

\ The life-lost tune (&A2EB): 16 notes, 2.16s, everything else frozen.
.death_tune
{
    LDA #&90 : JSR sound_write      ; channel 0 loud
    LDX #0
.note
    STX dt_i
    LDA death_notes,X : JSR sound_write
    LDX dt_i : LDA death_notes+1,X : JSR sound_write
    LDX dt_i : LDA death_notes+2,X : STA dt_n
.hold
    LDX #LO(4000) : LDY #HI(4000) : JSR wait_us
    DEC dt_n : BNE hold
    LDX dt_i : INX : INX : INX : CPX #death_notes_end - death_notes : BNE note
    LDA #&9F : JMP sound_write
}
\ (Its notes, death_notes, are in page 3: pages.6502.)

\ MOVE_SOUND (&92F4): while Harry moves, a tick of two square-wave cycles
\ whose pitch follows his state. The original's tone is
\ f = 3546900 / (8 L0 + 228): N = 125000 / f is about L0 / 4 + L0 / 32 + 8.
.move_sound
{
    LDA h_dx : ORA h_dy : BNE moving
    RTS
.moving
    LDA h_state : CMP #7 : BNE not_jump
    LDA h_cnt : ASL A : ADC #42             ; (cnt < 128: carry clear)
    LDX h_cnt : CPX #10 : BCS l0
    EOR #&FF : ADC #1                       ; low for the first 9 steps
    JMP l0
.not_jump
    CMP #0 : BNE other
    LDA h_fall : ASL A : ADC #50
    JMP l0
.other
    CLC : ADC #1 : LSR A : CMP #2 : BNE n_ok
    LDA #6
.n_ok
    ASL A : ASL A : ASL A : ASL A
    EOR #&FF : CLC : ADC #1                 ; -16n
.l0
    CLC : ADC #1 : STA ms_l0                ; L0
    LSR A : LSR A : LSR A : LSR A : LSR A : STA ms_n
    LDA ms_l0 : CLC : ADC #3 : LSR A : LSR A
    CLC : ADC ms_n : ADC #8 : STA ms_n      ; N, under 80
    AND #15 : ORA #&A0 : JSR sound_write
    LDA ms_n : LSR A : LSR A : LSR A : LSR A : JSR sound_write
    LDA #&B2 : JSR sound_write              ; on
    \ Two cycles: 16N microseconds.
    LDA ms_n : LSR A : LSR A : LSR A : LSR A : TAY
    LDA ms_n : ASL A : ASL A : ASL A : ASL A : TAX
    JSR wait_us
    LDA #&BF : JMP sound_write              ; off
}

\ The train's noise: on while the noise flag is (machines.6502 sets it
\ once a pass), off when it isn't.
.noise_sound
{
    LDA noise_flag : CMP noise_on : BEQ same
    STA noise_on
    TAX : BEQ off
    LDA #&F3 : JMP sound_write
.off
    LDA #&FF : JMP sound_write
.same
    RTS
}
