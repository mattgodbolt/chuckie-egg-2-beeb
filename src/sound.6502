\ ***************************************************************************
\ Sound: the original's three (docs/research/frontend.md, section 7) on the
\ SN76489, written directly (decision 11: no OS calls). Channel 0 plays the
\ life-lost tune, channel 1 the movement tick, and the noise channel,
\ clocked by channel 2 at about 150 shifts a second, stands in for the
\ train's random beeper.
\ ***************************************************************************

\ The train's noise: on while the noise flag is (machines.6502 sets it
\ once a pass), off when it isn't.
.noise_sound
{
    LDA noise_flag : CMP noise_on : BEQ sound_write.done
    STA noise_on
    LSR A                           ; (the flag is 0 or 1)
    LDA #&FF : BCC off
    LDA #&F3
.off
    \ Fall into sound_write.
}
\ Write A to the sound chip, through the System VIA's slow bus. X is kept.
.sound_write
{
    \ The keyboard off the bus first: key_down leaves it enabled, and then
    \ it drives port A's bit 7 (the addressed key's state), which would
    \ replace the byte's top bit; the OS only writes with it on auto-scan.
    LDY #&0B : STY sysvia_orb
    LDY #&FF : STY sysvia_ddra
    STA sysvia_ora_nh
    LDY #0 : STY sysvia_orb         ; write enable low
    LDY #3                          ; ... for 8us
.hold
    DEY : BNE hold
    LDY #8 : STY sysvia_orb
.done
    RTS
}

\ (sound_init, which sets the chip up, is start-up code: startup.6502.)

\ Wait Y * 256 + X microseconds on the User VIA's timer 2 (one-shot).
.wait_us
    STX usrvia_t2cl : STY usrvia_t2ch       ; starts it; clears its flag
.wait_t2
    LDA usrvia_ifr : AND #&20 : BEQ wait_t2
.wait_done
    RTS

\ The life-lost tune (&A2EB): 16 notes, 2.16s, everything else frozen.
.death_tune
{
    \ X counts up to 0 through the notes, from 256 less their length.
    DT_FROM = 256 - (death_notes_end - death_notes)
    ASSERT DT_FROM > 0 AND ((death_notes_end - death_notes) MOD 3) = 0
    LDA #&90 : JSR sound_write      ; channel 0 loud
    LDX #DT_FROM
.note
    LDA death_notes - DT_FROM,X : JSR sound_write
    LDA death_notes + 1 - DT_FROM,X : JSR sound_write
    LDA death_notes + 2 - DT_FROM,X : STA dt_n
    STX dt_i
.hold
    LDX #LO(4000) : LDY #HI(4000) : JSR wait_us
    DEC dt_n : BNE hold
    LDX dt_i : INX : INX : INX : BNE note
    LDA #&9F : JMP sound_write
}
\ (Its notes, death_notes, are with the data at the code's end: main.6502.)

\ MOVE_SOUND (&92F4): while Harry moves, a tick of two square-wave cycles
\ whose pitch follows his state. The original's tone is
\ f = 3546900 / (8 L0 + 228): N = 125000 / f is about L0 / 4 + L0 / 32 + 8.
.move_sound
{
    LDA h_dx : ORA h_dy : BEQ wait_done
    LDA h_state : BEQ fall_tick
    CMP #7 : BNE other
    LDA h_cnt : ASL A : ADC #42             ; (cnt < 128: carry clear)
    LDX h_cnt : CPX #10 : BCS l0
    BCC negate                              ; (always) 1 - that for the first 9 steps
    ZA_UNREACHABLE
.other
    LSR A : ADC #0 : CMP #2 : BNE n_ok      ; (state + 1) / 2
    LDA #6
.n_ok
    ASL A : ASL A : ASL A : ASL A           ; 16n (carry clear: n < 16)
.negate
    EOR #&FF : ADC #2                       ; 1 - A (carry clear)
    BNE store                               ; (always: odd)
    ZA_UNREACHABLE
.fall_tick
    LDA h_fall : ASL A : ADC #50 : SEC
.l0
    ADC #0                                  ; (carry set) + 1
.store
    TAX                                     ; L0
    LSR A : LSR A : LSR A : LSR A : LSR A : STA ms_n
    TXA : CLC : ADC #3 : LSR A : LSR A
    CLC : ADC ms_n : ADC #8 : STA ms_n      ; N, under 80
    AND #15 : ORA #&A0 : JSR sound_write
    LDA ms_n : LSR A : LSR A : LSR A : LSR A : TAX : JSR sound_write
    LDA #&B2 : JSR sound_write              ; on
    \ Two cycles: 16N microseconds.
    TXA : TAY                               ; (N >> 4: sound_write keeps X)
    LDA ms_n : ASL A : ASL A : ASL A : ASL A : TAX
    JSR wait_us
    LDA #&BF : JMP sound_write              ; off
}

