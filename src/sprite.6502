\ ***************************************************************************
\ Sprites. The original ORs a frame on and sets the ink of the cells it
\ covers; to erase, it puts back the tile pixels from the tile map and the
\ attributes from the attribute map (docs/research/monsters.md, 2.3-2.4).
\ Here a frame is drawn masked in the sprite's own colour, so the scenery
\ under it keeps its colours, and erasing redraws the cells it covered
\ from the same two maps.
\
\ Frames are the original's: height in character rows, width in bytes,
\ then height * 8 rows of width bytes, 1 bit a pixel. Positions are whole
\ cells across (the frames are pre-shifted in 2-pixel steps) and a cell
\ plus a pixel line (yf) down.
\ ***************************************************************************

ZA_AUTO2 sp_frame           ; the frame's header
ZA_AUTO2 sp_cell            ; the top-left cell
ZA_AUTO1 sp_yf              ; the pixel line in that cell, 0-7
ZA_AUTO1 sp_ink             ; the sprite's Spectrum colour, 0-7
ZA_AUTO1 sp_colour          ; that colour in this row's band: a byte of four pixels

\ What sprite_setup gives draw_sprite and erase_image.
ZA_AUTO2 spr_src            ; the frame's first row
ZA_AUTO2 spr_scr            ; the screen byte of its top-left pixel
ZA_AUTO1 spr_lines          ; its height in lines
ZA_AUTO1 spr_width          ; ... and width in bytes

\ The frame at sp_frame, sp_cell, sp_yf: its size, its first row and the
\ screen address of its top line.
.sprite_setup
    LDY #0 : LDA (sp_frame),Y
    ASL A : ASL A : ASL A : STA spr_lines
    INY : LDA (sp_frame),Y : STA spr_width
    CLC : LDA sp_frame : ADC #2 : STA spr_src
    LDA sp_frame+1 : ADC #0 : STA spr_src+1
    LDA sp_cell : LDX sp_cell+1 : JSR cell_screen
    ORA sp_yf : STA spr_scr : STY spr_scr+1
    RTS

\ Draw the frame at sp_frame, sp_cell, sp_yf in Spectrum colour sp_ink,
\ looked up afresh in each row's band (decision 15).
.draw_sprite
{
    ZA_AUTO1 yf
    ZA_AUTO1 bcol
    ZA_AUTO1 soff
    ZA_AUTO1 img
    JSR sprite_setup
    LDA sp_yf : STA yf
    \ Its first row, and its colour there.
    LDA sp_cell : LDX sp_cell+1 : JSR cell_row : STA sp_row
    JSR sprite_colour
.row
    LDA #0 : STA bcol : STA soff
.byte
    LDY bcol : LDA (spr_src),Y : BEQ next_byte
    STA img
    LSR A : LSR A : LSR A : LSR A : TAX
    LDY soff                    ; the left four pixels
    LDA (spr_scr),Y : EOR sp_colour : AND spread_lo,X : EOR (spr_scr),Y : STA (spr_scr),Y
    LDA img : AND #15 : TAX
    TYA : ORA #8 : TAY          ; the right four
    LDA (spr_scr),Y : EOR sp_colour : AND spread_lo,X : EOR (spr_scr),Y : STA (spr_scr),Y
.next_byte
    LDA soff : CLC : ADC #16 : STA soff
    INC bcol : LDA bcol : CMP spr_width : BNE byte
    \ The next row of the frame, the next line down the screen.
    CLC : LDA spr_src : ADC spr_width : STA spr_src
    BCC src_ok
    INC spr_src+1
.src_ok
    INC yf : LDA yf : AND #7 : BEQ next_cell
    INC spr_scr                 ; (never carries: yf < 8 in a 16-byte cell)
    JMP more
.next_cell
    \ From line 7 of this cell row to line 0 of the next, 512 bytes on.
    LDA spr_scr : AND #&F0 : STA spr_scr
    INC spr_scr+1 : INC spr_scr+1
    INC sp_row : JSR sprite_colour
.more
    DEC spr_lines : BNE row
    RTS
}

\ sp_colour = sp_ink in row sp_row's band.
.sprite_colour
    LDX sp_row : LDA band_off,X : ORA sp_ink : TAX
    LDA band_cmaps,X : TAX : LDA colour_bytes,X : STA sp_colour
    RTS

\ Erase the frame at sp_frame, sp_cell, sp_yf the original's way (&7FC9):
\ under each set pixel of the image, put back the room's pixel (the tile
\ from the tile map, in its cell's colours); every other pixel is left
\ alone. So a sprite passing over an object or another sprite takes its
\ shape out of them, as in the original, until they are redrawn.
.erase_image
{
    ZA_AUTO2 col_src
    ZA_AUTO2 col_scr
    ZA_AUTO1 yf
    ZA_AUTO1 bcol
    ZA_AUTO1 left
    ZA_AUTO1 img
    ZA_AUTO1 mask
    ZA_AUTO1 tb
    JSR sprite_setup
    \ A column at a time (the bytes are independent), so a cell is looked
    \ up once for each cell row it covers, not once a line.
    LDA #0 : STA bcol
.column
    CLC : LDA spr_src : ADC bcol : STA col_src
    LDA spr_src+1 : ADC #0 : STA col_src+1
    LDA bcol : ASL A : ASL A : ASL A : ASL A        ; 16 bytes a cell across
    CLC : ADC spr_scr : STA col_scr
    LDA spr_scr+1 : ADC #0 : STA col_scr+1
    CLC : LDA sp_cell : ADC bcol : STA cell
    LDA sp_cell+1 : ADC #0 : STA cell+1
    LDA sp_yf : STA yf
    LDA spr_lines : STA left
    JSR cell_looks
.line
    LDY #0 : LDA (col_src),Y : BEQ next_line
    STA img
    \ The room's pixels here: the tile's line, in the cell's colours.
    LDY yf : LDA (glyph),Y : STA tb
    LDA img : LSR A : LSR A : LSR A : LSR A : TAX
    LDA spread_lo,X : STA mask
    LDA tb : LSR A : LSR A : LSR A : LSR A : TAX
    LDA spread_lo,X : AND diff : EOR paper
    LDY #0
    EOR (col_scr),Y : AND mask : EOR (col_scr),Y : STA (col_scr),Y
    LDA img : AND #15 : TAX
    LDA spread_lo,X : STA mask
    LDA tb : AND #15 : TAX
    LDA spread_lo,X : AND diff : EOR paper
    LDY #8
    EOR (col_scr),Y : AND mask : EOR (col_scr),Y : STA (col_scr),Y
.next_line
    CLC : LDA col_src : ADC spr_width : STA col_src
    BCC src_ok
    INC col_src+1
.src_ok
    DEC left : BEQ next_column
    INC yf : LDA yf : CMP #8 : BEQ next_cell
    INC col_scr                 ; (never carries: yf < 8 in a 16-byte cell)
    JMP line
.next_cell
    \ From line 7 of this cell row to line 0 of the next, 512 bytes on.
    LDA #0 : STA yf
    LDA col_scr : AND #&F0 : STA col_scr
    INC col_scr+1 : INC col_scr+1
    CLC : LDA cell : ADC #32 : STA cell
    BCC looks
    INC cell+1
.looks
    JSR cell_looks
    JMP line
.next_column
    INC bcol : LDA bcol : CMP spr_width : BEQ done
    JMP column
.done
    RTS
}

\ Sprite frame A's header: low byte in A, high in X. The table has 152
\ entries, so frame numbers from &80 index its second page (as the
\ original's &8BDE carries into its high byte).
.sprite_frame
{
    ASL A : TAY : BCS high
    LDX sprite_frames+1,Y : LDA sprite_frames,Y
    RTS
.high
    LDX sprite_frames+257,Y : LDA sprite_frames+256,Y
    RTS
}
