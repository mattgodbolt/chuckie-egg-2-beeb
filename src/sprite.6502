\ ***************************************************************************
\ Sprites. The original ORs a frame on and sets the ink of the cells it
\ covers; to erase, it puts back the tile pixels from the tile map and the
\ attributes from the attribute map (docs/research/monsters.md, 2.3-2.4).
\ Here a frame is drawn masked in the sprite's own colour, so the scenery
\ under it keeps its colours, and erasing redraws the cells it covered
\ from the same two maps.
\
\ Frames are the original's: height in character rows, width in bytes,
\ then height * 8 rows of width bytes, 1 bit a pixel. Positions are whole
\ cells across (the frames are pre-shifted in 2-pixel steps) and a cell
\ plus a pixel line (yf) down.
\ ***************************************************************************

ZA_AUTO2 sp_frame           ; the frame's header
ZA_AUTO2 sp_cell            ; the top-left cell
ZA_AUTO1 sp_yf              ; the pixel line in that cell, 0-7
ZA_AUTO1 sp_ink             ; the sprite's Spectrum colour, 0-7
ZA_AUTO1 sp_colour          ; that colour in this row's band: a byte of four pixels

\ Draw the frame at sp_frame, sp_cell, sp_yf in Spectrum colour sp_ink,
\ looked up afresh in each row's band (decision 15).
.draw_sprite
{
    ZA_AUTO2 src
    ZA_AUTO2 scr
    ZA_AUTO1 lines
    ZA_AUTO1 width
    ZA_AUTO1 yf
    ZA_AUTO1 bcol
    ZA_AUTO1 soff
    ZA_AUTO1 mask
    ZA_AUTO1 under
    LDY #0 : LDA (sp_frame),Y
    ASL A : ASL A : ASL A : STA lines
    INY : LDA (sp_frame),Y : STA width
    CLC : LDA sp_frame : ADC #2 : STA src
    LDA sp_frame+1 : ADC #0 : STA src+1
    \ scr = screen + 16 * cell + yf
    LDA sp_cell : ASL A : ASL A : ASL A : ASL A : ORA sp_yf : STA scr
    LDA sp_cell+1 : STA scr+1
    LDA sp_cell
    LSR scr+1 : ROR A : LSR scr+1 : ROR A : LSR scr+1 : ROR A : LSR scr+1 : ROR A
    CLC : ADC #HI(screen) : STA scr+1
    LDA sp_yf : STA yf
    \ Its first row, and its colour there.
    LDA sp_cell+1 : ASL A : ASL A : ASL A : STA sp_row
    LDA sp_cell : LSR A : LSR A : LSR A : LSR A : LSR A : ORA sp_row : STA sp_row
    JSR sprite_colour
.row
    LDA #0 : STA bcol : STA soff
.byte
    LDY bcol : LDA (src),Y : BEQ next_byte
    TAX
    LSR A : LSR A : LSR A : LSR A : TAY
    LDA spread_lo,Y : STA mask  ; the left four pixels
    LDY soff
    LDA (scr),Y : STA under
    EOR sp_colour : AND mask : EOR under : STA (scr),Y
    TXA : AND #15 : TAX
    LDA spread_lo,X : STA mask  ; the right four
    TYA : ORA #8 : TAY
    LDA (scr),Y : STA under
    EOR sp_colour : AND mask : EOR under : STA (scr),Y
.next_byte
    LDA soff : CLC : ADC #16 : STA soff
    INC bcol : LDA bcol : CMP width : BNE byte
    \ The next row of the frame, the next line down the screen.
    CLC : LDA src : ADC width : STA src
    BCC src_ok
    INC src+1
.src_ok
    INC yf : LDA yf : AND #7 : BEQ next_cell
    INC scr                     ; (never carries: yf < 8 in a 16-byte cell)
    JMP more
.next_cell
    CLC : LDA scr : ADC #LO(ROW_BYTES - 7) : STA scr
    LDA scr+1 : ADC #HI(ROW_BYTES - 7) : STA scr+1
    INC sp_row : JSR sprite_colour
.more
    DEC lines : BNE row
    RTS
}

\ sp_colour = sp_ink in row sp_row's band.
.sprite_colour
    LDX sp_row : LDA band_off,X : ORA sp_ink : TAX
    LDA band_cmaps,X : TAX : LDA colour_bytes,X : STA sp_colour
    RTS

\ Erase the frame at sp_frame, sp_cell, sp_yf the original's way (&7FC9):
\ under each set pixel of the image, put back the room's pixel (the tile
\ from the tile map, in its cell's colours); every other pixel is left
\ alone. So a sprite passing over an object or another sprite takes its
\ shape out of them, as in the original, until they are redrawn.
.erase_image
{
    ZA_AUTO2 src
    ZA_AUTO2 scr
    ZA_AUTO2 row_cell
    ZA_AUTO1 lines
    ZA_AUTO1 width
    ZA_AUTO1 yf
    ZA_AUTO1 bcol
    ZA_AUTO1 soff
    ZA_AUTO1 img
    ZA_AUTO1 mask
    ZA_AUTO1 under
    ZA_AUTO1 tb
    LDY #0 : LDA (sp_frame),Y
    ASL A : ASL A : ASL A : STA lines
    INY : LDA (sp_frame),Y : STA width
    CLC : LDA sp_frame : ADC #2 : STA src
    LDA sp_frame+1 : ADC #0 : STA src+1
    LDA sp_cell : STA row_cell
    LDA sp_cell+1 : STA row_cell+1
    LDA sp_cell : ASL A : ASL A : ASL A : ASL A : ORA sp_yf : STA scr
    LDA sp_cell+1 : STA scr+1
    LDA sp_cell
    LSR scr+1 : ROR A : LSR scr+1 : ROR A : LSR scr+1 : ROR A : LSR scr+1 : ROR A
    CLC : ADC #HI(screen) : STA scr+1
    LDA sp_yf : STA yf
    \ Its first row, and its colour there.
    LDA sp_cell+1 : ASL A : ASL A : ASL A : STA sp_row
    LDA sp_cell : LSR A : LSR A : LSR A : LSR A : LSR A : ORA sp_row : STA sp_row
    JSR sprite_colour
.row
    LDA #0 : STA bcol : STA soff
.byte
    LDY bcol : LDA (src),Y : BEQ next_byte
    STA img
    \ The room's pixels here: the tile's line, in the cell's colours.
    CLC : LDA row_cell : ADC bcol : STA cell
    LDA row_cell+1 : ADC #0 : STA cell+1
    JSR cell_looks
    LDA yf : AND #7 : TAY
    LDA (glyph),Y : STA tb
    LDA img : LSR A : LSR A : LSR A : LSR A : TAX
    LDA spread_lo,X : STA mask
    LDA tb : LSR A : LSR A : LSR A : LSR A : TAX
    LDA spread_lo,X : AND diff : EOR paper
    LDY soff
    EOR (scr),Y : AND mask : EOR (scr),Y : STA (scr),Y
    LDA img : AND #15 : TAX
    LDA spread_lo,X : STA mask
    LDA tb : AND #15 : TAX
    LDA spread_lo,X : AND diff : EOR paper
    STA under
    TYA : ORA #8 : TAY
    LDA under
    EOR (scr),Y : AND mask : EOR (scr),Y : STA (scr),Y
.next_byte
    LDA soff : CLC : ADC #16 : STA soff
    INC bcol : LDA bcol : CMP width : BNE byte
    CLC : LDA src : ADC width : STA src
    BCC src_ok
    INC src+1
.src_ok
    INC yf : LDA yf : AND #7 : BEQ next_cell
    INC scr
    JMP more
.next_cell
    CLC : LDA scr : ADC #LO(ROW_BYTES - 7) : STA scr
    LDA scr+1 : ADC #HI(ROW_BYTES - 7) : STA scr+1
    CLC : LDA row_cell : ADC #32 : STA row_cell
    BCC more
    INC row_cell+1
.more
    DEC lines : BEQ done
    JMP row
.done
    RTS
}

\ Sprite frame A's header: low byte in A, high in X. The table has 152
\ entries, so frame numbers from &80 index its second page (as the
\ original's &8BDE carries into its high byte).
.sprite_frame
{
    ASL A : TAY : BCS high
    LDX sprite_frames+1,Y : LDA sprite_frames,Y
    RTS
.high
    LDX sprite_frames+257,Y : LDA sprite_frames+256,Y
    RTS
}

\ How `cell` looks: glyph = its tile's 8 bytes, paper and diff its colours.
.cell_looks
{
    ZA_AUTO2 mp
    LDA cell : STA mp
    CLC : LDA cell+1 : ADC #HI(tile_map) : STA mp+1
    LDY #0 : LDA (mp),Y
    BMI text
    SEC : SBC #&20
    LDX #LO(tiles) : LDY #HI(tiles)
    JMP glyph_addr
.text
    AND #&7F : SEC : SBC #32
    LDX #LO(text_font) : LDY #HI(text_font)
.glyph_addr
    STA glyph : LDA #0 : STA glyph+1
    ASL glyph : ROL glyph+1 : ASL glyph : ROL glyph+1 : ASL glyph : ROL glyph+1
    TXA : CLC : ADC glyph : STA glyph
    TYA : ADC glyph+1 : STA glyph+1
    LDA mp+1 : SEC : SBC #HI(tile_map) - HI(attr_map) : STA mp+1
    LDY #0 : LDA (mp),Y
    \ paper and diff, as draw_glyph works them out.
    PHA
    JSR cell_band : STX dg_band
    PLA : PHA
    LSR A : LSR A : LSR A : AND #7 : ORA dg_band : TAX
    LDA band_cmaps,X
    TAX : LDA colour_bytes,X : STA paper
    PLA : AND #7 : ORA dg_band : TAX
    LDA band_cmaps,X
    TAX : LDA colour_bytes,X : EOR paper : STA diff
    RTS
}
