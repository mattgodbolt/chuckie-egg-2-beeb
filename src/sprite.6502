\ ***************************************************************************
\ Sprites. The original ORs a frame on and sets the ink of the cells it
\ covers; to erase, it puts back the tile pixels from the tile map and the
\ attributes from the attribute map (docs/research/monsters.md, 2.3-2.4).
\ Here a frame is drawn masked in the sprite's own colour, so the scenery
\ under it keeps its colours, and erasing redraws the cells it covered
\ from the same two maps.
\
\ Frames are the original's: height in character rows, width in bytes,
\ then height * 8 lines of width bytes, 1 bit a pixel, but stored a column
\ at a time (decision 20). Positions are whole cells across (the frames
\ are pre-shifted in 2-pixel steps) and a cell plus a pixel line (yf)
\ down.
\
\ A monster's, a lift's or an object's frame leaves out what drawing
\ doesn't need (decision 26, tools/mkgfx.py): its empty lines at the top
\ and bottom, how many in bits 3-7 of the height byte (top) and 4-6 of the
\ width byte (bottom); and a mirror image of another frame (bit 7 of the
\ width byte) has no pixels of its own, but where its twin's are, relative
\ to its header, which are drawn turned over. Everything but the drawing
\ reads the header bytes masked to 3 and 4 bits.
\
\ Both routines work a cell row at a time, and in it a column at a time
\ from the right and a line at a time from the bottom: a frame byte's two
\ screen bytes are touched by no other byte, so the order doesn't change
\ what's drawn. Y counts the row's lines down to 0, its first (sp_yf in
\ the cell): it indexes the screen bytes, the tile's lines and the
\ frame's column, each pointer offset to that first line.
\ ***************************************************************************

ZA_AUTO2 sp_frame           ; the frame's header
ZA_AUTO2 sp_cell            ; the top-left cell (the drawing moves it: below)
ZA_AUTO1 sp_yf              ; the pixel line in that cell, 0-7 (likewise)
ZA_AUTO1 sp_ink             ; the sprite's Spectrum colour, 0-7
ZA_AUTO1 sp_colour          ; that colour in this row's band: a byte of four pixels

\ The frame as it is drawn (sp_row is in memory.6502's scratch): ...
ZA_AUTO1 sp_h8              ; its lines: a column's bytes
ZA_AUTO1 sp_wm1             ; its width in bytes, less 1
ZA_AUTO1 sp_lines           ; its lines below this cell row
ZA_AUTO2 sp_step            ; sp_p's step to the column on the left: -sp_h8, or a mirror's +sp_h8
ZA_AUTO1 sp_half            ; which half of a cell sp_scr is: 0 the left, a mirror's 8 the right
\ ... this cell row (sp_cell its first cell, sp_yf its first line) ...
ZA_AUTO2 sp_rowscr          ; the screen address of its last column, in sp_half
ZA_AUTO2 sp_rowp            ; sp_p for its last column
ZA_AUTO1 sp_top             ; its lines less 1: Y at a column's start
\ ... and the column, Y = 0 at the row's first line.
ZA_AUTO1 sp_c               ; from width - 1 down to 0
ZA_AUTO2 sp_p               ; its frame bytes, for Y = 0
ZA_AUTO2 sp_scr             ; the screen: this cell's line sp_yf, its left four pixels
ZA_AUTO2 sp_scr8            ; ... and its right four (sp_scr EOR 8; a mirror's the other way)
ZA_AUTO1 sp_yl              ; (erase_image's Y, kept through a look-up)

\ Draw the frame at sp_frame, sp_cell, sp_yf in Spectrum colour sp_ink,
\ looked up afresh in each row's band (decision 15).
.draw_sprite
{
    JSR sprite_start
.each_row
    \ The colour in this row's band.
    LDX sp_row : LDA band_off,X : ORA sp_ink : TAX
    LDA band_cmaps,X : STA sp_colour
    JSR sprite_row
.line
    LDA (sp_p),Y : BEQ next
    LSR A : LSR A : LSR A : LSR A : BEQ right
    TAX                         ; the left four pixels (sprite_start patches
                                ; the spread_lo of .dl, .dr for a mirror)
    LDA (sp_scr),Y : EOR sp_colour
.dl AND spread_lo,X
    EOR (sp_scr),Y : STA (sp_scr),Y
.right
    LDA (sp_p),Y : AND #15 : BEQ next
    TAX                         ; the right four
    LDA (sp_scr8),Y : EOR sp_colour
.dr AND spread_lo,X
    EOR (sp_scr8),Y : STA (sp_scr8),Y
.next
    DEY : BPL line
    JSR sprite_left : BPL line
    JSR sprite_down : BNE each_row
    RTS
}

\ Erase the frame at sp_frame, sp_cell, sp_yf the original's way (&7FC9):
\ under each set pixel of the image, put back the room's pixel (the tile
\ from the tile map, in its cell's colours); every other pixel is left
\ alone. So a sprite passing over an object or another sprite takes its
\ shape out of them, as in the original, until they are redrawn.
.erase_image
{
    ZA_AUTO1 tb
    ZA_AUTO1 mask
    JSR sprite_start
.each_row
    JSR sprite_row
.column
    \ A cell is looked up only if the column has a pixel in it.
    LDA (sp_p),Y : BNE found
    DEY : BPL column
.column_done
    JSR sprite_left : BPL column
    JSR sprite_down : BNE each_row
    RTS
.clear
    \ Paper 0 and ink the same, as in most of a room: the room's pixels
    \ here are all 0, so the image's pixels are cleared (AND NOT spread(n)
    \ is AND spread(n EOR 15)).
    LDY sp_yl
.clear_line
    LDA (sp_p),Y : BEQ clear_next
    \ (sprite_start patches the spread_lo of .cl to .tr for a mirror.)
    LSR A : LSR A : LSR A : LSR A : EOR #15 : TAX
    LDA (sp_scr),Y
.cl AND spread_lo,X
    STA (sp_scr),Y
    LDA (sp_p),Y : AND #15 : EOR #15 : TAX
    LDA (sp_scr8),Y
.cr AND spread_lo,X
    STA (sp_scr8),Y
.clear_next
    DEY : BPL clear_line
    BMI column_done                 ; (always)
    ZA_UNREACHABLE
.found
    \ The cell: the row's first plus the column (past column 31 the next
    \ row's, as the maps have it).
    STY sp_yl
    CLC : LDA sp_cell : ADC sp_c : STA cell
    LDA sp_cell+1 : ADC #0 : STA cell+1
    JSR cell_colours                ; paper, diff (A = diff)
    ORA paper : BEQ clear
    JSR cell_glyph
    \ The tile's lines from the row's first (cell_glyph leaves carry clear).
    LDA glyph : ADC sp_yf : STA glyph
    BCC glyph_at
    INC glyph+1
.glyph_at
    LDY sp_yl
.line
    LDA (sp_p),Y : BEQ next
    LDA (glyph),Y
.to_tiled
    BNE tiled                       ; (tiled_m for a mirror: sprite_start;
    ZA_CANJUMP tiled, tiled_m       ; a blank line, 0, is 0 through tiled_m)
.tiled_m
    \ A mirror's screen halves are the other way round (sp_half), so the
    \ tile's are too: its byte with the nibbles swapped.
    ASL A : ADC #&80 : ROL A : ASL A : ADC #&80 : ROL A
.tiled
    \ The room's pixels: the tile's line, in the cell's colours (the
    \ image's pixels by .tl and .tr, which sprite_start patches; the tile's
    \ by spread_lo always).
    STA tb
    LDA (sp_p),Y : LSR A : LSR A : LSR A : LSR A : BEQ tiled_right
    TAX
.tl LDA spread_lo,X
    STA mask
    LDA tb : LSR A : LSR A : LSR A : LSR A : TAX
    LDA spread_lo,X : AND diff : EOR paper
    EOR (sp_scr),Y : AND mask : EOR (sp_scr),Y : STA (sp_scr),Y
.tiled_right
    LDA (sp_p),Y : AND #15 : BEQ next
    TAX
.tr LDA spread_lo,X
    STA mask
    LDA tb : AND #15 : TAX
    LDA spread_lo,X : AND diff : EOR paper
    EOR (sp_scr8),Y : AND mask : EOR (sp_scr8),Y : STA (sp_scr8),Y
.next
    DEY : BPL line
    JMP column_done
}

\ Set up the frame at sp_frame, sp_cell, sp_yf for drawing or erasing, at
\ its first cell row.
.sprite_start
{
    ZA_AUTO1 top
    \ The header: height + 8 * top, width + 16 * bottom (+ MIRROR).
    LDY #1 : LDA (sp_frame),Y : TAX
    AND #15 : STA sp_wm1 : DEC sp_wm1
    DEY : LDA (sp_frame),Y
    CPX #16 : BCS packed
    CMP #8 : BCS packed
    \ Every line and its own pixels (Harry's frames, and the monsters' and
    \ objects' with no empty lines): the quick way.
    ASL A : ASL A : ASL A : STA sp_h8 : STA sp_lines
    BCC own                         ; (always: height < 8)
    ZA_UNREACHABLE
.packed
    LSR A : LSR A : LSR A : STA top                             ; the lines left out above
    TXA : AND #&70 : LSR A : LSR A : LSR A : LSR A              ; ... and below
    ADC top : STA sp_h8                                         ; (carry clear)
    \ The first line held is `top` lines down: whole cell rows of 32 cells,
    \ then the line in the cell.
    LDA top : BEQ lines
    ADC sp_yf : STA top             ; (carry clear: the ADC above)
    AND #7 : STA sp_yf
    LDA top : AND #&F8 : BEQ lines
    ASL A : ASL A                   ; (carry clear: top < 64)
    ADC sp_cell : STA sp_cell
    BCC lines
    INC sp_cell+1
.lines
    LDA (sp_frame),Y : AND #7 : ASL A : ASL A : ASL A
    SEC : SBC sp_h8 : STA sp_h8 : STA sp_lines                  ; the lines a column holds
    \ sp_rowp: the first line held of the column drawn first (the screen's
    \ last).
    TXA : BMI mirror
.own
    \ Its own pixels follow the header, a column at a time from the left;
    \ the last column is frame + 2 + (width - 1) * lines, and the columns
    \ go leftwards from there.
    LDA sp_frame : LDY sp_frame+1
    LDX sp_wm1
    CLC : ADC #2
.across
    BCC added
    INY
.added
    DEX : BMI back
    CLC : ADC sp_h8
    JMP across
.back
    STA sp_rowp : STY sp_rowp+1
    STX sp_step+1                   ; (X = &FF)
    INX : STX sp_half               ; X = 0
    TXA : SEC : SBC sp_h8 : STA sp_step
    \ Drawn as it is.
    LDA #LO(spread_lo) : LDY #erase_image.tiled - erase_image.to_tiled - 2
    BCC pixels                      ; (always: 0 - sp_h8 borrows)
    ZA_UNREACHABLE
.mirror
    \ A mirror image: its twin's pixels, which its next two bytes say
    \ where, from the header. Each column is the twin's from the other
    \ side, turned over: the first column is the screen's last, the
    \ columns go rightwards, the screen halves are swapped (sp_half), and
    \ each half's pixels are turned over (sprite_start).
    LDY #2 : LDA (sp_frame),Y : CLC : ADC sp_frame : STA sp_rowp
    INY : LDA (sp_frame),Y : ADC sp_frame+1 : STA sp_rowp+1
    LDA sp_h8 : STA sp_step
    LDA #8 : STA sp_half
    LDY #0 : STY sp_step+1
    \ Turned over: Y = 0, the branch on into tiled_m.
    ASSERT erase_image.tiled_m - erase_image.to_tiled - 2 = 0
    LDA #LO(spread_rev)
.pixels
    \ Patch draw_sprite and erase_image for drawing frames as they are or
    \ turned over, when that changes (the code says which way it is): the
    \ table that spreads the image's nibbles (A), and the way into
    \ erase_image's tiled path (Y).
    CMP draw_sprite.dl+1 : BEQ moded
    STA draw_sprite.dl+1 : STA draw_sprite.dr+1
    STA erase_image.cl+1 : STA erase_image.cr+1
    STA erase_image.tl+1 : STA erase_image.tr+1
    STY erase_image.to_tiled+1
.moded
    \ The last column's screen address, screen + 16 * (cell + width - 1)
    \ (cell_screen), in the half drawn first.
    LDA sp_wm1 : CLC : ADC sp_cell
    LDX sp_cell+1 : BCC column_cell
    INX
.column_cell
    JSR cell_screen
    ORA sp_half : STA sp_rowscr : STY sp_rowscr+1
    LDA sp_cell : LDX sp_cell+1 : JSR cell_row : STA sp_row
    RTS
}

\ Start a cell row: its lines are sp_yf on to the cell's foot or the
\ frame's (those below it left in sp_lines); Y = their count less 1
\ (sp_top), at its last column (sp_c). Y counts down to 0, the row's
\ first line: the screen pointers are offset by sp_yf to match.
.sprite_row
{
    LDA sp_yf : EOR #7 : STA sp_top         ; 7 - sp_yf: to the cell's foot
    LDA sp_lines : CLC : SBC sp_top         ; the lines below the cell
    BCS full
    ADC sp_top : STA sp_top                 ; none: to the frame's foot,
    LDA #0                                  ; sp_lines - 1
.full
    STA sp_lines
    LDY sp_top
    LDA sp_wm1 : STA sp_c
    LDA sp_rowp : STA sp_p
    LDA sp_rowp+1 : STA sp_p+1
    LDA sp_rowscr : ORA sp_yf : STA sp_scr : EOR #8 : STA sp_scr8
    LDA sp_rowscr+1 : STA sp_scr+1 : STA sp_scr8+1
    RTS
}

\ On to the column on the left, Y back at sp_top: N clear, or N set when
\ the row is done.
.sprite_left
{
    DEC sp_c : BMI done
    CLC : LDA sp_p : ADC sp_step : STA sp_p
    LDA sp_p+1 : ADC sp_step+1 : STA sp_p+1
    SEC : LDA sp_scr : SBC #16 : STA sp_scr : EOR #8 : STA sp_scr8
    BCS same_page
    DEC sp_scr+1 : DEC sp_scr8+1
.same_page
    LDY sp_top                      ; (N clear: under 8)
.done
    RTS
}

\ After a cell row: on to the one below, Z clear; Z set when the frame is
\ done.
.sprite_down
{
    LDA sp_lines : BEQ done
    \ Y = 0 is the next line: sp_p goes on by this row's lines.
    LDA sp_rowp : SEC : ADC sp_top : STA sp_rowp
    BCC next_cell
    INC sp_rowp+1
    CLC
.next_cell
    LDA sp_cell : ADC #32 : STA sp_cell
    BCC screen_row
    INC sp_cell+1
.screen_row
    ASSERT ROW_BYTES = &200
    INC sp_rowscr+1 : INC sp_rowscr+1
    INY : STY sp_yf                 ; 0 (Y = &FF: the rows' lines counted out)
    INC sp_row                      ; (Z clear: a row below the first)
.done
    RTS
}

\ Sprite frame A's header: low byte in A, high in X (0 if none of the
\ room's groups has it). The original's table (&91B7) has all 152; here
\ the room's are runs of consecutive numbers, a group's each (rooms.6502's
\ room_load).
.sprite_frame
{
    LDY rg_count
.try
    DEY : BMI none
    CMP rg_end,Y : BCS try
    CMP rg_first,Y : BCC try
    ADC rg_base,Y : TAY             ; (carry set: room_load's rg_base is one less)
    LDX fr_hi,Y : LDA fr_lo,Y
.got
IF DEFINED(DIRECT)
    \ The tests' build: a frame no group of the room's gave (rooms.6502's
    \ room_load) stops the game here, where the tests see it.
    CPX #0 : BEQ frame_missing
ENDIF
    RTS
.none
    LDX #0
IF DEFINED(DIRECT)
    BEQ got                         ; (always)
    ZA_UNREACHABLE
ELSE
    RTS
ENDIF
}
IF DEFINED(DIRECT)
.frame_missing
    JMP frame_missing
ENDIF
