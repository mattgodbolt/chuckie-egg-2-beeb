\ ***************************************************************************
\ The game's start-up: run once each time CE2 is loaded (MENU runs it for
\ every game, and again after a save), from the loader, after the code has
\ been copied down. Nothing here is needed again, so it stays where the
\ file loaded, in screen memory, which the first room's cls clears; it must
\ not return there after drawing (the game carries on in next_egg or
\ resume_room, in main RAM).
\ ***************************************************************************

.start
{
    ZA_ENTRY
    LDX #&FF : TXS
IF DEFINED(STREAM)
    JSR stream_init
ELSE
    JSR find_data_bank
ENDIF
    JSR keep_os                 ; before the tables overwrite page 2
    JSR init_system
    JSR copy_os_pages
    JSR sound_init
IF DEFINED(VIEWER)
    JMP viewer                  ; the room viewer, for tools/roomcheck.mjs
ELSE
    JMP init_game
ENDIF
}

\ The data's sideways RAM bank (decision 8). MENU found or filled it and
\ left its number at DATA_BANK_ZP for the game, which pages it in for good,
\ so the data reads as ordinary memory at &8000. romshad is the OS's copy
\ of romsel: it puts that back after paging ROMs itself, so write both.
.find_data_bank
    SEI
    LDA DATA_BANK_ZP : STA romshad : STA romsel
    RTS                         ; interrupts stay off until install_irq

IF DEFINED(STREAM)
\ The streaming edition (disc.6502): the mailbox from where MENU left a
\ copy (memory.6502), then the disc reader, on the controller MENU named.
\ It owns NMI_AREA from now on.
.stream_init
{
    SEI                         ; interrupts stay off until install_irq
    \ REC_BASE bytes: a page and the rest, or less than a page (a short
    \ build stamp; the rest's count would wrap and copy over this loader).
    LDX #0
.box
    LDA MB_XFER,X : STA MB_STREAM,X
    INX
IF REC_BASE <= &100
    CPX #LO(REC_BASE) : BNE box
ELSE
    BNE box
.rest
    LDA MB_XFER + &100,X : STA MB_STREAM + &100,X
    INX : CPX #REC_BASE - &100 : BNE rest
ENDIF
    LDX #nmi_end - NMI_AREA - 1
.nmi
    LDA nmi_load,X : STA NMI_AREA,X
    DEX : BPL nmi
    LDA #RTI_OP : STA NMI_AREA  ; not armed until a read (the set-up's own
                                ; NMIs would store through it)
    \ The controller's reader, into disc.6502's slot.
    LDX #FDC_SLOT - 1
.reader
    LDA reader_8271,X
    LDY mb_fdc : BEQ copy
    LDA reader_1770,X
.copy
    STA fdc_slot,X
    DEX : BPL reader
    LDA #0 : STA fdc_state
    STA it_n : STA pf_cur
    LDA #LO(arena) : STA item_top
    LDA #HI(arena) : STA item_top+1
    LDA mb_fdc : BNE w
    LDA #LO(I_DATA) : STA nmi_data + 1
    LDA #HI(I_DATA) : STA nmi_data + 2
    LDA #1 : STA I_RESET
    LDX #20
.rw DEX : BNE rw
    STX I_RESET
    LDX #i_init_end - i_init - 1
.cmds
    JSR i_command_x
    BPL cmds
    \ The seek's result (not ready, most likely, but the head is at track
    \ 0 and the 8271 knows it), read to drop its interrupt.
.seek
    BIT I_STATUS : BMI seek
    LDA I_RESULT
    RTS
.w
    LDA #LO(W_DATA) : STA nmi_data + 1
    LDA #HI(W_DATA) : STA nmi_data + 2
    LDA #W_LATCH AND NOT(4) : STA W_CONTROL     ; reset
    LDX #20
.ww DEX : BNE ww
    LDA #W_LATCH : STA W_CONTROL
    LDA #&FF : STA fdc_cur
    RTS
}

\ The 8271's set-up, read backwards by i_command_x: count, command,
\ parameters. Its step is the DFS's (24ms on jsbeeb); the head unloads
\ after 14 revolutions (2.8s) idle and takes 64ms to load. (Never unload
\ count 0 on a B: it unloads after a not-ready too, which hangs.)
I_STEP   = &0C
I_SETTLE = &0A
I_LOAD   = &E8
.i_init
    EQUB 0, &69, 2                              ; Seek 0 (steps until TRK0)
    EQUB &C1, &17, &7A, 3                       ; Write Special Register: mode, no DMA
    EQUB 0, &FF, &FF, &10, &75, 5               ; Specify bad tracks (none), track 0
    EQUB I_LOAD, I_SETTLE, I_STEP, &0D, &75, 5  ; Specify timings
.i_init_end

\ Issue the 8271 command whose bytes end at i_init + X (count, command,
\ parameters, read downwards); returns X before the next, N set at the end.
.i_command_x
{
.idle
    BIT I_STATUS : BMI idle                     ; busy
    LDY i_init,X : DEX
    LDA i_init,X : STA I_COMMAND : DEX : DEY
    BEQ done
.param
    LDA I_STATUS : AND #&20 : BNE param         ; parameter register full
    LDA i_init,X : STA I_PARAM
    DEX : DEY : BNE param
.done
    TXA
    RTS
}

\ The 8271's reader (disc.6502's fdc_slot, where stream_init copies it).
.reader_8271
    SECTION Fdc8271, org = fdc_slot, guard = fdc_slot + FDC_SLOT
    JMP i_start
    ASSERT P% = fdc_poll
{
    LDA I_STATUS : ASL A : BCS i_rts            ; busy (carry set)
    LDA fdc_state : CMP #3 : BCC reading
    BEQ waiting
    \ 4: the seek to track 0 (below) is done: its result dropped, the
    \ read again.
    LDA I_RESULT
    JMP i_start
.waiting
    \ 3: waiting for the drive (below): half a second on, the read again.
    LDA vsyncs : SEC : SBC i_since : CMP #25 : BCS i_start
    SEC                                         ; (busy)
    RTS
.reading
    \ The result drops its interrupt.
    LDA I_RESULT : AND #&1E : BEQ finished
    CMP #&10 : BEQ not_ready
    \ Another error: where the head is may not be where the 8271 thinks
    \ (steps taken while the drive wasn't ready go nowhere), so a seek to
    \ track 0, which finds it, then the read again.
    LDA #&69 : STA I_COMMAND                    ; Seek, drive 0
    LDX #0 : JSR i_param
    LDA #4 : STA fdc_state
    SEC                                         ; (busy)
    RTS
.not_ready
    \ Not ready: a B makes the drive ready on the second index pulse after
    \ it is selected, and the 8271 latches not ready until a Read Drive
    \ Status. That, then a wait while the drive comes up (once the head had
    \ unloaded, reading again at once, over and over, never let it: in
    \ jsbeeb, a croc's room after 2.8s idle hung for good), then again.
    LDA #&6C : STA I_COMMAND
.rds
    BIT I_STATUS : BMI rds
    LDA I_RESULT
    LDA vsyncs : STA i_since
    LDA #3 : STA fdc_state
    SEC                                         ; (busy)
    RTS
.finished
    LDX #0 : STX fdc_state
    CLC : TAX                                   ; (Z from A)
    RTS
}
.i_start
{
    JSR arm
.idle
    BIT I_STATUS : BMI idle
    LDA #&53 : STA I_COMMAND                    ; Read Data, drive 0
    LDX fdc_track : JSR i_param
    LDX fdc_sect : JSR i_param
    LDX #&21                                    ; one 256-byte sector
    \ Fall into i_param.
}
\ An 8271 command's parameter X, once the register is free.
.i_param
{
    LDA #&20
.full
    BIT I_STATUS : BNE full                     ; parameter register full
    STX I_PARAM
}
.i_rts
    RTS
    ENDSECTION

\ The 1770's: it can't seek within a read, so a read on another track is
\ a Seek (or a Restore first, if where the head is isn't known), then the
\ Read Sector, which fdc_poll starts once the seek is done.
.reader_1770
    SECTION Fdc1770, org = fdc_slot, guard = fdc_slot + FDC_SLOT
    JMP w_read
    ASSERT P% = fdc_poll
{
    LDA W_STATUS : LSR A : BCS w_rts            ; busy (reading drops INTRQ)
    LDA fdc_state : LSR A : BCC read            ; 2: the read is done
    \ The seek (or restore) is done (carry set).
    LDA fdc_track
    BIT fdc_cur : BPL sought
    INC fdc_cur : BEQ w_seek                    ; restored (from &FF): now the seek
.sought
    STA fdc_cur
}
.w_start
    JSR arm
    LDA fdc_sect : STA W_SECTOR
    LDA #&80                                    ; Read Sector
\ Give the 1770 command A. Its status isn't valid for a while after (the
\ WD1770's data sheet), and a poll straight away would find it not busy, the
\ command done before it's begun: a read taken as read before a byte came,
\ its bytes landing later in a page that's moved on. (jsbeeb takes a command
\ at once, which hid it; a real Master doesn't.) Some 70us. Keeps carry.
.w_command
{
    STA W_COMMAND
    LDX #28
.wait
    DEX : BNE wait
}
.w_rts
    RTS
.read
    LDX #0 : STX fdc_state
    LDA W_STATUS : AND #&1C                     ; record not found, CRC, lost data
    RTS                                         ; (carry clear)
.w_read
    LDA fdc_track
    CMP fdc_cur : BEQ w_start
    INC fdc_state                               ; 1: seeking (from 0)
    LDX #&00 + W_RATE                           ; Restore, then the seek
    BIT fdc_cur : BMI w_go
.w_seek
    STA W_DATA
    LDX #&10 + W_RATE                           ; Seek
.w_go
    TXA : BPL w_command                         ; (always)
    ENDSECTION

\ The NMI routine, copied to NMI_AREA: the same on both controllers but for
\ the data register stream_init puts in. Its first byte is RTI until a read
\ arms it (disc.6502's arm). 4 + 4 + 4 + 6 + 3 + 5 + 2 + 2 + 6 = 36 cycles
\ a byte, and 7 to take the NMI: 43 of the 128 between bytes. A is kept in the
\ LDA # (Tom Seddon's), so no zero page. The 256th byte makes it an RTI
\ again, so the controller's end-of-command NMI does nothing, and fdc_poll
\ reads the result, which drops the interrupt.
.nmi_load
    SECTION Nmi, org = NMI_AREA, guard = NMI_AREA + &20
    STA nmi_restore + 1
.nmi_data
    LDA I_DATA
.nmi_dst
    STA &3000                   ; (a BIT once the bytes wanted are in)
    INC nmi_dst + 1
    BNE nmi_count
    INC nmi_dst + 2
.nmi_count
    DEC nmi_left
    BEQ nmi_last
.nmi_restore
    LDA #0
    RTI
.nmi_last
    LDA #BIT_ABS : STA nmi_dst
    BNE nmi_restore             ; (always)
.nmi_end
    ENDSECTION
ENDIF

\ Note what a soft BREAK keeps of page 2, for MENU to put back and the
\ handoff to restore (handoff.6502).
.keep_os
{
    LDX #OS_KEPT_LEN - 1
.copy
    LDA OS_KEPT,X : STA mb_os,X
    DEX : BPL copy
    LDA #MB_PLAYING : STA mb_reason
    LDA #0 : STA mb_game        ; (what's at STATE is stale from now)
    \ BREAK in play boots MENU too (decision 22): the start-up option
    \ flipped now, as the handoff does for its own reset, and no memory
    \ clear; MENU puts the option back from mb_os.
    STA &0258                   ; *FX 200 0
    LDA &028F : EOR #8 : STA &028F
    LDA #1 : STA mb_flipped
    RTS
}

\ MODE 1, set in the hardware (MENU leaves the OS in MODE 7, and an OS mode
\ change would clear the game's state at STATE): the screen narrowed to
\ 256 x 192 at &5000 (decision 1), blank until the first room is drawn
\ (draw_room shows it); then the interrupts taken over (irq.6502).
.init_system
{
    LDA #&D8 : STA ula_ctrl         ; MODE 1's pixels: 4 colours, 20 columns of bytes
    LDX #crtc_end - crtc_regs - 2
.crtc
    LDA crtc_regs,X : STA crtc_reg
    LDA crtc_regs+1,X : STA crtc_data
    DEX : DEX : BPL crtc
    LDA #0 : STA vsyncs
    JMP install_irq
}

\ Register, value pairs: MODE 1's, but R2 and R7 move with the narrower,
\ shorter picture to keep its centre where MODE 1's is.
.crtc_regs
    EQUB 0, 127
    EQUB 3, &28
    EQUB 4, 38
    EQUB 5, 0
    EQUB 9, 7
    EQUB 10, &20                ; the cursor off
    EQUB 11, 8
    EQUB 1, SCREEN_COLS * 2
    EQUB 2, 98 - (80 - SCREEN_COLS * 2) / 2
    EQUB 6, SCREEN_ROWS
    EQUB 7, 34 - (32 - SCREEN_ROWS) / 2
    EQUB 12, HI(screen / 8)
    EQUB 13, LO(screen / 8)
    \ Blank for now (display enable off). Then no interlace: with it, VSync
    \ moves half a line in alternate fields, and the palette split
    \ (irq.6502) has to land in a 32us blank.
    EQUB 8, CRTC_BLANK
.crtc_end

\ The status bar's six: logical 1, then 0, each beside 0, 1 and 3
\ (install_irq copies them to status_ula in zero page).
.status_ula_init
    FOR l = {1, 0}
        FOR n = {0, 1, 3}
            EQUB ula_entry(l, n, STATUS_COLOURS[l])
        NEXT
    NEXT

\ Put irq_handler on IRQ1V: VSync and User VIA T1 only.
.install_irq
{
    SEI
    LDA #&7F : STA sysvia_ier : STA usrvia_ier  ; anything we don't service
                                                ; would hold IRQ asserted
    LDA #LO(irq_handler) : STA irq1v
    LDA #HI(irq_handler) : STA irq1v+1
    LDA usrvia_acr : AND #&1F : ORA #&40        ; T1 free-running, T2 one-shot
    STA usrvia_acr
    LDA #&82 : STA sysvia_ier                   ; CA1: VSync
    LDA #&C0 : STA usrvia_ier                   ; T1
    LDX #5
.status
    LDA status_ula_init,X : STA status_ula,X
    DEX : BPL status
    CLI
    RTS
}

\ The tables that live in pages 1-3 (main.6502), from where they loaded.
\ Only once the interrupts are ours: the OS's handler uses page 1's stack.
.copy_os_pages
{
    LDX #page1_end - page1 - 1
.p1
    LDA page1_load,X : STA page1,X
    DEX : CPX #&FF : BNE p1
    RTS
}

\ Each time the game is loaded (MENU runs it for every game): a new game,
\ or the one at STATE carried on.
.init_game
{
IF DEFINED(VIEWER)
    ZA_ENTRY                    ; assembled, though the viewer never starts the game
ENDIF
    LDA #0 : STA dbg_room : STA noise_flag : STA save_armed : STA o_yf
    LDA mb_start : BEQ fresh
    LDA #0 : STA mb_start
    JMP resume
.fresh
    STA o_index
    \ The original never reseeds its RNG: it carries on from the last game.
    LDX #3
.seed
    LDA mb_rng,X : STA rng_state,X
    DEX : BPL seed
    \ Fall into new_game.
}

\ Start a game (&7743).
.new_game
{
    \ The cheats MENU set (APPLY_CHEATS, &76AB): a starting egg, the rest
    \ tested where the original patched its code.
    LDA mb_cheat : STA cheat
    AND #7 : STA egg
    LDA #5 : STA lives
    LDX #9
    LDA #0
.zero
    STA score,X
    DEX : BPL zero
    STA carrying_name
    JMP next_egg
}

\ The RNG's state on the tape (&91B1).
\ Carry on with the game at STATE, as the original's load does (&A21B):
\ the room drawn again, its things, then the main loop, with no truck. The
\ original's cipher leaves the RNG in a fixed state after a save or a load.
.resume
{
    SEC : JSR copy_state
    \ The saved game's cheats, and MENU's: on the Spectrum a load applies
    \ the saved byte's over any already applied, never undoing one.
    LDA cheat : ORA mb_cheat : STA cheat
    LDX #3
.seed_rng
    LDA resumed_rng,X : STA rng_state,X
    DEX : BPL seed_rng
    LDX #&FF : TXS
    JMP resume_room
}
.resumed_rng EQUB &5D, &00, &07, &B1
