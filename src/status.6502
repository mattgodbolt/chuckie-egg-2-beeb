\ ***************************************************************************
\ The status bar, rows 0-1, as the original's room drawer prints it
\ (&7982, &A107, &A36E, &A2B9): all in attribute 7, white on black, which
\ is logical 1 on 0 in the status bar's own palette (irq.6502).
\
\   row 0, col 5:   SCORE  CARRYING  LIVES
\   row 1, col 0:   the score, 10 digits, leading zeros in the first five
\                   shown as spaces
\   row 1, col 12:  the name of what Harry carries, 8 characters
\   row 1, col 22:  min(lives, 9) lives icons (tile &56), then a blank
\
\ With the developers' cheats on, the port adds the room number at row 0,
\ col 0, where the original's bar is blank (decision 27).
\ ***************************************************************************

\ The score, lives and the carried name are in LowState (memory.6502):
\ part of a game's state, which goes to the front end and back. The name
\ is 0-10 (0 = NOTHING; objects.6502 keeps the thing itself in `carried`).

.draw_status_bar
{
    LDA #5 : JSR status_at
    STA status_i                ; (status_at leaves A = 0)
.labels
    LDX status_i
    LDA status_labels,X : BEQ done
    JSR status_char
    INC status_i : BNE labels   ; (always)
.done
    JSR draw_score
    JSR draw_carrying
    JSR draw_lives
    \ Fall into draw_room_number, then visit_bonus. (Each draws cells of
    \ its own, and visit_bonus the score's digits it changes: any order.)
}

\ With the developers' cheats on, "R" and the room's three digits at row
\ 0, columns 0-3 (decision 27: Matt, finding his way with the room skip).
.draw_room_number
{
    LDA cheat : BEQ visit_bonus
    LDA #0 : JSR status_at
    LDA #'R' : JSR status_char
    LDA room : LDX #'0'
    CMP #100 : BCC hundreds         ; (rooms 1-120: one hundred at most)
    SBC #100 : INX
.hundreds
    PHA                             ; what's left
    TXA : JSR status_char
    PLA : JSR tens_units
    PHA                             ; the units
    TXA : JSR status_char
    PLA : JSR status_char
    \ Fall into visit_bonus.
}

\ A room's first visit this egg (&A139): its value x egg hundreds. The
\ value is in the top of the room's body's first byte (tools/mkrecords.py);
\ `visited` has a bit a room, set by a visit.
.visit_bonus
{
    LDA room : JSR bit_at
    ORA visited,X : CMP visited,X : BEQ done      ; visited already
    STA visited,X
    LDY #0 : LDA (rb),Y
    LSR A : LSR A : LSR A : LSR A
    LDX #7 : JMP times_egg
.done
    RTS
}

\ Bit A of a bitmap (visited, objects.6502's t_out): its byte, A / 8, in
\ X, and its mask, bit A AND 7, in A. Y kept.
.bit_at
{
    ZA_AUTO1 mask
    PHA
    AND #7 : TAX : LDA bit_masks,X : STA mask
    PLA : LSR A : LSR A : LSR A : TAX
    LDA mask
    RTS
}

\ A (under 100) as two digits, characters: the tens in X, the units in A.
\ (Also game.6502's egg number.)
.tens_units
{
    LDX #'0' - 1 : SEC
.tens
    INX : SBC #10 : BCS tens
    ADC #'0' + 10                   ; (carry clear)
    RTS
}

\ cell = A, a status bar cell (rows 0-1). X, Y kept.
.status_at
    STA cell : LDA #0 : STA cell+1
    RTS

\ AddScore (&A0BD): add A to score digit X, one carry rippled up (lost
\ past digit 0), each changed digit redrawn. X kept. The original
\ recurses, a level a carry; here a loop, so the stack's depth doesn't
\ depend on the score (page 1 leaves the stack little: pages.6502). The
\ digits are redrawn right to left rather than left to right.
.add_score
{
    TAY : TXA : PHA : TYA           ; (Y free: draw_digit uses it anyway)
.digit
    CLC : ADC score,X
    CMP #10 : BCC last
    SBC #10                         ; (C set)
    STA score,X : JSR draw_digit    ; (which keeps X)
    LDA #1
    DEX : BPL digit                 ; (none to the left of digit 0: lost)
    BMI done                        ; (always)
.last
    STA score,X : JSR draw_digit
.done
    PLA : TAX
    RTS
}

\ Redraw score digit X (add_score does, as the digits change). X kept (so
\ add_score keeps it too).
.draw_digit
    LDA score,X : ORA #'0'
\ Character A at row 1, column X < 32 (the score's). X kept.
.score_char
    STX status_x
    TAY : TXA : ORA #32 : JSR status_at : TYA   ; (status_at keeps Y)
    JSR status_char
    LDX status_x
    RTS

\ (status_labels is in page 1: pages.6502.)

\ The score at row 1, columns 0-9.
.draw_score
{
    LDX #0
.lead
    \ Leading zeros in the first five as spaces.
    LDA score,X : BNE digits
    LDA #' ' : JSR score_char
    INX : CPX #5 : BNE lead
.digits
    JSR draw_digit
    INX : CPX #10 : BNE digits
    RTS
}

\ SetCarrying (&9986): the status bar's name, 0 NOTHING to 10 BASKET.
.set_carrying
    STA carrying_name
    \ Fall into draw_carrying.
\ What Harry carries, at row 1, columns 12-19.
.draw_carrying
{
    LDA #32 + 12 : JSR status_at
    LDA carrying_name : ASL A : ASL A : ASL A : TAX
.char
    STX status_i
    LDA object_names,X
    JSR status_char
    LDX status_i : INX
    TXA : AND #7 : BNE char     ; 8 characters
    RTS
}

\ The factory's rewards: A x 10,000 x egg, and a life.
.reward
    LDX #5 : JSR times_egg
    \ Fall into extra_life.
\ ExtraLife (&A2DD): at most 255.
.extra_life
{
    INC lives : BNE ok
    DEC lives
.ok
    \ Fall into draw_lives.
}

\ The lives icons at row 1, column 22 on: min(lives, 9), then a blank.
.draw_lives
{
    LDA #32 + 22 : JSR status_at
    LDA lives : CMP #10 : BCC few
    LDA #9
.few
    STA status_x
.icon
    DEC status_x : BMI blank
    LDA #&56 : JSR status_tile
    BNE icon                    ; (always: tile_glyph leaves cell non-zero)
.blank
    \ (The original's tile &37, which is blank: as a space is.)
    LDA #' '
    \ Fall into status_char.
}
\ Character A (ASCII) from the OS's font (decision 4), on black at `cell`,
\ in white, or in yellow (the EGGS DELIVERED screen's: yellow_char); step
\ right.
.status_char
    ORA #&80                    ; text in the tile map's codes (screen.6502)
\ Tile A, white on black, at `cell`; step right.
.status_tile
    LDX #cbyte(1) EOR cbyte(0)
\ Tile map code A drawn in X's colour (diff) on logical 0.
.tile_glyph
    STX diff
    JSR cell_glyph.code_glyph
    LDA #cbyte(0) : STA paper
    JSR draw_glyph_pd
    \ (No line of text crosses a 256-cell boundary: the status bar's are
    \ cells 0-63, the EGGS DELIVERED screen's 359-377.)
    INC cell
    RTS
.yellow_char
    ORA #&80
    LDX #cbyte(3) EOR cbyte(0)
    BNE tile_glyph              ; (always)

\ The objects' names, 8 characters each (the original's, at &999E).
.object_names
    EQUS "NOTHING ", "TOY PART", "  MILK  ", " COCOA  ", " SUGAR  ", "A BONE  "
    EQUS " GIRDER ", " LADDER ", "THE TOY!", "THE EGG!", " BASKET "
