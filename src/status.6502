\ ***************************************************************************
\ The status bar, rows 0-1, as the original's room drawer prints it
\ (&7982, &A107, &A36E, &A2B9): all in attribute 7, white on black, which
\ is logical 1 on 0 in the status bar's own palette (irq.6502).
\
\   row 0, col 5:   SCORE  CARRYING  LIVES
\   row 1, col 0:   the score, 10 digits, leading zeros in the first five
\                   shown as spaces
\   row 1, col 12:  the name of what Harry carries, 8 characters
\   row 1, col 22:  min(lives, 9) lives icons (tile &56), then a blank
\ ***************************************************************************

\ The score, lives and the carried name are in LowState (memory.6502):
\ part of a game's state, which goes to the front end and back. The name
\ is 0-10 (0 = NOTHING; objects.6502 keeps the thing itself in `carried`).

.draw_status_bar
{
    LDA #5 : JSR status_at
    LDX #0
.labels
    LDA status_labels,X : BEQ done
    STX status_i
    JSR status_char
    LDX status_i : INX
    BNE labels                  ; (always)
.done
    JSR draw_score
    JSR visit_bonus
    JSR draw_carrying
    JMP draw_lives
}

\ A room's first visit this egg (&A139): its value x egg hundreds.
.visit_bonus
{
    LDX room
    LDA visits,X : BMI done
    PHA
    ORA #&80 : STA visits,X
    PLA : LDX #7 : JMP times_egg
.done
    RTS
}

\ cell = A, a status bar cell (rows 0-1). X, Y kept.
.status_at
    STA cell : LDA #0 : STA cell+1
    RTS

\ Redraw score digit X (add_score does, as the digits change).
.draw_digit
    TXA : CLC : ADC #32 : JSR status_at
    LDA score,X : ORA #'0' : JMP status_char

\ (status_labels is in page 1: pages.6502.)

\ The score at row 1, columns 0-9.
.draw_score
{
    LDA #32 : JSR status_at
    LDX #0
.lead
    \ Leading zeros in the first five as spaces.
    LDA score,X : BNE digits
    STX status_x
    LDA #' ' : JSR status_char
    LDX status_x : INX
    CPX #5 : BNE lead
.digits
    STX status_x
    JSR draw_digit
    LDX status_x : INX
    CPX #10 : BNE digits
    RTS
}

\ What Harry carries, at row 1, columns 12-19.
.draw_carrying
{
    LDA #32 + 12 : JSR status_at
    LDA carrying_name : ASL A : ASL A : ASL A : TAX
.char
    STX status_i
    LDA object_names,X
    JSR status_char
    LDX status_i : INX
    TXA : AND #7 : BNE char     ; 8 characters
    RTS
}

\ The lives icons at row 1, column 22 on: min(lives, 9), then a blank.
.draw_lives
{
    LDA #32 + 22 : JSR status_at
    LDA lives : CMP #10 : BCC few
    LDA #9
.few
    STA status_x
.icon
    DEC status_x : BMI blank
    LDA #&56 : JSR status_tile
    JMP icon
.blank
    LDA #&37
    \ Fall into status_tile.
}
\ Tile A, white on black, at `cell`; step right.
.status_tile
{
    LDX #cbyte(1) EOR cbyte(0) : STX diff
    SEC : SBC #&20
    LDX #LO(tiles) : LDY #HI(tiles)
    JMP status_glyph
}
\ Character A (ASCII) from the OS's font (decision 4), on black at `cell`,
\ in yellow (the EGGS DELIVERED screen's) or white; step right.
.yellow_char
    LDX #cbyte(3) EOR cbyte(0)
    BNE text_char               ; (always)
.status_char
    LDX #cbyte(1) EOR cbyte(0)
.text_char
    STX diff
    SEC : SBC #32
    LDX #LO(text_font) : LDY #HI(text_font)
\ glyph = font (Y:X) + 8 * A; draw in diff's colour on logical 0.
.status_glyph
{
    STA glyph : LDA #0 : STA glyph+1
    ASL glyph : ROL glyph+1 : ASL glyph : ROL glyph+1 : ASL glyph : ROL glyph+1
    TXA : CLC : ADC glyph : STA glyph
    TYA : ADC glyph+1 : STA glyph+1
    LDA #cbyte(0) : STA paper
    JSR draw_glyph_pd
    INC cell : BNE done
    INC cell+1
.done
    RTS
}

\ The objects' names, 8 characters each (the original's, at &999E).
.object_names
    EQUS "NOTHING ", "TOY PART", "  MILK  ", " COCOA  ", " SUGAR  ", "A BONE  "
    EQUS " GIRDER ", " LADDER ", "THE TOY!", "THE EGG!", " BASKET "
