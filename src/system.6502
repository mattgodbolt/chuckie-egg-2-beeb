\ ***************************************************************************
\ System: the narrowed screen, vsync counting, keyboard.
\ ***************************************************************************

\ Cursor off, the screen narrowed to 256 x 192 at &5000 (decision 1), and
\ the interrupts taken over (irq.6502). !BOOT has already selected MODE 1.
.init_system
{
    \ The cursor off, as VDU 23,1,0 would do it.
    LDA #10 : STA crtc_reg : LDA #&20 : STA crtc_data
    LDX #crtc_end - crtc_regs - 2
.crtc
    LDA crtc_regs,X : STA crtc_reg
    LDA crtc_regs+1,X : STA crtc_data
    DEX : DEX : BPL crtc
    \ ESCAPE is an ordinary key.
    LDA #229 : LDX #1 : LDY #0 : JSR osbyte
    LDA #0 : STA vsyncs
    JMP install_irq
}

\ The tables that live in pages 1-3 (main.6502), from where they loaded.
\ Only once the interrupts are ours: the OS's handler uses pages 2 and 3.
.copy_os_pages
{
    LDX #page1_end - page1 - 1
.p1
    LDA page1_load,X : STA page1,X
    DEX : BPL p1
    LDX #page2_end - page2 - 1
.p2
    LDA page2_load,X : STA page2,X
    DEX : CPX #&FF : BNE p2
    LDX #page3_end - page3 - 1
.p3
    LDA page3_load,X : STA page3,X
    DEX : CPX #&FF : BNE p3
    RTS
}

\ Register, value pairs. R2 and R7 move with the narrower, shorter picture
\ to keep its centre where MODE 1's is.
.crtc_regs
    EQUB 1, SCREEN_COLS * 2
    EQUB 2, 98 - (80 - SCREEN_COLS * 2) / 2
    EQUB 6, SCREEN_ROWS
    EQUB 7, 34 - (32 - SCREEN_ROWS) / 2
    EQUB 12, HI(screen / 8)
    EQUB 13, LO(screen / 8)
    \ No interlace: with it, VSync moves half a line in alternate fields, and
    \ the palette split (irq.6502) has to land in a 32us blank.
    EQUB 8, 0
.crtc_end

\ Is a key down? X = internal key number. Z clear (BNE) if it is. Read
\ straight from the keyboard matrix, as the OS's own INKEY does, so the game
\ makes no OS calls at all and pages 1-3 are free (main.6502).
.key_down
    LDA #&7F : STA sysvia_ddra      ; bits 0-6 the key, bit 7 its state
    LDA #3 : STA sysvia_orb         ; auto-scan off: the matrix is ours
    STX sysvia_ora_nh
    LDA sysvia_ora_nh : AND #&80
    RTS

\ Is any key down, other than SHIFT, CTRL and the start-up links? Z clear if so.
.any_key
{
    LDX #&10
.scan
    JSR key_down : BNE done
    INX : BPL scan
    LDA #0
.done
    RTS
}

K_Z      = &61
K_X      = &42
K_LEFT   = &19
K_RIGHT  = &79
